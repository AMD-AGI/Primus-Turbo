+def _hold_tdm_descriptor(*groups):
+    """Wait until the TDM op just issued has read its descriptor SGPRs (``s_wait_xcnt``).
+
+    The op can read them after issue (an XNACK replay re-reads them), but the compiler tracks no
+    XCNT for ``tensor_load_to_lds`` and reuses a descriptor SGPR right away; a late read sends a
+    gather to the wrong LDS rows and leaves its own rows stale for a k-tile. ``groups`` (the
+    descriptor vectors) are asm inputs, so their SGPRs stay unchanged until the wait."""
+    ops = [as_ir_value(_raw(g)) for g in groups]
+    rocdl.sched_barrier(0)
+    _llvm.inline_asm(
+        res=None,
+        operands_=ops,
+        asm_string="s_wait_xcnt 0x0",
+        constraints=",".join("s" for _ in ops),
+        has_side_effects=True,
+    )
+    rocdl.sched_barrier(0)
+
+
