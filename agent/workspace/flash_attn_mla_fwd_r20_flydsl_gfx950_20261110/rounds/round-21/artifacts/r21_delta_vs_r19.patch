+    def scale_q_packs(self, q_raw_packs, idx, scaled=None):
+        """`scale_all` of the raw packs at `idx` only, into the pack list `scaled` (None where not
+        yet scaled), so a QK can start on its first k-step's packs; `assemble_q` joins the list."""
+        assert not self.use_score_bound, "the score bound needs the norm of every q pack at once"
