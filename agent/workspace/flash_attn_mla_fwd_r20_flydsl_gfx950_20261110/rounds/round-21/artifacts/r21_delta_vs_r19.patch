+        out = [None] * len(q_raw_packs) if scaled is None else list(scaled)
+        packs = []
+        for i in idx:
+            ext_op = llvm.FPExtOp(Vec.make_type(n, fx.Float32), as_mlir_value(q_raw_packs[i]))
+            ext_op.operation.attributes["fastmathFlags"] = fm_fast_attr
+            mul = arith.mulf(as_mlir_value(scale_vec), ext_op.result, fastmath=self.fm_fast)
+            trunc_op = llvm.FPTruncOp(Vec.make_type(n, self.elem_dtype), mul)
