+    kv_head, q_head_idx, seq_idx = _packed_tile_indices(gqa_ratio, warp_idx, lane_idx)
+
+    q_mgr = QManager16bV2(
+        qk_hdim=qk_hdim,
+        gqa_ratio=gqa_ratio,
+        num_waves=NUM_WAVES,
+        q_tiles_per_wave=R,
+        elem_dtype=elem_dtype,
+    )
+    k_mgr = KManager16bV2(
+        qk_hdim=qk_hdim, n_block=n_block, num_waves=NUM_WAVES, elem_dtype=elem_dtype
+    )
+    v_mgr = VManager16bV2(
+        v_hdim=v_hdim, n_block=n_block, num_waves=NUM_WAVES, elem_dtype=elem_dtype
+    )
+    o_mgr = OManager16bV3(
+        v_hdim=v_hdim,
+        gqa_ratio=gqa_ratio,
+        num_waves=NUM_WAVES,
+        q_tiles_per_wave=R,
+        elem_dtype=elem_dtype,
+    )
+    k_blk_bytes = k_mgr.get_lds_size_in_byte()  # 34816
+    v_blk_bytes = v_mgr.get_lds_size_in_byte()  # 36864
+    slot_bytes = k_blk_bytes + v_blk_bytes  # 71680
+    qo_off = NS * slot_bytes  # 286720
+    qo_bytes = max(q_mgr.get_lds_size_in_byte(), o_mgr.get_lds_size_in_byte())  # 34816
+    assert qo_off + qo_bytes <= get_lds_capacity_bytes("gfx1250"), (qo_off, qo_bytes)
+
+    def _slot_k(s):
+        if isinstance(s, int):
+            s = fx.Int32(s)
+        return lds_base + s * fx.Int32(slot_bytes)
+
+    def _slot_v(s):
+        return _slot_k(s) + fx.Int32(k_blk_bytes)
+
+    qo_lds_base = lds_base + fx.Int32(qo_off)
+    block_x = _lpt_block_id("x")
+    q_mgr.load_q_to_vgpr_part1(
+        ptr_Q=ptr_Q,
+        stride_q_seq=stride_q_seq,
+        stride_q_head=stride_q_head,
+        q_start=q_start,
+        q_len=q_len,
+        kv_head=kv_head,
+        block_x=block_x,
+        warp_idx=warp_idx,
+        lane_idx=lane_idx,
+        ptr_lds=qo_lds_base,
+    )
+
+    # ---- WG KV range: identical to the champion, in n_block=128 sub-tiles. ----
+    causal_off = kv_len - q_len
+    if mask_right:
+        wg_max_seq = (block_x * fx.Int32(BLOCK_M) + fx.Int32(BLOCK_M - 1)) // fx.Int32(
+            gqa_ratio
+        )
+        wg_max_seq = fx.min(wg_max_seq, q_len - fx.Int32(1))
+        kv_len_wg = wg_max_seq + causal_off + window_right + fx.Int32(1)
+        kv_len_wg = fx.min(kv_len_wg, kv_len)
+        kv_len_wg = fx.max(kv_len_wg, fx.Int32(1))
+    else:
+        kv_len_wg = kv_len
+    n_tiles = fx.Int32(fx.ceildiv(kv_len_wg, fx.Int32(n_block)))
+    if mask_left:
+        wg_min_seq = (block_x * fx.Int32(BLOCK_M)) // fx.Int32(gqa_ratio)
+        kv_lo = fx.max(wg_min_seq + causal_off - window_left, fx.Int32(0))
+        start_tile = kv_lo // fx.Int32(n_block)
+        start_tile = fx.min(start_tile, n_tiles - fx.Int32(1))
+    else:
+        start_tile = fx.Int32(0)
+
+    def _kv_valid(blk_row0):
+        rem = fx.max(kv_len_wg - blk_row0, fx.Int32(0))
+        return fx.min(rem, fx.Int32(n_block))
+
+    def _tile_views(t, slot):
+        """Pure: the K and V collective TDM copies (num_warps=NUM_WAVES) of sub-tile t into slot."""
+        row0 = t * fx.Int32(n_block)
+        valid = _kv_valid(row0)
+        kviews = k_mgr.load_views(
+            ptr_lds=_slot_k(slot),
+            ptr_K=ptr_K,
+            stride_k_seq=stride_k_seq,
+            stride_k_head=stride_k_head,
+            kv_head=kv_head,
+            kv_row0=kv_start + row0,
+            kv_valid=valid,
+        )
+        vviews = v_mgr.load_views(
+            ptr_lds=_slot_v(slot),
+            ptr_V=ptr_V,
+            stride_v_seq=stride_v_seq,
+            stride_v_head=stride_v_head,
+            kv_head=kv_head,
+            kv_row0=kv_start + row0,
+            kv_valid=valid,
+        )
+        return list(kviews) + list(vviews)
+
+    def _issue_guarded(t, views):
+        @flyc.jit
+        def _go():
+            if t < n_tiles:
+                for _v in views:
+                    fx.copy_atom_call(*_v)
+
+        _go()
+
+    def _slot_of(t):
+        return (t - start_tile) % fx.Int32(NS)
+
+    # ---- Prologue: sub-tiles start, start+1 -> slots 0, 1; drain; barrier; then start+2,
+    # start+3 -> slots 2, 3 (in flight under the first step). ----
+    views0 = _tile_views(start_tile, 0)
+    views1 = _tile_views(start_tile + fx.Int32(1), 1)
+    q_frags = q_mgr.load_q_to_vgpr_part2(scale=softmax_scale)
+    for _v in views0:
+        fx.copy_atom_call(*_v)
+    _issue_guarded(start_tile + fx.Int32(1), views1)
+    tdm_ops.tensor_wait(0)
+    gpu.barrier()
+    _issue_guarded(start_tile + fx.Int32(2), _tile_views(start_tile + fx.Int32(2), 2))
+    _issue_guarded(start_tile + fx.Int32(3), _tile_views(start_tile + fx.Int32(3), 3))
+
+    # ---- Loop-carried state: R x [m, d, O_0..O_7], then the 4 K and 4 V ring ds bases,
+    # rotated so entry 0 is always the current sub-tile's slot. ----
+    _QS = 2 + d_tiles
+    if has_sink:
+        num_heads_q = gpu.grid_dim.y * fx.Int32(gqa_ratio)
+        m_init = [
+            _load_sink_logit(ptr_sink, q_head_idx[qt], num_heads_q) for qt in range(R)
+        ]
+        d_init = [fx.Float32(1.0) for _ in range(R)]
+    else:
+        m_init = [fx.Float32(BIG_NEG) for _ in range(R)]
+        d_init = [fx.Float32(0.0) for _ in range(R)]
+    _init = []
+    for qt in range(R):
+        _init += [_raw(m_init[qt]), _raw(d_init[qt])] + [
+            _raw(fx.Vector.filled(8, 0.0, fx.Float32)) for _ in range(d_tiles)
+        ]
+    _PTR = len(_init)
+    _init += [k_mgr.ds_load_ptrs(ptr_lds=_slot_k(s), lane_idx=lane_idx)[0] for s in range(NS)]
+    _init += [v_mgr.ds_load_ptrs(ptr_lds=_slot_v(s), lane_idx=lane_idx)[0] for s in range(NS)]
+
+    def _unpack(state):
+        m = [fx.Float32(state[qt * _QS + 0]) for qt in range(R)]
+        d = [fx.Float32(state[qt * _QS + 1]) for qt in range(R)]
+        o = [[fx.Vector(state[qt * _QS + 2 + dt]) for dt in range(d_tiles)] for qt in range(R)]
+        kp = list(state[_PTR : _PTR + NS])
+        vp = list(state[_PTR + NS : _PTR + 2 * NS])
+        return m, d, o, kp, vp
+
+    def _pack(m, d, o, kp, vp):
+        out = []
+        for qt in range(R):
+            out += [_raw(m[qt]), _raw(d[qt])] + [_raw(x) for x in o[qt]]
+        return out + kp + vp
+
+    def _softmax_rescale(s_list, m, d, o, *, t, mask_left, mask_right, kv_len):
+        q_max_list = [
+            seq_idx[qt] + causal_off + window_right if mask_right else None
+            for qt in range(R)
+        ]
+        q_min_list = [
+            seq_idx[qt] + causal_off - window_left if mask_left else None
+            for qt in range(R)
+        ]
+        p_list, m_new, d_new, corr_list, do_rescale_list = _softmax(
+            s_list=s_list,
+            m_prev_list=m,
+            d_prev_list=d,
+            lane_idx=lane_idx,
+            n_block=n_block,
+            kv_pos_base=t * fx.Int32(n_block),
+            q_max_list=q_max_list,
+            q_min_list=q_min_list,
+            kv_len=kv_len,
+            elem_dtype=elem_dtype,
+        )
+        return p_list, m_new, d_new, _rescale(o, corr_list, do_rescale_list)
+
+    def _rescale(o, corr_list, do_rescale_list):
+        @flyc.jit
+        def _maybe_rescale(o_vecs, corr_vec, do_rescale):
+            result = o_vecs
+            if do_rescale:
+                result = [ov * corr_vec for ov in o_vecs]
+            return result
+
+        o_resc = []
+        for qt in range(R):
+            corr_vec = fx.Vector.from_elements([corr_list[qt]], fx.Float32).broadcast_to(8)
+            o_vecs = [fx.Vector(_ir(o[qt][dt])) for dt in range(d_tiles)]
+            if do_rescale_list[qt] is None:
+                o_resc.append([ov * corr_vec for ov in o_vecs])
+            else:
+                o_resc.append(list(_maybe_rescale(o_vecs, corr_vec, do_rescale_list[qt])))
+        return o_resc
+
+    def plain_step(t, state, *, mask_left, mask_right, kv_len):
+        m, d, o, kp, vp = _unpack(state)
+        views = _tile_views(t + fx.Int32(NS), _slot_of(t))  # pure, hoisted
+        s_list = _p2_qk(k_mgr, kp[0], q_frags, n_block)
+        v_vals = _p2_v_all(v_mgr, vp[0], n_block)
+        p_list, m, d, o = _softmax_rescale(
+            s_list, m, d, o, t=t, mask_left=mask_left, mask_right=mask_right, kv_len=kv_len
+        )
+        nkt2 = (n_block // WMMA_K) * 2
+        o = _p2_pv(
+            lambda dt, kt, h: v_vals[dt * nkt2 + kt * 2 + h], p_list, v_hdim, n_block, o
+        )
+        # Tail: every wave done reading slot t%4 -> refill it with t+4.
+        tdm_ops.tensor_wait(0)
+        gpu.barrier()
+        _issue_guarded(t + fx.Int32(NS), views)
+        return _pack(m, d, o, kp[1:] + kp[:1], vp[1:] + vp[:1])
+
+    def pipe_step(t, state):
+        m, d, o, kp, vp = _unpack(state)
+        tb = t + fx.Int32(1)
+        views_a = _tile_views(t + fx.Int32(NS), _slot_of(t))  # pure, hoisted
+        views_b = _tile_views(tb + fx.Int32(NS), _slot_of(tb))
+        # QK(a) then QK(b): S set A and S set B.
+        s_a = _p2_qk(k_mgr, kp[0], q_frags, n_block)
+        if P2_INTERLEAVE:
+            stages, sm_res = _p2_softmax_staged(
+                s_list=s_a, m_prev_list=m, d_prev_list=d, n_block=n_block, elem_dtype=elem_dtype
+            )
+            s_b = _p2_qk_woven(k_mgr, kp[1], q_frags, n_block, stages)
+            p_a, m, d, corr_a, dor_a = sm_res()
+            o = _rescale(o, corr_a, dor_a)
+        else:
+            s_b = _p2_qk(k_mgr, kp[1], q_frags, n_block)
+            if P2_SGB_ROUNDS > 0:
+                # Hint: QK(b)'s WMMAs interleaved with softmax(a)'s VALU / trans.
+                for _ in range(P2_SGB_ROUNDS):
+                    rocdl.sched_group_barrier(0x008, 1, 0)
+                    rocdl.sched_group_barrier(0x002, P2_SGB_VALU, 0)
+                    rocdl.sched_group_barrier(0x400, P2_SGB_TRANS, 0)
+            # softmax(a) has no dependence on QK(b): same basic block, no fence -> overlap.
+            p_a, m, d, o = _softmax_rescale(
+                s_a, m, d, o, t=t, mask_left=None, mask_right=None, kv_len=None
+            )
+        o = _p2_pv(
+            lambda dt, kt, h: _p2_v_frag(v_mgr, vp[0], dt, kt, h), p_a, v_hdim, n_block, o
+        )
+        # V(b) -> VGPR: the last read of this step's slots, drained before the signal.
+        nkt2 = (n_block // WMMA_K) * 2
+        v_b = _p2_v_all(v_mgr, vp[1], n_block)
+        rocdl.s_wait_dscnt(0)
+        tdm_ops.tensor_wait(0)  # own share of sub-tiles t+2, t+3 landed
+        _mrocdl.s_barrier_signal(-1)
+        if P2_GAP_FENCE:
+            rocdl.sched_barrier(0)
+        # ---- barrier gap: register-only work ----
+        p_b, m, d, o = _softmax_rescale(
+            s_b, m, d, o, t=tb, mask_left=None, mask_right=None, kv_len=None
+        )
+        o = _p2_pv(lambda dt, kt, h: v_b[dt * nkt2 + kt * 2 + h], p_b, v_hdim, n_block, o)
+        _mrocdl.s_barrier_wait(-1)
+        # Every wave is past its signal: t+2, t+3 complete; slots of t, t+1 free.
+        _issue_guarded(t + fx.Int32(NS), views_a)
+        _issue_guarded(tb + fx.Int32(NS), views_b)
+        return _pack(m, d, o, kp[2:] + kp[:2], vp[2:] + vp[:2])
+
+    @flyc.jit
+    def _run_plain(state, lo_i32, hi_i32, *, mask_left, mask_right, kv_len):
+        final_state = state
+        for tile, carried in range(fx.Index(lo_i32), fx.Index(hi_i32), 1, init=state):
+            next_state = plain_step(
+                fx.Int32(tile),
+                list(carried),
+                mask_left=mask_left,
+                mask_right=mask_right,
+                kv_len=kv_len,
+            )
+            final_state = yield next_state
+        return final_state
+
+    @flyc.jit
+    def _run_pipe(state, lo_i32, hi_i32):
+        final_state = state
+        for tile, carried in range(fx.Index(lo_i32), fx.Index(hi_i32), 2, init=state):
+            next_state = pipe_step(fx.Int32(tile), list(carried))
+            final_state = yield next_state
+        return final_state
+
+    # ---- Regions: [start, clean_lo) left edge (plain, masked; only mask_left);
+    # [clean_lo, pipe_hi) clean, 256-KV pipe steps; [pipe_hi, n_tiles) plain masked (the
+    # right edge + kv_len tail, plus the odd leftover clean sub-tile -- exact masks). ----
+    n_last = n_tiles - fx.Int32(1)
+    if mask_right:
+        wg_min_seq = (block_x * fx.Int32(BLOCK_M)) // fx.Int32(gqa_ratio)
+        qmax_min = fx.max(wg_min_seq + causal_off + window_right, fx.Int32(0))
+        clean_hi = (qmax_min + fx.Int32(1)) // fx.Int32(n_block)
+    else:
+        clean_hi = n_tiles
+    clean_hi = fx.max(fx.min(clean_hi, n_last), start_tile)
+    if mask_left:
+        wg_max_seq = fx.min(
+            (block_x * fx.Int32(BLOCK_M) + fx.Int32(BLOCK_M - 1)) // fx.Int32(gqa_ratio),
+            q_len - fx.Int32(1),
+        )
+        qmin_max = fx.max(wg_max_seq + causal_off - window_left, fx.Int32(0))
+        clean_lo = (qmin_max + fx.Int32(n_block - 1)) // fx.Int32(n_block)
+    else:
+        clean_lo = start_tile
+    clean_lo = fx.min(fx.max(clean_lo, start_tile), clean_hi)
+    pipe_hi = clean_lo + ((clean_hi - clean_lo) // fx.Int32(2)) * fx.Int32(2)
+
+    state = _init
+    if mask_left:
+        state = _run_plain(
+            state, start_tile, clean_lo, mask_left=mask_left, mask_right=mask_right, kv_len=None
+        )
+    state = _run_pipe(state, clean_lo, pipe_hi)
+    state = _run_plain(
+        state, pipe_hi, n_tiles, mask_left=mask_left, mask_right=mask_right, kv_len=kv_len
+    )
+    final = state
+
+    # ---- Epilogue: O staging in the dedicated Q/O region (each wave rewrites only its own
+    # Q rows' bytes, read by itself in the prologue -> no cross-wave sync); no TDM can be in
+    # flight into it. LSE identical to the champion. ----
+    for qt in range(R):
+        d_final = fx.Float32(final[qt * _QS + 1])
+        o_final = [fx.Vector(final[qt * _QS + 2 + dt]) for dt in range(d_tiles)]
+        inv = (d_final > fx.Float32(0.0)).select(fx.Float32(1.0) / d_final, fx.Float32(0.0))
+        inv_vec = fx.Vector.from_elements([inv], fx.Float32).broadcast_to(8)
+        o_norm = [o_final[dt] * inv_vec for dt in range(d_tiles)]
+        if qt > 0:
+            rocdl.s_wait_dscnt(0)
+        o_mgr.store_o_to_vram(
+            ptr_O=ptr_O,
+            o_base_elems=fx.Int32(0),
+            stride_o_seq=stride_o_seq,
+            stride_o_head=stride_o_head,
+            q_start=q_start,
+            q_len=q_len,
+            kv_head=kv_head,
+            block_x=block_x,
+            warp_idx=warp_idx,
+            lane_idx=lane_idx,
+            ptr_lds=qo_lds_base,
+            o_frags=o_norm,
+            qtile=qt,
+        )
+
+    if return_lse:
+        khalf0 = (lane_idx // fx.Int32(WMMA_M)) == fx.Int32(0)
+        lse_rsrc = buffer_ops.create_buffer_resource(
+            ptr_LSE, num_records_bytes=lse_num_records_bytes
+        )
+        for qt in range(R):
+            m_final = fx.Float32(final[qt * _QS + 0])
+            d_final = fx.Float32(final[qt * _QS + 1])
+            ln_d = fx.log2(d_final) * fx.Float32(1.0 / LOG2E)
+            lse_val = m_final + ln_d
+            lse_mask = khalf0 & (seq_idx[qt] < q_len)
+            lse_off_el = (
+                lse_base_elems + seq_idx[qt] * stride_lse_seq + q_head_idx[qt] * stride_lse_head
+            )
+            lse_off_masked = lse_mask.select(lse_off_el * fx.Int32(4), fx.Int32(0x7FFFFFFF))
+            buffer_ops.buffer_store(
+                lse_val, lse_rsrc, lse_off_masked, mask=None, offset_is_bytes=True
+            )
