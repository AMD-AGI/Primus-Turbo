 import sys  # noqa: E402
 import tempfile  # noqa: E402
 from pathlib import Path  # noqa: E402
+import atexit  # noqa: E402
+import shutil  # noqa: E402
+
+
+def fresh_flycache(tag: str) -> str:
+    """A0 operator 2026-10-02 (h46/h49): a FRESH FlyDSL JIT cache directory per process this gate runs -- this one
+    (correctness, determinism) and each benchmark.py subprocess (speed). FlyDSL 0.3.4.1's disk-cache key ignores
+    module-level constants (RESCALE_THRESHOLD, SPEC_STALE_MAX), and fa-repro sets no FLYDSL_RUNTIME_CACHE_DIR, so a
+    gate that set none shared /root/.flydsl/cache with every other process and could time a stale binary of a path
+    whose contents changed. Removed when this process exits. Not part of the refcache provenance."""
+    path = tempfile.mkdtemp(prefix=f"flycache_val_{tag}.", dir="/tmp")
+    atexit.register(shutil.rmtree, path, True)
+    return path
+
+
+os.environ["FLYDSL_RUNTIME_CACHE_DIR"] = fresh_flycache("main")   # before torch / flydsl are imported
 
