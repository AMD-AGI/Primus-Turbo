+        # CHANGED vs upstream: one per-element multiply on the [BLOCK_M2, BLOCK_N2] score
+        # tile instead of two. Upstream computes qk * sm_scale and then multiplies the whole
+        # tile by RCP_LN2 again inside the exp2. sm_scale and RCP_LN2 are both tl.constexpr,
+        # so their product folds to a single constant at compile time and the tile is scaled
+        # once. m is [BLOCK_M2], so scaling it is a row op, not a tile op.
+        #
+        # NOT bitwise-neutral: (qk * s) * r and qk * (s * r) differ in the last ulp because
+        # fp32 multiplication is not associative. Gate this on SQNR, not on a hash.
         if USE_EXP2:
-            p = tl.math.exp2(qk_scaled * RCP_LN2 - m * RCP_LN2)
+            qk_log2 = qk * (sm_scale * RCP_LN2)
+            if USE_ALIBI:
+                relative_pos_block = offs_m[:, None] + seqlen_k - seqlen_q - offs_n[None, :]
+                # Scaled to match: alibi is added in natural-log units upstream, and this
+                # tile is now in log2 units.
+                qk_log2 += (-1 * alibi_slope * tl.abs(relative_pos_block)) * RCP_LN2
+            p = tl.math.exp2(qk_log2 - m * RCP_LN2)
         else:
+            qk_scaled = qk * sm_scale
+            if USE_ALIBI:
+                relative_pos_block = offs_m[:, None] + seqlen_k - seqlen_q - offs_n[None, :]
+                qk_scaled += -1 * alibi_slope * tl.abs(relative_pos_block)
             p = tl.math.exp(qk_scaled - m)
 
