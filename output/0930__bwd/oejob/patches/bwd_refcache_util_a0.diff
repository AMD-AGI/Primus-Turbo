+# A0 operator 2026-09-30. The fp32 reference (forward_reference / op/eager) is never computed
+# on the GPU: it is the dispatch that cost the 2026-09-22 power cycle, and on 2026-09-28 it
+# faulted B0 GPU2 inside a round's own script (fwd h50). proxy and prod must come from
+# refcache/ (causal; they always do) and a miss is a hard error. fast non-causal and the six
+# small unscored edge shapes (<= 2x2048x1024) are computed on the CPU instead.
+
+
+def _refuse_on_card(shape):
+    if shape in ("proxy", "prod"):
+        raise RuntimeError(
+            f"refcache {shape}: unusable, and computing the fp32 reference for it is refused "
+            f"(never on the card; too large for the CPU). Restore op/refcache/{shape}.pt.")
+
+
 def cached_forward(shape, q, k, v, causal=True):
     """(o, lse) for `shape`, from the cache when it is usable, else computed as before.
 
