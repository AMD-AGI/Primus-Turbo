  direction: [fwd, bwd]         # they want opposite wave counts -- 8 against 4; see section 5
  dtype:
    qkv: bf16                   # hard: `q.dtype == torch.bfloat16`. fp16 is refused
    acc: fp32
  softmax_scale: "1/sqrt(D), baked"   # any other value is refused (`_scale_ok`), because the
                                # forward folds `rsqrt(D)*log2e` into the Q scale at load
  sink: "optional, fp32 [Hq]"   # folded into the denominator in the epilogue only
  determinism: "OFF BY DEFAULT -- `deterministic=True` costs 10.4%"
                                # THIS IS THE FIELD THAT CHANGED. The default backward
                                # accumulates dQ with `buffer_atomic_pk_add_bf16` and is NOT
                                # bitwise reproducible; dK, dV and the forward always are.
                                # `deterministic=True` vetoes the atomic path and routes dQ
                                # onto split-K. It is a bool argument on the backward, not a
                                # separate kernel. Measured cost: section 3
  power_regime: "forward power-capped, backward clock-capped"
                                # REQUIRED for section 6's ranking, and the two halves differ:
                                # the forward holds 1611 MHz at 1317 W, the backward 2227 MHz
                                # at 1349 W. Same socket, opposite regimes
  tuned_for: sweep              # constants are a compromise across a shape set
```

