// k_mla_fwd -- DeepSeek-V3 MLA attention forward on gfx1250: head dims qk 192 / v 128, bf16, MHA, bottom-right causal
// (query i attends kv j <= i + Skv - Sq).
//   Q [B, Sq, H, 192], K [B, Skv, H, 192], V [B, Skv, H, 128] -> O [B, Sq, H, 128] bf16, LSE [B, H, Sq] fp32 (natural
//   log). The kernel relies on Sq == Skv and Sq % 64 == 0 (the host checks limits.fwd_shape_unsupported_reason).
//
// Numerics: out and lse are bitwise equal to the FlyDSL MLA forward's: every q tile runs FlyDSL's fp32 operations in
// FlyDSL's order. With c = scale * log2(e) and m the running row max in log2 units: s = Q K^T (WMMA chains over the
// 6 k-steps, from +0), -inf where masked; lm = the row max of s (max is exact: any reduction order); m' = m, unless
// fma(lm, c, -m) > log2(e) (the max grew by more than one nat) in some row of the 16-row q tile, then
// m' = max(m, lm * c); corr = exp2(m - m'); p = exp2(fma(s, c, -m')); d = fma(corr, d, ls + peer(ls)), ls = FlyDSL's
// 3-ary sum tree over the lane's 32 values of p; O = O * corr + bf16(p) V (on every tile: corr is exactly 1 when m
// did not move); out = bf16(O * (d > 0 ? 1 / d : 0)), lse = (m + log2 d) * ln 2. The q tiles a diagonal tile does
// not reach are skipped, as in FlyDSL.
//
// Work: a workgroup is 4 waves (128 threads, one wave per SIMD), one per CU (LDS_B = 310272 B). It runs q blocks
// ("blocks" below) of 256 rows of one (batch, head); wave w owns four 16-row q tiles of a block, q tile i = rows
// 64 i + 16 w .. + 15. The kv range of a block is n tiles of 64 rows: tiles [0, ncc) are below the diagonal (no
// mask); the rest (Sq == Skv: at most 4) are the diagonal tiles ncc + k, in which q tiles i < k are fully masked
// (skipped), q tile k takes the causal mask and q tiles i > k need none. Grid: one block per workgroup (npw == 0),
// or persistent workgroups on a static schedule (npw > 0, see the schedule below).
//
// LDS: a 4-stage ring of kv tiles (a stage holds K 64 x 400 B and V 64 x 272 B), the Q block (256 x 400 B) and the
// epilogue staging. Ring slot t of a block is its tile t, in stage (sb + t) % 4; the ring runs on across the blocks
// of a workgroup. Wave 0 issues the 3 TDM ops of every slot (K columns 0..127 and 128..191, V); waves 1..3 issue the
// same ops with NULL descriptors, so every wave runs the same code and waits on static counts. Per block:
//   prologue  Q (waves 1, 2) and slots 0..2 (wave 0); B_0: every wave s_wait_tensorcnt 0, then the barrier
//   tile t    issue slot t + 3 into the stage of tile t - 1; read the K / V / Q fragments, then s_wait_dscnt 0,
//             s_wait_tensorcnt 6 (slot t + 1 landed) and s_barrier_signal, the tile's math around them;
//             s_barrier_wait. This barrier, B_{t+1}, makes tile t + 1 visible to every wave and frees the stage of
//             tile t. Slots past the last tile n - 1 are 1-row copies of it, so wave 0 issues 3 ops in every tile.
//   epilogue  after B_n: the next block's prologue loads, then the output (staged at TAIL and in tile n - 1's stage)
// No LDS read follows a tile's s_barrier_signal: right after B_n the next block's Q overwrites the Q area.
//
// Marker shell (HKGEN_REF 0, the production build): LLVM compiles the prologue, the TDM descriptors and issue, the
// barrier waits, the loop control and the output stores; the per-tile math is generated by tools/fwdgen and spliced
// into the compiler's .s (hip/asm/k_mla_fwd.s.patch) at the markers, inline asm statements
// "; HKGEN <region> <name>=<operand> ..." whose operands carry the shell's values into the generated code:
//   INIT     per block, after B_0: m = -1e30, d = 0, O = 0 and the constants; qa, qb: the lane's Q fragment bases of
//            q tiles 0, 1 and 2, 3 (+ 64 rows for q tiles 1, 3); c2 = scale * log2(e) (SGPR)
//   TILE_C   a tile below the diagonal; kb, vb: the lane's K / V^T fragment bases in the tile's stage; c2
//   TILE_Dk  the diagonal tile ncc + k, k = 0..3; kb, vb, c2 and dl, the causal bound of q tile 0 (see dl0)
//   FINAL_i  q tile i: o, 32 VGPRs, lane l: the bf16 out of row l % 16, d columns 16 dt + 8 (l / 16) .. + 7 in
//            o[4 dt .. 4 dt + 3]; lse: the lse of row l % 16
// The generated code writes only the VGPRs above every VGPR the shell's code references (its state lives there
// across the markers), the FINAL outputs and the clobbered s90..s103 / vcc / scc; reads LDS only at the marker
// bases plus constant offsets; makes no other memory access; ends in VGPR-MSB mode 0; and each TILE region issues
// its s_barrier_signal once, after its last LDS read. The shell's code has no WMMA or transcendental instruction,
// keeps nothing in the clobbered registers across a marker and reaches every marker with all lanes active.
// tools/fwdgen/build.py checks both sides.
//
// -DHKGEN_REF=1 compiles the per-tile math from the HIP below instead of the markers: a complete kernel with the
// same arithmetic, whose .s also gives the generator the VGPR-MSB operand fields of the instructions it emits.
#include "hkf.h"

// FlyDSL's arithmetic spells out every fma: no other contraction
#pragma clang fp contract(off)

using namespace hkf;

#ifndef HKGEN_REF
#define HKGEN_REF 0
#endif

// the SGPRs the generated code uses as temporaries (with vcc / scc; fwdgen.CLOBBERED): clobbered at every marker
#define HKGEN_CLOBBERS "memory", "vcc", "scc", "s90", "s91", "s92", "s93", "s94", "s95", "s96", "s97", "s98", \
                       "s99", "s100", "s101", "s102", "s103"

namespace {
constexpr int D_QK = 192, D_V = 128;
constexpr int BM = 256;          // q rows per block
constexpr int QT = 4;            // 16-row q tiles per wave
constexpr int NB = 64;           // kv rows per tile (ring stage)
constexpr int NKS = D_QK / 32;   // 6 k-steps of QK
constexpr int NDT = D_V / 16;    // 8 d tiles of O
constexpr int NKV = NB / 16;     // 4 kv16 tiles per tile
constexpr int XK = 400, XV = 272;  // LDS row strides of K / Q and V (bytes)
constexpr int K_B = NB * XK;       // 25600
constexpr int V_B = NB * XV;       // 17408
constexpr int STG_B = K_B + V_B;   // 43008: a ring stage, K then V
constexpr int NSTG = 4;
constexpr int Q_OFF = NSTG * STG_B;     // 172032: the Q block
constexpr int TAIL = Q_OFF + BM * XK;   // 274432: the epilogue staging of q tiles 2, 3
// epilogue staging: SQT bytes per wave and q tile, O row r at XO r (16 rows), the lse of lane l at LSE_SLOT + 4 l;
// q tiles 0, 1 of the 4 waves in the ring stage of the block's last tile, q tiles 2, 3 at TAIL
constexpr int XO = 272;
constexpr int LSE_SLOT = 16 * XO;          // 4352
constexpr int SQT = LSE_SLOT + 32 * 4;     // 4480
constexpr int LDS_B = TAIL + 2 * 4 * SQT;  // 310272
static_assert(2 * 4 * SQT <= STG_B, "the staging of q tiles 0, 1 fits in one ring stage");
static_assert(SQT % 16 == 0 && STG_B % 16 == 0, "16-byte aligned staging slots");
static_assert(LDS_B <= 327680 && 2 * LDS_B > 327680, "one workgroup per CU");
constexpr unsigned OOB = 0x80000000u;  // > every num_records (< 2^31) and + soffset < 2^32: dropped, no wrap
constexpr unsigned W0_A = 0x47510000u;  // 128 columns, pad 72 elements -> 400-B rows
constexpr unsigned W0_B = 0x87110000u;  // 64 columns, pad 136 elements -> 400-B rows
constexpr unsigned W0_V = 0x07510000u;  // 128 columns, pad 8 elements -> 272-B rows
constexpr float LOG2E = 1.4426950408889634f;
constexpr float LN2 = 0.69314718055994531f;  // fp32 0x3f317218 = FlyDSL's fp32(1 / LOG2E)

// TDM descriptor groups of a 2-D tile load (tdm_load). Group 1: w0 (element size and LDS row padding, W0_*), dim 0
// unbounded, tdim1 rows in bounds, a tile of tile0 columns x tile1 rows, the row stride in elements.
HKF_INLINE i32x8 tdm_g1(unsigned w0, unsigned tdim1, unsigned tile0, unsigned tile1, unsigned long long stride_el) {
  return i32x8{(int)w0, (int)0xFFFF0000u, (int)(((tdim1 & 0xFFFFu) << 16) | 0x7FFFu),
               (int)(((tdim1 >> 16) & 0xFFFFu) | (tile0 << 16)), (int)tile1, (int)(unsigned)stride_el,
               (int)((unsigned)(stride_el >> 32) & 0xFFFFu), 0};
}
// Group 0: the LDS and global addresses; count 0 = the NULL descriptor, which moves nothing (the branch-free way to
// keep a TDM op off a wave)
HKF_INLINE i32x4 tdm_g0(unsigned lds, unsigned long long ga, int count = 1) {
  return i32x4{count, (int)lds, (int)(unsigned)ga, (int)((unsigned)(ga >> 32) | 0x80000000u)};
}

// FlyDSL's _remap: (q block, head, batch) of the hardware dispatch rank, longest-first and head-grouped
HKF_INLINE void block_ids(int gx, int gy, int gz, int& bx, int& by, int& bz) {
  const int lin = (int)__builtin_amdgcn_workgroup_id_x() +
                  gx * ((int)__builtin_amdgcn_workgroup_id_y() + gy * (int)__builtin_amdgcn_workgroup_id_z());
  const int gyz = gy * gz;
  int rank = lin / gyz;
  int rem = lin - rank * gyz;
  const int r = (rank & 15) * gyz + rem;
  const int c = r & 255;
  const bool grouped = ((gx & 15) | (gyz & 15)) == 0;
  const int lin2 = grouped ? ((rank & -16) + (c >> 4)) * gyz + ((r >> 8) << 4) + (c & 15) : lin;
  rank = lin2 / gyz;
  rem = lin2 - rank * gyz;
  bx = gx - 1 - rank;
  by = rem % gy;
  bz = rem / gy;
}

#if HKGEN_REF
HKF_INLINE f32x8 zero8() { return f32x8{0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f}; }
HKF_INLINE float fmax2(float a, float b) { return __builtin_fmaxf(a, b); }
// FlyDSL _tree_reduce on one list: balanced 3-ary, (a + b) + c, a trailing pair a + b, a trailing single passed on
template <int N>
HKF_INLINE float tree_sum(const float (&x)[N]) {
  if constexpr (N == 1) {
    return x[0];
  } else {
    constexpr int M = N / 3 + ((N % 3) ? 1 : 0);
    float y[M];
    static_for<M>([&](auto j) {
      constexpr int i = 3 * j;
      if constexpr (N - i >= 3) {
        y[j] = (x[i] + x[i + 1]) + x[i + 2];
      } else if constexpr (N - i == 2) {
        y[j] = x[i] + x[i + 1];
      } else {
        y[j] = x[i];
      }
    });
    return tree_sum<M>(y);
  }
}
// max over the values: max3 of consecutive triples (a trailing pair max2, a trailing single passed on), per level
template <int N>
HKF_INLINE float tree_max(const float (&x)[N]) {
  if constexpr (N == 1) {
    return x[0];
  } else {
    constexpr int M = N / 3 + ((N % 3) ? 1 : 0);
    float y[M];
    static_for<M>([&](auto j) {
      constexpr int i = 3 * j;
      if constexpr (N - i >= 3) {
        y[j] = __builtin_fmaxf(__builtin_fmaxf(x[i], x[i + 1]), x[i + 2]);
      } else if constexpr (N - i == 2) {
        y[j] = __builtin_fmaxf(x[i], x[i + 1]);
      } else {
        y[j] = x[i];
      }
    });
    return tree_max<M>(y);
  }
}
#endif
}  // namespace

// The kernel arguments as the kernarg segment holds them (natural alignment, in order): the block loop reads them
// from the segment per block (HKF_BLOCK), so LLVM keeps no argument-derived value live across blocks.
struct KArgs {
  const bf16* Q;
  const bf16* K;
  const bf16* V;
  bf16* O;
  float* LSE;
  float scale;
  int Sq, Skv, H, B, nqb, npw;
};
static_assert(sizeof(KArgs) == 72 && __builtin_offsetof(KArgs, npw) == 64, "kernarg layout");

extern "C" __global__ __attribute__((amdgpu_flat_work_group_size(128, 128), amdgpu_waves_per_eu(1, 1)))
void k_mla_fwd(const bf16* __restrict__ Q, const bf16* __restrict__ K, const bf16* __restrict__ V,
               bf16* __restrict__ O, float* __restrict__ LSE, float scale, int Sq, int Skv, int H, int B, int nqb,
               int npw) {
  __shared__ __attribute__((aligned(1024))) unsigned char smem[LDS_B];
  lock_simd();
  const uint32_t lds0k = lds_addr(smem);
  const int wvk = wave_id((int)__builtin_amdgcn_workitem_id_x());
  // the arguments are read through KArgs (HKF_BLOCK)
  (void)Q, (void)K, (void)V, (void)O, (void)LSE, (void)scale, (void)Sq, (void)Skv, (void)H, (void)B, (void)nqb;

  // ---- the schedule -------------------------------------------------------------------------------------------------
  // npw == 0: grid (nqb, H, B), one block per workgroup in FlyDSL's order (block_ids).
  // npw > 0: grid (npw, 1, 1), persistent: workgroup w runs a static list of (q block, head-batch) pairs; no atomics,
  // no inter-workgroup dependence. With x = w % 8 (the XCD under the round-robin dispatch: L2 locality only),
  // w / 8 = r nqb + i and R = npw / 8 / nqb, its step s is head-batch hb = 8 (R s + r) + x, q block i on even steps
  // and nqb - 1 - i on odd ones; the list ends at the first hb >= H B, and w / 8 >= R nqb is idle. This covers every
  // (q block, hb) exactly once when H B % 8 == 0 and R >= 1. The host (fwd.persistent_workgroups) also requires
  // Sq % 256 == 0, (npw / 8) % nqb == 0 and an even number of steps: then every two steps cost every workgroup
  // 4 (nqb + 1) tiles.
  //
  // HKF_BLOCK(z): the per-block view of the arguments and helpers; z is always 0. In the block loop z is derived from
  // the loop counter (LLVM cannot prove it 0) and the arguments are re-read from the kernarg segment at offset 48 z
  // (16-byte aligned and not a multiple of the load size: an unscaled SGPR soffset), so LLVM hoists nothing
  // argument-derived out of the loop: the shell's state fits in the SGPRs the markers leave it, without spills.
#define HKF_BLOCK(z)                                                                                                 \
  const KArgs ka = *(const __attribute__((address_space(4))) KArgs*)(                                                \
      (const __attribute__((address_space(4))) unsigned char*)__builtin_amdgcn_kernarg_segment_ptr() + 48 * (z));    \
  const int Sq_ = ka.Sq, Skv_ = ka.Skv, H_ = ka.H, B_ = ka.B, nqb_ = ka.nqb, npw_ = ka.npw;                          \
  const uint32_t lds0 = lds0k + (unsigned)(z);                                                                       \
  const int wv = wvk + (z);                                                                                          \
  const int cnt0 = wv == 0 ? 1 : 0;                                                                                  \
  const int cshift = Skv_ - Sq_;                                                                                     \
  const unsigned long long krow = (unsigned long long)H_ * D_QK;                                                     \
  const unsigned long long vrow = (unsigned long long)H_ * D_V;                                                      \
  auto block_at = [&](int s_, int& qb, int& hh, int& bb) -> bool {                                                   \
    if (npw_ > 0) {                                                                                                  \
      const int wg = (int)__builtin_amdgcn_workgroup_id_x();                                                         \
      const int pr = (wg >> 3) / nqb_, pq = (wg >> 3) - pr * nqb_, pR = (npw_ >> 3) / nqb_;                          \
      const int hx = pR * s_ + pr;                                                                                   \
      const bool ok = pr < pR && hx < ((H_ * B_) >> 3);                                                              \
      const int hb = ok ? 8 * hx + (wg & 7) : 0;                                                                     \
      qb = ok ? ((s_ & 1) ? nqb_ - 1 - pq : pq) : 0;                                                                 \
      hh = hb % H_;                                                                                                  \
      bb = hb / H_;                                                                                                  \
      return ok;                                                                                                     \
    }                                                                                                                \
    block_ids(nqb_, H_, B_, qb, hh, bb);                                                                             \
    return s_ == 0;                                                                                                  \
  };                                                                                                                 \
  auto ntiles = [&](int qb) { return (min(qb * BM + BM, Sq_) + cshift + NB - 1) / NB; };                             \
  auto kv_base = [&](int hh, int bb, unsigned long long& gk, unsigned long long& gv) {                               \
    gk = (unsigned long long)(uintptr_t)ka.K + 2ull * (((unsigned long long)bb * Skv_ * H_ + hh) * D_QK);            \
    gv = (unsigned long long)(uintptr_t)ka.V + 2ull * (((unsigned long long)bb * Skv_ * H_ + hh) * D_V);             \
  };                                                                                                                 \
  /* wave 0's 3 TDM ops of ring slot t of a block (stage (sb + t) % 4): its tile t, or past its last tile a 1-row */ \
  /* copy of tile n - 1 into that (free) stage; branch-free: waves 1..3 issue NULL descriptors, so wave 0 keeps   */ \
  /* exactly 3 ops per tile in flight and its tensor waits stay static                                           */ \
  auto issue_slot = [&](int t, int n, int sb, unsigned long long gk0, unsigned long long gv0) {                      \
    const bool real = t < n;                                                                                         \
    const int kv0 = (real ? t : n - 1) * NB;                                                                         \
    const unsigned long long gk = gk0 + 2ull * (unsigned long long)kv0 * krow;                                       \
    const unsigned long long gv = gv0 + 2ull * (unsigned long long)kv0 * vrow;                                       \
    const unsigned th = real ? NB : 1;                                                                               \
    const unsigned rows = (unsigned)(Skv_ - kv0);                                                                    \
    const unsigned st = lds0 + (unsigned)(((sb + t) & (NSTG - 1)) * STG_B);                                          \
    tdm_load(tdm_g0(st, gk, cnt0), tdm_g1(W0_A, rows, 128, th, krow));                                              \
    tdm_load(tdm_g0(st + 256, gk + 256, cnt0), tdm_g1(W0_B, rows, 64, th, krow));                                    \
    tdm_load(tdm_g0(st + K_B, gv, cnt0), tdm_g1(W0_V, rows, 128, th, vrow));                                         \
  };                                                                                                                 \
  /* a block's prologue loads, branch-free (every wave issues the same 11 TDM ops, NULL descriptors where the op */ \
  /* is not its own): Q columns 0..127 (wave 1) and 128..191 (wave 2) into the Q area, then the block's tiles     */ \
  /* 0..2 = ring slots 0..2 (wave 0)                                                                              */ \
  auto issue_block = [&](int qb, int hh, int bb, int sb) {                                                           \
    const int q0 = qb * BM;                                                                                          \
    const unsigned long long gq =                                                                                    \
        (unsigned long long)(uintptr_t)ka.Q + 2ull * ((((unsigned long long)bb * Sq_ + q0) * H_ + hh) * D_QK);       \
    tdm_load(tdm_g0(lds0 + Q_OFF, gq, wv == 1 ? 1 : 0), tdm_g1(W0_A, (unsigned)(Sq_ - q0), 128, BM, krow));          \
    tdm_load(tdm_g0(lds0 + Q_OFF + 256, gq + 256, wv == 2 ? 1 : 0),                                                  \
             tdm_g1(W0_B, (unsigned)(Sq_ - q0), 64, BM, krow));                                                      \
    const int n = ntiles(qb);                                                                                        \
    unsigned long long gk0, gv0;                                                                                     \
    kv_base(hh, bb, gk0, gv0);                                                                                       \
    issue_slot(0, n, sb, gk0, gv0);                                                                                  \
    issue_slot(1, n, sb, gk0, gv0);                                                                                  \
    issue_slot(2, n, sb, gk0, gv0);                                                                                  \
  };                                                                                                                 \
  (void)cshift, (void)npw_, (void)nqb_, (void)B_;

  // ---- the first block's prologue loads -----------------------------------------------------------------------------
  {
    HKF_BLOCK(0)
    int qb, hh, bb;
    if (!block_at(0, qb, hh, bb)) return;  // an idle persistent workgroup: no barrier, no memory access
    issue_block(qb, hh, bb, 0);
  }

  // ---- one block per iteration: only s and sb (the stage of the block's tile 0) carry over to the next --------------
  int sb = 0;
  for (int s = 0;; ++s) {
    HKF_BLOCK(s >> 30)
    const float c2 = ka.scale * LOG2E;
    int qb, hh, bb;
    block_at(s, qb, hh, bb);
    const int q0 = qb * BM;
    const int n = ntiles(qb);
    const int ncc = min((q0 + cshift + 1) / NB, n);  // tiles [0, ncc) need no mask for any row of the block
    unsigned long long gk0, gv0;
    kv_base(hh, bb, gk0, gv0);
    // the lane from v_mbcnt with a loop-variant addend (always 0): LLVM can neither hoist nor CSE it across blocks,
    // so no lane-derived VGPR stays live across the epilogue (the generated code starts right above the shell's VGPRs)
    const int lane = (int)__builtin_amdgcn_mbcnt_lo(~0u, (unsigned)(s >> 30));

    // B_0: Q (waves 1, 2) and tiles 0..2 (wave 0) landed and visible; every wave's reads of the previous block's
    // staging (in the stage this block's tile 3 goes to) retired. Every wave waits for all its TDM ops: the same code
    // on every wave, correct whether or not NULL descriptors count in TENSORcnt. Wave 0 thus waits for tiles 1, 2 as
    // well; issued with the Q one epilogue (~5k cycles) earlier, they have landed by then.
    tensor_wait<0>();
    bar_signal();
    bar_wait();

    // per-lane LDS bases of the fragment reads (FlyDSL's lane patterns): Q B operands (q tiles 0, 1 from qa, 2, 3 from
    // qb2, + 64 rows for q tiles 1, 3), K A operands (+ kv16 * 16 * XK + ks * 64 + {0, 32}), V^T A operands via
    // ds_load_tr16_b128 (+ (32 kt + 16 h) * XV + dt * 32)
    const unsigned qa = lds0 + Q_OFF + (unsigned)((16 * wv + (lane & 15)) * XK + (lane >> 4) * 16);
    const unsigned qb2 = qa + (unsigned)(2 * 64 * XK);
    const unsigned k_lane = (unsigned)((lane & 15) * XK + (lane >> 4) * 16);
    const unsigned v_lane = (unsigned)((((lane >> 4) * 8) + (lane & 7)) * XV + ((lane >> 3) & 1) * 16);
    // causal: element e of kv16 tile j of tile t (kv = 64 t + 16 j + 8 (lane / 16) + e) is masked for q tile i iff
    // 16 j + e > dl0 - 64 t + 64 i
    const int dl0 = q0 + 16 * wv + (lane & 15) + cshift - (lane >> 4) * 8;

#if HKGEN_REF
    f32x8 o[QT][NDT];
    float m[QT], d[QT];
    static_for<QT>([&](auto i) {
      m[i] = -1.0e30f;
      d[i] = 0.f;
      static_for<NDT>([&](auto dt) { o[i][dt] = zero8(); });
    });
    // one tile; kb, vb: the lane's K / V^T fragment bases in its stage. diag < 0: a tile below the diagonal (no mask);
    // diag = k: the diagonal tile ncc + k (q tiles below k skipped, the causal mask on q tile k, bound dl + 64 k)
    auto tile = [&](unsigned kb, unsigned vb, int dl, int diag) __attribute__((always_inline)) {
      const lds_u8* kp = lds_ptr(kb);
      const lds_u8* vp = lds_ptr(vb);
      bf16x16 kf[NKV][NKS];
      static_for<NKS>([&](auto ks) {
        static_for<NKV>([&](auto j) {
          kf[j][ks] = cat(lds_load_b128(kp, j * 16 * XK + ks * 64), lds_load_b128(kp, j * 16 * XK + ks * 64 + 32));
        });
      });
      bf16x16 vf[NDT][2];
      static_for<NDT>([&](auto dt) {
        static_for<2>([&](auto kt) {
          vf[dt][kt] = cat(lds_tr16(vp, kt * 32 * XV + dt * 32), lds_tr16(vp, (kt * 32 + 16) * XV + dt * 32));
        });
      });
      // the Q fragments too are read before the arrive: no LDS read may follow a tile's s_barrier_signal
      bf16x16 qfs[QT][NKS];
      static_for<QT>([&](auto i) {
        if (i < diag) return;
        const lds_u8* qp = lds_ptr((i < 2 ? qa : qb2) + (unsigned)((i & 1) * 64 * XK));
        static_for<NKS>([&](auto ks) {
          qfs[i][ks] = cat(lds_load_b128(qp, ks * 64), lds_load_b128(qp, ks * 64 + 32));
        });
      });
      __builtin_amdgcn_s_wait_tensorcnt((short)6);
      bar_signal();  // B_{t+1}: this wave's reads of the stage and of Q are done, wave 0's tile t + 1 landed
      static_for<QT>([&](auto i) {
        if (i < diag) return;
        f32x8 s[NKV];
        static_for<NKS>([&](auto ks) {
          const bf16x16 qf = qfs[i][ks];
          static_for<NKV>([&](auto j) {
            if constexpr (ks == 0) {
              s[j] = wmma(kf[j][0], qf, zero8());
            } else {
              s[j] = wmma(kf[j][ks], qf, s[j]);
            }
          });
        });
        if (i == diag) {
          const int dli = dl + 64 * i;
          static_for<NKV>([&](auto j) {
            static_for<8>([&](auto e) { s[j][(int)e] = (j * 16 + e > dli) ? -__builtin_inff() : s[j][(int)e]; });
          });
        }
        float x32[32];
        static_for<NKV>([&](auto j) { static_for<8>([&](auto e) { x32[j * 8 + e] = s[j][(int)e]; }); });
        const float mx = tree_max<32>(x32);  // the generated code's grouping (max is exact: any grouping is equal)
        const float lm = fmax2(mx, peer(mx));
        const float need = __builtin_fmaf(lm, c2, -m[i]);
        const bool resc = __builtin_amdgcn_ballot_w32(need > LOG2E) != 0u;
        const float rmax = lm * c2;
        const float mfull = fmax2(m[i], rmax);
        const float mn = resc ? mfull : m[i];
        const float corr = exp2_raw(m[i] - mn);
        float p[32];
        static_for<NKV>([&](auto j) {
          static_for<8>([&](auto e) { p[j * 8 + e] = exp2_raw(__builtin_fmaf(s[j][(int)e], c2, -mn)); });
        });
        const float ls = tree_sum<32>(p);
        const float tot = ls + peer(ls);
        d[i] = __builtin_fmaf(corr, d[i], tot);
        m[i] = mn;
        static_for<NDT>([&](auto dt) { o[i][dt] = o[i][dt] * corr; });
        static_for<2>([&](auto kt) {
          f32x8 pa, pb;
          static_for<8>([&](auto e) {
            pa[(int)e] = p[(2 * kt) * 8 + e];
            pb[(int)e] = p[(2 * kt + 1) * 8 + e];
          });
          const bf16x16 pf = cat(to_bf16x8(pa), to_bf16x8(pb));
          static_for<NDT>([&](auto dt) { o[i][dt] = wmma(vf[dt][kt], pf, o[i][dt]); });
        });
      });
    };
#else
    asm volatile("; HKGEN INIT qa=%0 qb=%1 c2=%2" ::"v"(qa), "v"(qb2), "s"(c2) : HKGEN_CLOBBERS);
#endif

    // ---- tiles [0, ncc): below the diagonal, no mask ----------------------------------------------------------------
    int t = 0;  // outside the for statement: the for-init form compiles to another .s (asm_input_sha256)
    for (; t < ncc; ++t) {
      issue_slot(t + 3, n, sb, gk0, gv0);
      const unsigned st = lds0 + (unsigned)(((sb + t) & (NSTG - 1)) * STG_B);
#if HKGEN_REF
      tile(st + k_lane, st + K_B + v_lane, 0, -1);
#else
      asm volatile("; HKGEN TILE_C kb=%0 vb=%1 c2=%2" ::"v"(st + k_lane), "v"(st + K_B + v_lane), "s"(c2)
                   : HKGEN_CLOBBERS);
#endif
      bar_wait();  // B_{t+1}
    }
    // ---- the diagonal tiles ncc + k, k < 4 (Sq == Skv) --------------------------------------------------------------
    static_for<4>([&](auto k) {
      if (ncc + k < n) {
        const int t2 = ncc + k;
        issue_slot(t2 + 3, n, sb, gk0, gv0);
        const unsigned st = lds0 + (unsigned)(((sb + t2) & (NSTG - 1)) * STG_B);
#if HKGEN_REF
        tile(st + k_lane, st + K_B + v_lane, dl0 - NB * t2, k);
#else
        asm volatile("; HKGEN TILE_D%c4 kb=%0 vb=%1 dl=%2 c2=%3" ::"v"(st + k_lane), "v"(st + K_B + v_lane),
                     "v"(dl0 - NB * t2), "s"(c2), "n"((int)k) : HKGEN_CLOBBERS);
#endif
        bar_wait();  // B_{t2+1}
      }
    });

    // ---- epilogue, in its own scope (its own argument view: nothing of it is live across the tiles) -----------------
    // First the next block's prologue loads, right after B_n, overlapping the output: every wave's reads of the ring
    // and of the Q area retired before B_n, and the next block's tiles 0..2 go to the three stages other than the one
    // of tile n - 1, which holds the staging below. Each wave first waits for its TDM ops in flight: wave 0's 1-row
    // copies of slots n..n + 2 target those three stages.
    // Phase 1, per q tile i: out and lse (FINAL_i, or the HKGEN_REF code) into this wave's SQT-byte staging slot:
    // q tiles 0, 1 in the stage of tile n - 1 (the next block's tile 3 goes there only after its B_0), q tiles 2, 3 at
    // TAIL; O row r at XO r (FlyDSL's 272-B staging stride), the lse of lane l at LSE_SLOT + 4 l.
    // Phase 2: per q tile 8 row-contiguous buffer stores (store j, lane l: row 2 j + l / 16, bytes 16 (l % 16) .. + 15
    // of the 256-B row), then one lse store. The stores run straight-line from the first one to the loop's back edge
    // or s_endpgm (both drain XCNT); every address operand is computed before the first store and never rewritten,
    // only the data registers (ds_load results) are, each after an s_wait_xcnt has retired the store that read it
    // (build.py's writeback check). A wave's LDS ops execute in order: the staging needs no counter wait, only the
    // compiler barrier (wave_lds_order).
    bool nxt;
    {
      HKF_BLOCK(n >> 30)
      int qbn, hhn, bbn;
      nxt = block_at(s + 1, qbn, hhn, bbn);
      if (nxt) {
        tensor_wait<0>();
        issue_block(qbn, hhn, bbn, (sb + n) & (NSTG - 1));
      }
      sched_barrier<0>();

      // fresh lane ids (lane2, ln), for the same reason as lane
      const int lane2 = (int)__builtin_amdgcn_mbcnt_lo(~0u, (unsigned)(n >> 30));
      const unsigned sga = lds0 + (unsigned)(((sb + n - 1) & (NSTG - 1)) * STG_B) + (unsigned)(wv * SQT);
      const unsigned sgb = lds0 + TAIL + (unsigned)(wv * SQT);
      const unsigned wl = (unsigned)((lane2 & 15) * XO + (lane2 >> 4) * 16);
      const unsigned wls = (unsigned)(LSE_SLOT + 4 * lane2);
      static_for<QT>([&](auto i) {
        i32x32 ob;
        float lse;
#if HKGEN_REF
        const float inv = d[i] > 0.f ? 1.0f / d[i] : 0.f;
        static_for<NDT>([&](auto dt) {
          const u32x4 w = __builtin_bit_cast(u32x4, to_bf16x8(o[i][dt] * inv));
          static_for<4>([&](auto r) { ob[4 * dt + (int)r] = (int)w[(int)r]; });
        });
        lse = (m[i] + __builtin_log2f(d[i])) * LN2;
#else
        asm volatile("; HKGEN FINAL_%c2 o=%0 lse=%1" : "=v"(ob), "=v"(lse) : "n"((int)i) : HKGEN_CLOBBERS);
#endif
        const unsigned tb = (i < 2 ? sga : sgb) + (unsigned)((i & 1) * 4 * SQT);
        lds_u8w* const wp = lds_wptr(tb + wl);
        static_for<NDT>([&](auto dt) {
          lds_store_b128(wp, dt * 32,
                         u32x4{(unsigned)ob[4 * dt], (unsigned)ob[4 * dt + 1], (unsigned)ob[4 * dt + 2],
                               (unsigned)ob[4 * dt + 3]});
        });
        lds_store_b32(lds_wptr(tb + wls), 0, __builtin_bit_cast(unsigned, lse));
        sched_barrier<0>();
      });
      wave_lds_order();

      // Phase 2 addresses (all before the first global store):
      //   O, q tile i: buffer resource r_o[i] based at its first row q0 + 64 i, soffset 2 j * row bytes (store j:
      //     rows 2 j, 2 j + 1), voffset vo_l (the lane's row 16 wv + l / 16 and 16-B column l % 16). The 64 rows
      //     q0 + 64 i .. + 63 are all < Sq or all >= Sq (Sq % 64 == 0): past Sq, num_records 0 drops the stores.
      //   lse: one ds_load_b64 + one buffer_store_b64 for the wave's 64 rows (lane l: q tile l / 8, rows 2 (l % 8)
      //     and 2 (l % 8) + 1 = the slots of lanes 2 (l % 8), + 1); a row past Sq gets voffset OOB (soffset null).
      const long long o_bytes = (long long)B_ * Sq_ * H_ * D_V * 2;
      const unsigned rsb = (unsigned)H_ * (unsigned)(D_V * 2);  // bytes per q row
      __amdgpu_buffer_rsrc_t r_o[QT];
      static_for<QT>([&](auto i) {
        const bool ok = q0 + 64 * i < Sq_;
        const long long off = (((long long)bb * Sq_ + q0 + 64 * i) * H_ + hh) * (D_V * 2);
        const long long rem = min(o_bytes - off, 0x7FFFFFFFll);
        const long long off2 = ok ? off : 0ll;
        const int nrec = ok ? (int)rem : 0;
        r_o[i] = rsrc((const unsigned char*)ka.O + off2, nrec);
      });
      const auto r_l = rsrc(ka.LSE, (int)min((long long)B_ * H_ * Sq_ * 4, 0x7FFFFFFFll));
      const int ln = (int)__builtin_amdgcn_mbcnt_lo(~0u, (unsigned)(ncc >> 30));
      const int hl = ln >> 4, rl = ln & 15, lt = ln >> 3, lk = ln & 7;
      const unsigned vo_l = (unsigned)(16 * wv + hl) * rsb + (unsigned)(rl * 16);
      const lds_u8* const rda = lds_ptr(sga + (unsigned)(hl * XO + rl * 16));  // q tiles 0, 1
      const lds_u8* const rdb = lds_ptr(sgb + (unsigned)(hl * XO + rl * 16));  // q tiles 2, 3
      const u32x2 lsev =
          lds_load_u32x2(lds_ptr((lt < 2 ? sga : sgb) + (unsigned)((lt & 1) * 4 * SQT + LSE_SLOT + 8 * lk)), 0);
      const unsigned lq = (unsigned)(q0 + 16 * wv + 64 * lt + 2 * lk);
      const unsigned la = (((unsigned)bb * (unsigned)H_ + (unsigned)hh) * (unsigned)Sq_ + lq) * 4u;
      const unsigned lo = q0 + 64 * lt < Sq_ ? la : OOB;
      sched_barrier<0>();
      static_for<QT>([&](auto i) {
        static_for<NDT>([&](auto j) {
          const u32x4 w = i < 2 ? lds_load_u32x4(rda, (i & 1) * 4 * SQT + 2 * j * XO)
                                : lds_load_u32x4(rdb, (i & 1) * 4 * SQT + 2 * j * XO);
          buf_store_b128(w, r_o[i], (int)vo_l, (int)((unsigned)(2 * j) * rsb));
        });
        sched_barrier<0>();
      });
      buf_store_b64(lsev, r_l, (int)lo, 0);
      sched_barrier<0>();
    }

    if (!nxt) break;
    sb = (sb + n) & (NSTG - 1);
  }
  tensor_wait<0>();  // past the last block: no TDM write (the 1-row copies) may land after the workgroup retires
}
