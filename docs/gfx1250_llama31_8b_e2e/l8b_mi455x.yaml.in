# Llama-3.1-8B BF16 pretraining, one MI455X (gfx1250): MBS = GBS = 4, seq 8192, no TP/PP/CP/FSDP.
# run_l8b_e2e.sh fills @STEPS@ / @HF_ASSETS@ / @WORKSPACE@.
work_group: ${PRIMUS_TEAM:amd}
user_name: ${PRIMUS_USER:root}
exp_name: ${PRIMUS_EXP_NAME:l8b_mi455x}
workspace: @WORKSPACE@

modules:
  pre_trainer:
    framework: torchtitan
    config: pre_trainer.yaml
    model: llama3.1_8B.yaml
    overrides:
      sink_level: null
      file_sink_level: DEBUG
      stderr_sink_level: INFO

      model:
        # 8B_flex == 8B except attn_type=flex. The primus_turbo converter below replaces the flex
        # (and the SDPA) attention wrapper with TurboAttention. torchtitan still compiles its
        # block-mask builder for 8B_flex every step; TurboAttention ignores the mask (plain causal).
        # Without the converter, plain 8B (SDPA) falls to the MATH backend on gfx1250, which
        # materialises the [4,32,8192,8192] score matrix and dies with SIGBUS.
        flavor: 8B_flex
        # Local tokenizer assets (the HF repo is gated); mock data needs only the tokenizer.
        hf_assets_path: @HF_ASSETS@
        # The converter is what installs TurboAttention. Without it torchtitan uses its flex
        # attention, which always torch.compile()s; its inductor autotune wedged this card.
        converters: ["primus_turbo"]

      debug:
        seed: 1234          # torchtitan does not seed a world_size==1 run otherwise

      profiling:
        enable_profiling: false

      metrics:
        log_freq: 1
        enable_wandb: false

      lr_scheduler:
        warmup_steps: 10

      training:
        local_batch_size: 4
        global_batch_size: 4
        seq_len: 8192
        mock_data: true
        steps: @STEPS@
        gc_freq: 100
        dataloader:
          num_workers: 1
          prefetch_factor: 4
          persistent_workers: true
          pin_memory: true

      parallelism:
        tensor_parallel_degree: 1
        pipeline_parallel_degree: 1
        context_parallel_degree: 1
        data_parallel_shard_degree: 1
        data_parallel_replicate_degree: 1

      # torch.compile off: inductor's triton autotune on this stack hit hipErrorLaunchFailure and
      # took the GPU down.
      compile:
        enable: false

      # No activation checkpointing: the run peaks at ~89% of HBM (384 GiB). Keep that in mind
      # before raising the batch or sequence length.
      activation_checkpoint:
        mode: "none"
        selective_ac_option: "op"

      # enable_primus_turbo + use_turbo_attention install Primus' Attention.forward, which calls
      # TurboAttention as (q, k, v). Without it torchtitan's own forward passes enable_gqa, which
      # TurboAttention rejects (TypeError). On gfx1250 TurboAttention dispatches to the FlyDSL
      # kernels of the dev/lhz/llama31_attn_opt branch.
      primus_turbo:
        enable_primus_turbo: true
        enable_attention_float8: false
        use_turbo_attention: true
        use_turbo_float8_linear: false
        use_turbo_mx_linear: false
        use_turbo_async_tp: false
