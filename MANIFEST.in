include README.md
include LICENSE
include LICENSE-APACHE
include setup.py
include pyproject.toml
include requirements.txt
include .gitmodules

recursive-include tools *.py
recursive-include csrc *
recursive-include primus_turbo *.py
recursive-include 3rdparty/composable_kernel/include *
recursive-include 3rdparty/hipify_torch/hipify_torch *
recursive-include 3rdparty/hipkittens/include *

# The vendored subtrees above are redistributed, so ship their licenses too.
include 3rdparty/composable_kernel/LICENSE
include 3rdparty/hipify_torch/LICENSE.txt
include 3rdparty/hipkittens/LICENSE

# setuptools_scm pulls in every git-tracked file by default; drop dev-only
# scaffolding (CI / editor / benchmarks / AI-agent docs) from the sdist.
prune agent
prune benchmark
prune .github
prune .cursor

global-exclude *.py[cod]
global-exclude __pycache__

# gfx1250 HipKittens attention: HIP sources and the code-object pins (setup.py builds bin/ from them);
# hip/tests are development tests, not shipped.
recursive-include primus_turbo/hipkittens/gfx1250_attn/hip *
prune primus_turbo/hipkittens/gfx1250_attn/hip/tests
include primus_turbo/hipkittens/gfx1250_attn/manifest.json
