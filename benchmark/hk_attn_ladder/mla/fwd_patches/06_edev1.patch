+      descriptors are computed before the first store), no write of a VGPR that an earlier store used as its ADDRESS;
+      a write of an earlier store's DATA VGPR only from a ds_load right after an s_wait_xcnt that retires that store
+      (in-order XCNT: the store has at most N younger stores);
+    and the store phase is the only VMEM in the kernel after the last TILE (the O / LSE writes of every q tile)."""
+    from asmkit.isa import load_any, regs_of, sgpr_defs_uses
+
+    _, ins, _ = load_any(objdump)
+    seq = [x for x in ins if x.mn and x.cls not in ("LABEL", "DIR")]
+    first = next((k for k, x in enumerate(seq) if x.mn.startswith(("buffer_store", "global_store"))), None)
+    end = next((k for k, x in enumerate(seq) if x.mn == "s_endpgm"), None)
+    res = {"stores": 0, "xcnt_waits": [], "first": first, "end": end}
+    if first is None or end is None or end < first:
+        fail.append("writeback: no store phase before s_endpgm")
+        return res
+    stores = []  # (data regs, addr regs) of the stores issued so far, oldest first
+    pend = None  # an s_wait_xcnt N seen and not yet consumed
+    for k in range(first, end + 1):
+        x = seq[k]
+        t = x.text.strip()
+        mn = x.mn
+        if mn == "s_endpgm":
+            break
+        if mn.startswith(("s_branch", "s_cbranch", "s_set_vgpr_msb", "s_setpc", "s_getpc", "s_swappc")):
+            fail.append(f"writeback: {t} inside the store phase")
+        sd, _ = sgpr_defs_uses(x)
+        if mn == "s_sendmsg" and "MSG_DEALLOC_VGPRS" in t:
+            continue  # LLVM's VGPR release right before s_endpgm (the HIP reference has it)
+        if sd and mn not in ("s_wait_xcnt", "s_wait_dscnt", "s_wait_alu", "s_nop"):
