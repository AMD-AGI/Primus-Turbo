--- a/r8gen/gen/r8gen.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/gen/r8gen.py	2026-10-29 10:11:49.000000000 +0000
@@ -0,0 +1,750 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""r8gen -- the generated regions of k_dkdv96ds's 96-row blocks (MHA, NKV 3): r8a's loop structure, re-scheduled.
+
+The shell (hip/src/k_dkdv96ds.hip, -DHKGEN=1) runs one STEP / STEPM marker per tile (the 3-stage Q / dO TDM ring,
+tile t in stage t mod 3, prefetch distance 2). build.py reads the registers LLVM gave the marker operands; this module
+returns the real instructions of every region:
+
+  INIT   K / V fragments (60 buffer_load_b128), accumulators = 0, (c1, c1), (scale, scale)
+  RB     hh0 operands of tile 0 (stage 0: 20 ds_load_b128), NL / ND of tile 0 (8 buffer_load_b128)
+  STEP   one tile k (STEPM: a diagonal tile -- the causal mask on, the dS^T stores of unstored blocks dropped):
+           TDM of tile k+2 (3 tensor_load_to_lds, operands from the shell)
+           S / dP of hh0 (30 WMMA, dt outer, operands read back in the previous step), the hh1 operands of stage k
+             streamed into the hh0 tuples as each dt dies, S / dP of hh1 (30 WMMA)
+           softmax / dS (k_dkdv96ds's arithmetic, packed f32): hh0 under hh1's WMMAs, hh1 kh by kh in front of and
+             under dV; bf16 P / dS straight into the dK / dV operand tuples
+           dV^T += dO^T P (24 WMMA, kh outer: the 8 dO^T tr16 operands), dK^T += Q^T dS (36 WMMA, d outer: 12 Q^T tr16
+             operands, the first 8 loaded early, the last 4 into dead hh1 raw tuples)
+           the dS^T stores of tile k (dslayout v2: each dS operand's two 16-B halves), NL / ND of tile k+1
+           s_wait_tensorcnt 3 + s_barrier_signal after the last LDS read of stage k, s_barrier_wait, then the hh0
+             operands of stage k+1 (into the dO^T tuples of this step, dead after dV) under dK
+  FINAL  accumulators -> bf16 dV / dK images in LDS (epi_images' layout), whole-line readback, global stores
+
+Numerics are k_dkdv96ds's per element and per accumulator: S / dP chains over dt ascending from +0, the same fma /
+exp2 / mul / RNE bf16 conversions, every dV / dK accumulator one WMMA per tile in tile order, so dk / dv / dS are
+meant to be bitwise equal to r9a's (dslayout v2).
+
+Register map (true VGPR numbers, all at or above the shell's `base`): see Layout. Program order is the semantics; the
+list scheduler (bwdgen.schedule) reorders along the dependence graph (asmkit's parser: VGPR / SGPR / scc / vcc RAW,
+WAR, WAW) plus order edges for LDS ordering (barrier, epilogue images). asmkit.emit adds s_set_vgpr_msb, the expert
+waits (va_vdst: --rule warv) and hazard v_nops."""
+
+import bwdgen as B
+from bwdgen import add_order, build_dag, mk, schedule, vr
+
+NKV, NDT_QK, NDT_V, NDO_V, NDO_QK = 3, 6, 4, 8, 12
+XK, XV = 400, 272
+QOFF = 32 * XV  # 8704: Q tile offset inside a ring stage
+QDO_B = 32 * (XV + XK)  # 21504: one ring stage
+DEPTH = 3  # ring stages
+DS_ST_B = 512
+NEG = "0xff61b1e6"  # K1_NEG = -3e38
+EPI_RB = 4 * NKV  # whole-line readback rows of 4 kv rows
+XS_DK = 12  # dK WMMAs between the barrier signal and its wait
+ABL = set()  # "tdm2x": every tile's TDM twice (results unchanged); timing-only ablations (garbage numerics): "nosoft" (no softmax VALU), "nolds" (no S/dP-operand or tr16 LDS
+#              loads: the WMMAs read stale registers), "nonl" (no NL/ND loads, no dS^T stores), "notdm" (no TDM)
+
+# machine model for the list scheduler (micro/wmma_mix: a WMMA issues every 8 cycles; ~3 core VALU + 1 TRANS behind
+# each are nearly free; LDS loads ~200 cycles under load)
+MODEL = {
+    "COST": {"VALU": 2, "TRANS": 3, "DS_LD": 2, "DS_ST": 2, "VM_LD": 2, "VM_ST": 2, "TDM": 2, "SALU": 1, "BAR_S": 1,
+             "BAR_W": 1, "WAIT_CNT": 0, "OTHER": 1},  # fmt: skip
+    "LAT": {"WMMA": 20, "VALU": 4, "TRANS": 8, "DS_LD": 90, "DS_ST": 4, "VM_LD": 800, "VM_ST": 4, "TDM": 4,
+            "SALU": 2, "BAR_S": 1, "BAR_W": 1, "WAIT_CNT": 1, "OTHER": 1},  # fmt: skip
+    "XDL_BUSY": 8,
+    "LDS_OCC": 8,
+    "LDS_LAT": 60,
+    "WMMA_CHAIN": 16,
+    "WAR_XDL": 24,
+}
+
+
+def set_nkv(n):
+    """Generate for blocks of 16 n kv rows per wave (3: the 96-row blocks, 2: the 64-row tail)."""
+    global NKV, EPI_RB
+    NKV, EPI_RB = n, 4 * n
+
+
+def apply_model():
+    B.LDS_OCC, B.LDS_LAT = MODEL.get("LDS_OCC"), MODEL.get("LDS_LAT")
+    B.COST.clear()
+    B.COST.update(MODEL["COST"])
+    B.LAT.clear()
+    B.LAT.update(MODEL["LAT"])
+    B.XDL_BUSY, B.WMMA_CHAIN, B.WAR_XDL = MODEL["XDL_BUSY"], MODEL["WMMA_CHAIN"], MODEL["WAR_XDL"]
+
+
+class Layout:
+    """VGPR map (true numbers) of the generated state. Everything at or above `base`; 8-VGPR tuples never cross a
+    256 block. Roles of the shared tuples over one step:
+      O[0..9]  hh0 operands (Q dt 0..5 at O[2 dt] / O[8 + dt - 4], dO dt 0..3 at O[2 dt + 1]); the hh1 operand of the
+               same slot streams in once hh0's dt died; then dO^T operands BDO[d] = O[d] (d < 8, after hh1's dt
+               died) and Q^T operands BQ[6], BQ[7] = O[8], O[9]; after dV, the next step's hh0 operands
+      R0[0..5] hh0 raw S / dP (R0[2 kh] = S, R0[2 kh + 1] = dP); after hh0's softmax BQ[0..5]
+      R1[0..5] hh1 raw S / dP; after hh1's softmax BQ[8..11] = R1[0..3]
+      P[kh], DS[kh]  bf16 P / dS operands of kv sub-tile kh (dwords 0..3: hh0, 4..7: hh1)
+      PRE[e]   NL / ND quads (e = hh * 4 + {0, 1}: NL, + {2, 3}: ND), the next tile's after the last read
+      ACC, KF, VF  accumulators (dV (kh, d) at kh * 8 + d, dK at 24 + kh * 12 + d), K / V fragments
+      T[0..1]  mask scratch (STEPM)"""
+
+    def __init__(self, base):
+        self.base = base
+        nxt = [base + (base % 2)]
+        blocks = {0: [], 1: [], 2: [], 3: []}
+
+        def take(n, align=2):
+            for blk in range(4):
+                lo = max(nxt[0] if blk == 0 else 0, blk * 256)
+                # first fit inside this block, after everything taken there
+                used = blocks[blk]
+                r = max([lo] + [a + m for a, m in used])
+                r += (-r) % align
+                if r + n <= (blk + 1) * 256:
+                    used.append((r, n))
+                    return r
+            raise ValueError(f"layout does not fit above base v{base}")
+
+        # big persistent arrays first, block by block (so the tuples land where planned)
+        self.acc = [take(8, 8) for _ in range(NKV * (NDO_V + NDO_QK))]  # NKV 3: 480, blocks 1, 2 (+ rest of 0 / 3)
+        self.kf = [[take(8, 8) for _ in range(NDT_QK)] for _ in range(NKV)]
+        self.vf = [[take(8, 8) for _ in range(NDT_V)] for _ in range(NKV)]
+        self.O = [take(8, 8) for _ in range(10)]
+        self.R0 = [take(8, 8) for _ in range(2 * NKV)]
+        self.R1 = [take(8, 8) for _ in range(2 * NKV)]
+        self.D = [take(8, 8) for _ in range(NDO_V)]
+        # bf16 P / dS operands in place of hh0's raw S / dP (hh0's dwords 0..3, hh1's 4..7)
+        self.P = [self.R0[2 * kh] for kh in range(NKV)]
+        self.DS = [self.R0[2 * kh + 1] for kh in range(NKV)]
+        pre8 = [take(8, 8) for _ in range(4)]  # (hh0 NL, hh0 ND, hh1 NL, hh1 ND): 8-VGPR tuples (ND: a C operand)
+        self.PRE = [pre8[e // 2] + 4 * (e % 2) for e in range(8)]
+        self.cc1, self.ccs = take(2), take(2)
+        self.T = [take(1, 1) for _ in range(2 + NKV)]  # mask scratch (2), STEPM's dS^T voffsets (NKV)
+        self.PRB = [take(1, 1) for _ in range(4)]  # probe: per-segment cycle sums (HKGEN_PROBE builds)
+        self.top = max(a + m for blk in blocks.values() for a, m in blk)
+
+    # roles
+    def op_hh0(self, isq, dt):
+        """hh0 operand tuple: Q (isq 1) of dt, or dO (isq 0) of dt < 4."""
+        return self.O[2 * dt] if (isq and dt < 4) else (self.O[8 + dt - 4] if isq else self.O[2 * dt + 1])
+
+    op_hh1 = op_hh0  # the same slots, once hh0's dt died
+
+    def raw(self, hh, kh, j):
+        return (self.R0 if hh == 0 else self.R1)[2 * kh + j]
+
+    def bdo(self, d):
+        return self.D[d]
+
+    def bq(self, d):
+        return self.O[d] if d < 10 else self.D[d - 10]
+
+    def dv(self, kh, d):
+        return self.acc[kh * NDO_V + d]
+
+    def dk(self, kh, d):
+        return self.acc[NKV * NDO_V + kh * NDO_QK + d]
+
+    def all_regs(self):
+        regs = set()
+        for t in self.acc + [x for r in self.kf for x in r] + [x for r in self.vf for x in r] + self.O + self.R0 + \
+                self.R1 + self.D:  # fmt: skip
+            regs |= set(range(t, t + 8))
+        for q in self.PRE:
+            regs |= set(range(q, q + 4))
+        regs |= {self.cc1, self.cc1 + 1, self.ccs, self.ccs + 1} | set(self.T)
+        return regs
+
+
+# --------------------------------------------------------------------------------------------------------------
+# regions
+# --------------------------------------------------------------------------------------------------------------
+def region_init(L, ops):
+    """INIT: (c1, c1), (scale, scale) (ND_FOLD: (1 / scale, 1 / scale), FINAL's dV factor); accumulators = 0; K / V
+    fragments (buffer loads: lane part + kv sub-tile part + dt * 64 + u * 32)."""
+    out = [f"v_mov_b32 {vr(L.cc1)}, {ops['c1']}", f"v_mov_b32 {vr(L.cc1 + 1)}, {ops['c1']}"]
+    if ND_FOLD:
+        out += [f"v_rcp_f32 {vr(L.ccs)}, {ops['sc']}", f"v_mov_b32 {vr(L.ccs + 1)}, {vr(L.ccs)}"]
+    else:
+        out += [f"v_mov_b32 {vr(L.ccs)}, {ops['sc']}", f"v_mov_b32 {vr(L.ccs + 1)}, {ops['sc']}"]
+    if "lk" in ops:  # shell -DHKGEN_KV_TDM: K / V rows by TDM into the wave's LDS staging area ([16 NKV][XV] of V,
+        #              then [16 NKV][XK] of K; ops as a ring stage's, descriptors in s96..s103 / s92..s95 one op
+        #              at a time: INIT may clobber only s90..s103), the accumulators cleared while they are in
+        #              flight, the fragments read once every TDM op landed
+        rows = 16 * NKV
+        kg, vg = ops["kg"], ops["vg"]
+        for o in range(3):
+            g1, g0 = 96, 92
+            ga = (vg if o == 0 else kg)
+            lo, hi = _sv(ga, 0), _sv(ga, 1)
+            words = [hex(TDM_W0[o]), "0xffff0000", hex((rows << 16) | 0x7FFF), hex((64 if o == 2 else 128) << 16),
+                     str(rows)]
+            out += [f"s_mov_b32 s{g1 + i}, {w}" for i, w in enumerate(words)]
+            out += [f"s_mul_i32 s{g1 + 5}, {ops['hkv']}, {128 if o == 0 else 192}", f"s_mov_b32 s{g1 + 6}, 0",
+                    f"s_mov_b32 s{g1 + 7}, 0", f"s_mov_b32 s{g0}, 1",
+                    f"s_add_co_i32 s{g0 + 1}, {ops['kvl']}, {0 if o == 0 else rows * XV + (256 if o == 2 else 0)}",
+                    f"s_add_co_u32 s{g0 + 2}, {lo}, {256 if o == 2 else 0}", f"s_add_co_ci_u32 s{g0 + 3}, {hi}, 0",
+                    f"s_bitset1_b32 s{g0 + 3}, 31", f"tensor_load_to_lds s[{g0}:{g0 + 3}], s[{g1}:{g1 + 7}]"]  # fmt: skip
+        for t in L.acc:
+            for q in range(0, 8, 2):
+                out.append(f"v_mov_b64 {vr(t + q, 2)}, 0")
+        out += [f"v_mov_b32 {vr(r)}, 0" for r in L.PRB]
+        out.append("s_wait_tensorcnt 0x0")
+        for kh in range(NKV):
+            for dt in range(NDT_QK):
+                for u in range(2):
+                    off = kh * 16 * XK + dt * 64 + u * 32
+                    out.append(f"ds_load_b128 {vr(L.kf[kh][dt] + 4 * u, 4)}, {ops['lk']}" + (f" offset:{off}" if off else ""))
+            for dt in range(NDT_V):
+                for u in range(2):
+                    off = kh * 16 * XV + dt * 64 + u * 32
+                    out.append(f"ds_load_b128 {vr(L.vf[kh][dt] + 4 * u, 4)}, {ops['lv']}" + (f" offset:{off}" if off else ""))
+        return out
+    for kh in range(NKV):
+        for dt in range(NDT_QK):
+            for u in range(2):
+                off = dt * 64 + u * 32
+                out.append(f"buffer_load_b128 {vr(L.kf[kh][dt] + 4 * u, 4)}, {ops['vk']}, {ops['rk']}, "
+                           f"{ops['sk' + str(kh)]} offen" + (f" offset:{off}" if off else ""))  # fmt: skip
+        for dt in range(NDT_V):
+            for u in range(2):
+                off = dt * 64 + u * 32
+                out.append(f"buffer_load_b128 {vr(L.vf[kh][dt] + 4 * u, 4)}, {ops['vv']}, {ops['rv']}, "
+                           f"{ops['sv' + str(kh)]} offen" + (f" offset:{off}" if off else ""))  # fmt: skip
+    for t in L.acc:
+        for q in range(0, 8, 2):
+            out.append(f"v_mov_b64 {vr(t + q, 2)}, 0")
+    out += [f"v_mov_b32 {vr(r)}, 0" for r in L.PRB]
+    return out
+
+
+def rb_texts(L, qbase, vbase, hh, dst_of, stage):
+    """The 20 ds_load_b128 of one hh half's S / dP operands of ring stage `stage` (k1_rd_const offsets from the lane
+    bases; the stage offset in the immediate)."""
+    out = []
+    so = stage * QDO_B
+    for dt in range(NDT_QK):
+        for u in range(2):
+            off = so + QOFF + hh * 16 * XK + dt * 64 + u * 32
+            out.append((("Q", dt, u), f"ds_load_b128 {vr(dst_of(1, dt) + 4 * u, 4)}, {qbase} offset:{off}"))
+        for u in range(2 if dt < NDT_V else 0):
+            off = so + hh * 16 * XV + dt * 64 + u * 32
+            out.append((("D", dt, u), f"ds_load_b128 {vr(dst_of(0, dt) + 4 * u, 4)}, {vbase}"
+                        + (f" offset:{off}" if off else "")))  # fmt: skip
+    return out
+
+
+def nl_texts(L, ops):
+    out = []
+    for e in range(8):
+        r = ops["rnl"] if (e % 4) // 2 == 0 else ops["rnd"]
+        off = (e // 4) * 64 + (e % 2) * 16
+        out.append(f"buffer_load_b128 {vr(L.PRE[e], 4)}, {ops['nlv']}, {r}, {ops['nls']} offen"
+                   + (f" offset:{off}" if off else ""))  # fmt: skip
+    return out
+
+
+def region_rb(L, ops):
+    """RB (prologue, after the shell's barrier): hh0 operands of stage 0, NL / ND of tile 0."""
+    return [t for _, t in rb_texts(L, ops["lq"], ops["lv"], 0, L.op_hh0, 0)] + nl_texts(L, ops)
+
+
+def softmax_unit(L, hh, kh, masked, add, mask_tmp=None):
+    if "nosoft" in ABL:
+        return [add(f"v_mov_b32 {vr(L.P[kh] + hh * 4)}, {vr(L.raw(hh, kh, 0))}")]
+    """Node indices of one (hh, kh) unit's softmax / dS: 4 element pairs, straight into P[kh] / DS[kh] dwords
+    hh * 4 + j. masked: tt = kv > q + cshift ? K1_NEG : tt (mask_tmp: VGPR holding dl - thr - 16 (hh - kh), so the
+    element si is masked iff mask_tmp > si)."""
+    nodes = []
+    s_, d_ = L.raw(hh, kh, 0), L.raw(hh, kh, 1)
+    for j in range(4):
+        nl = L.PRE[hh * 4 + j // 2] + 2 * (j % 2)
+        nd = L.PRE[hh * 4 + 2 + j // 2] + 2 * (j % 2)
+        s2, d2 = s_ + 2 * j, d_ + 2 * j
+        nodes.append(add(f"v_pk_fma_f32 {vr(s2, 2)}, {vr(s2, 2)}, {vr(L.cc1, 2)}, {vr(nl, 2)}"))
+        if masked:
+            for e in range(2):
+                si = 2 * j + e
+                nodes.append(add(f"v_cmp_ge_i32 vcc_lo, {si}, {vr(mask_tmp)}"))
+                nodes.append(add(f"v_cndmask_b32 {vr(s2 + e)}, {NEG}, {vr(s2 + e)}, vcc_lo"))
+        nodes.append(add(f"v_exp_f32 {vr(s2)}, {vr(s2)}"))
+        nodes.append(add(f"v_exp_f32 {vr(s2 + 1)}, {vr(s2 + 1)}"))
+        if not ND_FOLD:
+            nodes.append(add(f"v_pk_fma_f32 {vr(d2, 2)}, {vr(d2, 2)}, {vr(L.ccs, 2)}, {vr(nd, 2)}"))
+        nodes.append(add(f"v_pk_mul_f32 {vr(d2, 2)}, {vr(s2, 2)}, {vr(d2, 2)}"))
+        w = hh * 4 + j
+        nodes.append(add(f"v_cvt_pk_bf16_f32 {vr(L.P[kh] + w)}, {vr(s2)}, {vr(s2 + 1)}"))
+        nodes.append(add(f"v_cvt_pk_bf16_f32 {vr(L.DS[kh] + w)}, {vr(d2)}, {vr(d2 + 1)}"))
+    return nodes
+
+
+ND_FOLD = False  # k_delta -DHK_ND_FOLD: ND' = -delta is the dP chains' C init, NL' = NL + log2(scale) makes the
+#                 softmax's P' = scale * P, so dS = P' dP' needs no dP fma; dV = (dO^T P') / scale in FINAL
+SCAL_IN_BODY = False  # each body computes the next tile's scalars (SALU nodes in its WMMA windows); the headers keep
+#                      only the M / U branch, and U falls through into N (the M bodies out of line)
+TDM_DUMMY = False  # a tile past the last (k + 2 >= N) moves 16 B (tile 8 x 1) instead of re-loading tile N-1: no
+#                   wasted L2 / HBM traffic, and the epilogue's tensorcnt-0 wait finds the ring settled
+FINAL_PIPE = False  # FINAL in program order, pipelined: group (V / K image, kh) converted + stored to its image while
+#                    the previous group's rows are read back and stored to global memory (a readback needs only its
+#                    own group's image stores; LDS ops of a wave are in order). Else list-scheduled, every image
+#                    store before every readback
+TDM_LIM_SC7 = False  # TDM_DUMMY's limit is sc[7] (the tiles this wave moves), not N: a wave with sc[7] = 0 only
+#                     moves 16-B dummies (shell -DHKGEN_W4: waves 2, 3 share waves 0, 1's ring)
+SCAL_XCNT_GAP = 160  # cycles between a VMEM / TDM op and the next tile's redefinition of an SGPR it reads
+HH1_SPLIT = 0  # hh1's S / dP order: dt < HH1_SPLIT dt outer (every kh), the rest kh-major (6: all dt outer)
+BDO_AFTER_HH1 = False  # the dO^T loads issue only after every hh1 operand load (they do not crowd the LDS queue)
+
+
+def hh1_order():
+    """hh1's S / dP WMMAs, kh-major: kh 0's chains finish a third into hh1's run, so its softmax (and so P[0], the
+    first dV operand) hides under kh 1 / 2's WMMAs. The S and dP chains of one kh interleave; a chain's next WMMA
+    stands >= 2 positions after its previous one (16 cycles: WMMA_CHAIN); lower kh first, then the chain with more
+    WMMAs left. Items (kind 'S' / 'P', kh, dt)."""
+    out = []
+    for dt in range(min(HH1_SPLIT, NDT_QK)):
+        for kind in ("S", "P"):
+            if kind == "P" and dt >= NDT_V:
+                continue
+            out += [(kind, kh, dt) for kh in range(NKV)]
+    chains = []
+    for kh in range(NKV):
+        chains.append([("S", kh, dt) for dt in range(HH1_SPLIT, NDT_QK)])
+        chains.append([("P", kh, dt) for dt in range(HH1_SPLIT, NDT_V)])
+    chains = [c for c in chains if c]
+    last, nxt = [-10] * len(chains), [0] * len(chains)
+    n0 = len(out)
+    while len(out) - n0 < sum(len(c) for c in chains):
+        p = len(out)
+        live = [c for c in range(len(chains)) if nxt[c] < len(chains[c])]
+        cand = [c for c in live if last[c] <= p - 2] or live
+        c = min(cand, key=lambda c: (chains[c][0][1], -(len(chains[c]) - nxt[c]), c))
+        out.append(chains[c][nxt[c]])
+        nxt[c] += 1
+        last[c] = p
+    return out
+
+
+def step_nodes(L, ops, masked, stage, scal=None):
+    """Nodes of one tile in ring stage `stage` (program order = semantics) and the WMMA stream order.
+
+    Register roles over the step (Layout): hh0's S / dP operands in O (read back in the previous step), hh0's raw S /
+    dP in R0; hh1's operands stream into O as hh0's dt die, hh1's raw in R1. Softmax / dS write bf16 P / dS in place
+    of hh0's raw (P[kh] = R0[2 kh], dS[kh] = R0[2 kh + 1]: hh0's dwords 0..3, hh1's 4..7). dO^T operands in their own
+    tuples D (loaded any time in the step); Q^T 0..9 into O once hh1's S / dP ended, Q^T 10, 11 into D[0], D[1] once
+    dV read them; the next step's hh0 operands into O as dK releases Q^T 0..9 (after the ring barrier)."""
+    nodes = []
+
+    def add(text):
+        nodes.append(mk(text))
+        return len(nodes) - 1
+
+    w_sdp0, w_sdp1, w_dv, w_dk = [], [], [], []
+    stage_reads, nxt_reads, hh1_ld, bdo_loads = [], [], [], []
+    so = stage * QDO_B
+    nolds = "nolds" in ABL
+    # TDM of tile k+2 (its stage's previous tile was last read before the previous step's barrier); it must issue
+    # before the tensorcnt wait below, which then retires tile k+1 (outstanding: k+1, k+2)
+    tdm = [add(f"tensor_load_to_lds {ops['g0' + c]}, {ops['g1' + c]}") for c in "abc"] if "notdm" not in ABL else []
+    if "tdm2x" in ABL:  # the same 3 ops again (same stage, same bytes): the stream's cost at unchanged results
+        tdm += [add(f"tensor_load_to_lds {ops['g0' + c]}, {ops['g1' + c]}") for c in "abc"]
+
+    def wmma_sdp(hh, kind, kh, dt):
+        if kind == "S":
+            s_ = L.raw(hh, kh, 0)
+            c = "0" if dt == 0 else vr(s_, 8)
+            return add(f"v_wmma_f32_16x16x32_bf16 {vr(s_, 8)}, {vr(L.op_hh0(1, dt), 8)}, {vr(L.kf[kh][dt], 8)}, {c}")
+        d_ = L.raw(hh, kh, 1)
+        c = (vr(L.PRE[hh * 4 + 2], 8) if ND_FOLD else "0") if dt == 0 else vr(d_, 8)
+        return add(f"v_wmma_f32_16x16x32_bf16 {vr(d_, 8)}, {vr(L.op_hh0(0, dt), 8)}, {vr(L.vf[kh][dt], 8)}, {c}")
+
+    # ---- S / dP of hh0, dt outer (S of every kh, then dP: the A operand shared by consecutive WMMAs); hh1's operands
+    # of each dt stream into the slots hh0's dt just released (program order after their readers)
+    hh1_loads = dict(rb_texts(L, ops["lq"], ops["lv"], 1, L.op_hh1, stage))
+    for dt in range(NDT_QK):
+        for kind in ("S", "P"):
+            if kind == "P" and dt >= NDT_V:
+                continue
+            for kh in range(NKV):
+                w_sdp0.append(wmma_sdp(0, kind, kh, dt))
+        for u in range(2 if not nolds else 0):
+            stage_reads.append(add(hh1_loads[("Q", dt, u)]))
+            hh1_ld.append(stage_reads[-1])
+            if dt < NDT_V:
+                stage_reads.append(add(hh1_loads[("D", dt, u)]))
+                hh1_ld.append(stage_reads[-1])
+    # dO^T operands (own tuples: free since the previous step's dV)
+    for d in range(NDO_V if not nolds else 0):
+        for p in range(2):
+            off = so + d * 32 + p * 16 * XV
+            stage_reads.append(add(f"ds_load_tr16_b128 {vr(L.bdo(d) + 4 * p, 4)}, {ops['ltv']}"
+                                   + (f" offset:{off}" if off else "")))  # fmt: skip
+            bdo_loads.append(stage_reads[-1])
+    # ---- S / dP of hh1, kh-major
+    for kind, kh, dt in hh1_order():
+        w_sdp1.append(wmma_sdp(1, kind, kh, dt))
+    # ---- softmax / dS: hh0 then hh1, kh by kh; bf16 P / dS in place of hh0's raw
+    soft = {}
+    for hh in range(2):
+        for kh in range(NKV):
+            mt = None
+            if masked:
+                sreg = "s96" if hh == 0 else "s97"
+                add(f"s_add_co_i32 {sreg}, {ops['thr']}, {16 * (hh - kh)}")
+                add(f"v_subrev_nc_u32 {vr(L.T[hh])}, {sreg}, {ops['dl']}")
+                mt = L.T[hh]
+            soft[(hh, kh)] = softmax_unit(L, hh, kh, masked, add, mt)
+    # Q^T operands 0..9 into O (hh1's operands dead after its S / dP)
+    bq_loads = {}
+
+    def qt_load(d):
+        bq_loads[d] = []
+        for p in range(2 if not nolds else 0):
+            off = so + QOFF + d * 32 + p * 16 * XK
+            bq_loads[d].append(add(f"ds_load_tr16_b128 {vr(L.bq(d) + 4 * p, 4)}, {ops['ltk']} offset:{off}"))
+            stage_reads.append(bq_loads[d][-1])
+
+    for d in range(10):
+        qt_load(d)
+    # ---- dV^T += dO^T P (kh outer: dV of kh 0 needs P[0] only)
+    for kh in range(NKV):
+        for d in range(NDO_V):
+            a = L.dv(kh, d)
+            w_dv.append(add(f"v_wmma_f32_16x16x32_bf16 {vr(a, 8)}, {vr(L.bdo(d), 8)}, {vr(L.P[kh], 8)}, {vr(a, 8)}"))
+    # Q^T operands 10, 11 into D[0], D[1] (dead after dV)
+    for d in range(10, NDO_QK):
+        qt_load(d)
+    # ---- dS^T stores of tile k (dslayout v2) and NL / ND of tile k+1 (PRE dead after the softmax)
+    ex = []
+    for kh in range(NKV):
+        vd = ops["vds"]
+        if masked:  # a block with no attended entry in this pair is not stored (dslayout): out-of-range voffset
+            ex.append(add(f"v_add_nc_u32 {vr(L.T[2 + kh])}, {ops['pt' + str(kh)]}, {ops['vds']}"))
+            vd = vr(L.T[2 + kh])
+        ex.append(add(f"buffer_store_b128 {vr(L.DS[kh], 4)}, {vd}, {ops['rds']}, {ops['ds' + str(kh)]} offen"))
+        ex.append(add(f"buffer_store_b128 {vr(L.DS[kh] + 4, 4)}, {vd}, {ops['rds']}, {ops['ds' + str(kh)]} offen "
+                      f"offset:{DS_ST_B}"))  # fmt: skip
+    nl = [add(t) for t in nl_texts(L, ops)] if "nonl" not in ABL else []
+    if "nonl" in ABL:
+        ex = [i for i in ex if nodes[i].kind != "VM_ST"]
+    # ---- the ring barrier after the last LDS read of stage k (tensorcnt 3: tile k+1 landed), dK (d outer), the
+    # next step's hh0 operands (stage k+1) into O as dK releases Q^T 0..9 (program order: after the barrier wait)
+    tw = add("s_wait_tensorcnt 0x6" if "tdm2x" in ABL else "s_wait_tensorcnt 0x3")
+    bs = add("s_barrier_signal -1")
+    bw = add("s_barrier_wait -1")
+    for d in range(NDO_QK):
+        for kh in range(NKV):
+            a = L.dk(kh, d)
+            w_dk.append(add(f"v_wmma_f32_16x16x32_bf16 {vr(a, 8)}, {vr(L.bq(d), 8)}, {vr(L.DS[kh], 8)}, {vr(a, 8)}"))
+    for _, t in rb_texts(L, ops["lq"], ops["lv"], 0, L.op_hh0, (stage + 1) % DEPTH) if not nolds else []:
+        nxt_reads.append(add(t))
+    scal_nodes = [add(t) for t in scal or []]  # the next tile's scalars (after every use of this tile's values)
+    build_dag(nodes)
+    for j in scal_nodes:  # an SGPR an in-flight VMEM / TDM op still reads: redefine it well after (XCNT)
+        for i in range(len(nodes)):
+            if nodes[i].kind in ("VM_LD", "VM_ST", "TDM") and i < j and nodes[i].suses & nodes[j].sdefs:
+                add_order(nodes, i, j, SCAL_XCNT_GAP)
+    for i in tdm:
+        add_order(nodes, i, tw)
+    add_order(nodes, tw, bs)
+    add_order(nodes, bs, bw)
+    for i in stage_reads:
+        add_order(nodes, i, tw)  # the tensorcnt wait (and so the signal) behind the stage's last LDS read
+    # memory ops with a hazard against core VALU (LLVM's va_vdst rule drains every in-flight VALU for them while
+    # WMMAs run): the dS^T stores (RAW on the bf16 converts) and the NL / ND loads (WAR on PRE) behind the whole
+    # softmax, so one drain covers them
+    sm = [i for k in soft for i in soft[k]]
+    for i in ex + nl:
+        if nodes[i].kind in ("VM_ST", "VM_LD"):
+            for j in sm:
+                add_order(nodes, j, i)
+    for i in nxt_reads:
+        add_order(nodes, bw, i)
+    if BDO_AFTER_HH1:
+        for i in bdo_loads:
+            for j in hh1_ld:
+                add_order(nodes, j, i)
+    return nodes, w_sdp0 + w_sdp1 + w_dv + w_dk
+
+
+PROBE_PTS = None  # HKGEN_PROBE builds: the three probe points as WMMA counts (None: S/dP end, dV end, barrier wait)
+PROBE_SEGS = ("S/dP hh0+hh1 (+softmax hh0)", "softmax hh1 + dV", "dK to the barrier wait", "dK rest")
+
+
+def region_step(L, ops, masked, stage, mode="list", probe=False, scal=None):
+    """(texts, modelled cycles). probe: s_get_shader_cycles at the region start, after the last S / dP WMMA, after the
+    last dV WMMA, after the barrier wait and at the end; segment k's delta added to L.PRB[k] (VALU, per lane)."""
+    apply_model()
+    nodes, wseq = step_nodes(L, ops, masked, stage, scal)
+    if mode == "win":
+        out, cyc = B.schedule_win(nodes, wseq)
+    elif mode == "slot":
+        out, cyc = B.schedule_slot(nodes, wseq)
+    else:
+        out, cyc = schedule(nodes, wseq, mode)
+    texts = [n.text for n in out]
+    if probe:
+        wpos = [k for k, n in enumerate(out) if n.kind == "WMMA"]
+        bw = next(k for k, n in enumerate(out) if n.kind == "BAR_W")
+        n_sdp, n_dv = 20 * NKV, 8 * NKV
+        pts = sorted([wpos[n_sdp - 1] + 1, wpos[n_sdp + n_dv - 1] + 1, bw + 1])
+        if PROBE_PTS:  # after WMMA #k (1-based) of the step, k in PROBE_PTS (3 points: 4 segments)
+            pts = sorted(wpos[min(k, len(wpos)) - 1] + 1 for k in PROBE_PTS)
+        res, k0, prev = ["s_get_shader_cycles_u64 s[102:103]"], 0, "s102"
+        for seg, k in enumerate(pts + [len(texts)]):
+            res += texts[k0:k]
+            cur = "s100" if prev == "s102" else "s102"
+            res += [f"s_get_shader_cycles_u64 s[{cur[1:]}:{int(cur[1:]) + 1}]",
+                    f"v_add_nc_u32 {vr(L.PRB[seg])}, {cur}, {vr(L.PRB[seg])}",
+                    f"v_subrev_nc_u32 {vr(L.PRB[seg])}, {prev}, {vr(L.PRB[seg])}"]  # fmt: skip
+            prev, k0 = cur, k
+        texts = res
+    return texts, cyc
+
+
+def region_final(L, ops):
+    """FINAL: accumulators -> bf16 images (k3_epi_wr: lane base ev / ek + kh * 16 * x + d * 32), whole-line readback
+    (k3_epi_rd: lane base rv / rk + rb * 4 * x + li * 128) and global stores (lane voffset gv / gk, soffset sov / sok
+    + rb * rsv / rsk, offset li * 128). The image stores precede every readback (order edges: LDS); FINAL_PIPE: see
+    there."""
+    if FINAL_PIPE:
+        return region_final_pipe(L, ops)
+    nodes = []
+
+    def add(text):
+        nodes.append(mk(text))
+        return len(nodes) - 1
+
+    stores, loads = [], []
+    for isk, x, n_d, base in ((0, XV, NDO_V, ops["ev"]), (1, XK, NDO_QK, ops["ek"])):
+        for kh in range(NKV):
+            for d in range(n_d):
+                a = L.dv(kh, d) if isk == 0 else L.dk(kh, d)
+                if ND_FOLD and isk == 0:  # dV' = dO^T P' = scale * dV
+                    for q in range(4):
+                        add(f"v_pk_mul_f32 {vr(a + 2 * q, 2)}, {vr(a + 2 * q, 2)}, {vr(L.ccs, 2)}")
+                for q in range(4):
+                    add(f"v_cvt_pk_bf16_f32 {vr(a + q)}, {vr(a + 2 * q)}, {vr(a + 2 * q + 1)}")
+                off = kh * 16 * x + d * 32
+                stores.append(add(f"ds_store_b128 {base}, {vr(a, 4)}" + (f" offset:{off}" if off else "")))
+    tmp = [L.O[i] for i in range(10)] + list(L.R0) + list(L.R1)
+    k = 0
+    for isk, x, nli, rbase, gv, so, rs, rsrc in ((0, XV, 2, ops["rv"], ops["gv"], ops["sov"], ops["rsv"], ops["rdv"]),
+                                                 (1, XK, 3, ops["rk"], ops["gk"], ops["sok"], ops["rsk"], ops["rdk"])):
+        sreg = "s92" if isk == 0 else "s93"
+        add(f"s_mov_b32 {sreg}, {so}")
+        for rb in range(EPI_RB):
+            if rb:
+                add(f"s_add_co_i32 {sreg}, {sreg}, {rs}")
+            for li in range(nli):
+                t = tmp[k % len(tmp)] + 4 * ((k // len(tmp)) % 2)
+                k += 1
+                off = rb * 4 * x + li * 128
+                loads.append(add(f"ds_load_b128 {vr(t, 4)}, {rbase}" + (f" offset:{off}" if off else "")))
+                add(f"buffer_store_b128 {vr(t, 4)}, {gv}, {rsrc}, {sreg} offen" + (f" offset:{li * 128}" if li else ""))
+    build_dag(nodes)
+    for s in stores:
+        for l in loads:
+            add_order(nodes, s, l)
+    apply_model()
+    out, _ = schedule(nodes, [i for i, n in enumerate(nodes) if n.kind == "WMMA"], "list")
+    return [n.text for n in out]
+
+
+FINAL_LAG = 8  # FINAL_PIPE: readback loads issued this many (load, store) pairs ahead of their global stores
+
+
+def region_final_pipe(L, ops):
+    """FINAL_PIPE: conversions in the order (V, kh = 0 .. NKV-1), (K, kh = 0 .. NKV-1) (ND_FOLD: dV * 1/scale), each
+    image store one conversion later (its cvt results are in by then); a group's readback rows rb = 4 kh .. 4 kh + 3
+    become loadable after its last image store (a wave's LDS ops are in order), one ds_load_b128 per conversion,
+    its buffer_store_b128 FINAL_LAG pairs later; the soffset of row block rb in one of 4 rotating SGPRs per image
+    (a store's SGPR is never redefined while it is in flight). asmkit derives the waits."""
+    convs = []  # (group, VALU texts, image store text)
+    pairs = {}  # group -> [(load text, store pre texts, store text)]
+    tmp = [L.O[i] for i in range(10)] + list(L.R0) + list(L.R1)
+    k = 0
+    for isk, x, n_d, base in ((0, XV, NDO_V, ops["ev"]), (1, XK, NDO_QK, ops["ek"])):
+        for kh in range(NKV):
+            for d in range(n_d):
+                a_ = L.dv(kh, d) if isk == 0 else L.dk(kh, d)
+                c = []
+                if ND_FOLD and isk == 0:  # dV' = dO^T P' = scale * dV
+                    c += [f"v_pk_mul_f32 {vr(a_ + 2 * q, 2)}, {vr(a_ + 2 * q, 2)}, {vr(L.ccs, 2)}" for q in range(4)]
+                c += [f"v_cvt_pk_bf16_f32 {vr(a_ + q)}, {vr(a_ + 2 * q)}, {vr(a_ + 2 * q + 1)}" for q in range(4)]
+                off = kh * 16 * x + d * 32
+                convs.append(((isk, kh), c, f"ds_store_b128 {base}, {vr(a_, 4)}" + (f" offset:{off}" if off else "")))
+            nli, rbase, gv, so, rs, rsrc = ((2, ops["rv"], ops["gv"], ops["sov"], ops["rsv"], ops["rdv"]),
+                                            (3, ops["rk"], ops["gk"], ops["sok"], ops["rsk"], ops["rdk"]))[isk]
+            sregs = ("s92", "s94", "s96", "s98") if isk == 0 else ("s93", "s95", "s97", "s99")
+            lst = []
+            for rb in range(4 * kh, 4 * kh + 4):
+                sr = sregs[rb % 4]
+                pre = [f"s_mov_b32 {sr}, {so}" if rb == 0 else f"s_add_co_i32 {sr}, {sregs[(rb - 1) % 4]}, {rs}"]
+                for li in range(nli):
+                    t = tmp[k % len(tmp)] + 4 * ((k // len(tmp)) % 2)
+                    k += 1
+                    off = rb * 4 * x + li * 128
+                    lst.append((f"ds_load_b128 {vr(t, 4)}, {rbase}" + (f" offset:{off}" if off else ""),
+                                pre if li == 0 else [],
+                                f"buffer_store_b128 {vr(t, 4)}, {gv}, {rsrc}, {sr} offen"
+                                + (f" offset:{li * 128}" if li else "")))  # fmt: skip
+            pairs[(isk, kh)] = lst
+    text, ready, flight = [], [], []
+
+    def step(final=False):
+        if ready:
+            ld, pre, st = ready.pop(0)
+            text.append(ld)
+            flight.append((pre, st))
+        if flight and (len(flight) > FINAL_LAG or final and not ready):
+            pre, st = flight.pop(0)
+            text.extend(pre + [st])
+
+    for i, (g, c, st) in enumerate(convs):
+        text.extend(c)
+        if i:
+            pg, _, pst = convs[i - 1]
+            text.append(pst)
+            if pg != g:  # group pg's last image store is out: its rows can be read back
+                ready.extend(pairs[pg])
+        step()
+    text.append(convs[-1][2])
+    ready.extend(pairs[convs[-1][0]])
+    while ready or flight:
+        step(final=True)
+    return text
+
+
+# --------------------------------------------------------------------------------------------------------------
+# the LOOP marker: the readback of tile 0, then the tile loop (unrolled by the ring depth) with its scalar work
+# --------------------------------------------------------------------------------------------------------------
+# generated SGPRs inside LOOP (the marker clobbers s48..s103)
+SG_G1 = ("s[48:55]", "s[56:63]", "s[64:71]")
+SG_G0 = (72, 76, 80)
+SG_K, SG_QT, SG_T1, SG_T2, SG_NLS = "s84", "s85", "s86", "s87", "s88"
+SG_SO = ("s89", "s90", "s91")
+SG_THR = "s92"
+SG_PT = ("s93", "s94", "s95")
+TDM_W0 = (0x7510000, 0x47510000, 0x87110000)
+TDM_W3 = (128 << 16, 128 << 16, 64 << 16)
+
+
+def _sv(op, i):
+    """Element i of an SGPR tuple operand text s[a:b]."""
+    import re
+
+    m = re.fullmatch(r"s\[(\d+):(\d+)\]", op)
+    if not m or int(m.group(1)) + i > int(m.group(2)):
+        raise ValueError(f"{op}: no element {i}")
+    return f"s{int(m.group(1)) + i}"
+
+
+def loop_ops(ops):
+    """The step bodies' operand names inside LOOP."""
+    o = dict(ops)
+    o.update({"g0a": f"s[{SG_G0[0]}:{SG_G0[0] + 3}]", "g0b": f"s[{SG_G0[1]}:{SG_G0[1] + 3}]",
+              "g0c": f"s[{SG_G0[2]}:{SG_G0[2] + 3}]", "g1a": SG_G1[0], "g1b": SG_G1[1], "g1c": SG_G1[2],
+              "nls": SG_NLS, "ds0": SG_SO[0], "ds1": SG_SO[1], "ds2": SG_SO[2], "thr": SG_THR, "pt0": SG_PT[0],
+              "pt1": SG_PT[1], "pt2": SG_PT[2]})  # fmt: skip
+    return o
+
+
+def loop_init(L, ops):
+    """Tile 0's hh0 operands and NL/ND (stage 0), k = 0, the TDM descriptors' constant words."""
+    tdm = ops["tdm"]
+    # NL/ND of tile 0 = query pair qp_start: soffset sc[2] (pair 0) + 128 qp_start
+    out = [f"s_lshl_b32 s98, {_sv(ops['sc'], 0)}, 7", f"s_add_co_i32 s98, {_sv(ops['sc'], 2)}, s98"]
+    out += [t for _, t in rb_texts(L, ops["lq"], ops["lv"], 0, L.op_hh0, 0)] + nl_texts(L, dict(ops, nls="s98"))
+    out.append(f"s_mov_b32 {SG_K}, 0")
+    for o in range(3):
+        g1 = int(SG_G1[o][2:].split(":")[0])
+        words = [hex(TDM_W0[o]), "0xffff0000", "0x107fff", hex(TDM_W3[o]), "16", _sv(tdm, 12 if o == 0 else 13), "0", "0"]
+        out += [f"s_mov_b32 s{g1 + i}, {w}" for i, w in enumerate(words)]
+        out.append(f"s_mov_b32 s{SG_G0[o]}, 1")
+    # the K / V fragments (INIT's 60 loads, older than tile 0's 8 NL / ND loads) complete before the loop: its blocks
+    # then see only NL / ND loads in flight (no per-step loadcnt waits for the fragments)
+    out.append("s_wait_loadcnt 0x8")
+    return out
+
+
+def loop_scalars(ops, stage, kofs=0):
+    """The per-tile scalars of tile k + kofs (k in SG_K) for a body in ring stage `stage`."""
+    tdm, sc, rc = ops["tdm"], ops["sc"], ops["rc"]
+    qps, nm1 = _sv(sc, 0), "s99"
+    out = [f"s_add_co_i32 {SG_QT}, {qps}, {SG_K}"] + ([f"s_add_co_i32 {SG_QT}, {SG_QT}, {kofs}"] if kofs else [])
+    out += [f"s_add_co_i32 {nm1}, {_sv(tdm, 14)}, -1",
+           f"s_add_co_i32 {SG_T1}, {SG_K}, {1 + kofs}", f"s_min_i32 {SG_T1}, {SG_T1}, {nm1}",
+           f"s_add_co_i32 {SG_T2}, {SG_K}, {2 + kofs}", f"s_min_i32 {SG_T2}, {SG_T2}, {nm1}",
+           f"s_add_co_i32 s98, {SG_T1}, {qps}", f"s_lshl_b32 s98, s98, 7", f"s_add_co_i32 {SG_NLS}, {_sv(sc, 2)}, s98"]  # fmt: skip
+    so_tdm = ((stage + 2) % DEPTH) * QDO_B
+    if TDM_DUMMY:  # tile k + kofs + 2 past the last: the three ops move 16 B each (words 3, 4: tile0 8, tile1 1)
+        out += [f"s_add_co_i32 s98, {SG_K}, {2 + kofs}",
+                f"s_cmp_ge_i32 s98, {_sv(ops['sc'], 7) if TDM_LIM_SC7 else _sv(tdm, 14)}",
+                f"s_mov_b32 s98, {hex(8 << 16)}"]  # one literal per SALU op (s_mov keeps scc)
+        for o in range(3):
+            g1 = int(SG_G1[o][2:].split(":")[0])
+            out += [f"s_cselect_b32 s{g1 + 3}, s98, {hex(TDM_W3[o])}", f"s_cselect_b32 s{g1 + 4}, 1, 16"]
+    for o in range(3):
+        g0 = SG_G0[o]
+        out += [f"s_mul_i32 s96, {SG_T2}, {_sv(tdm, 4 * o + 2)}", "s_mov_b32 s97, 0",
+                f"s_add_nc_u64 s[{g0 + 2}:{g0 + 3}], s[{int(_sv(tdm, 4 * o)[1:])}:{int(_sv(tdm, 4 * o)[1:]) + 1}], s[96:97]",
+                f"s_bitset1_b32 s{g0 + 3}, 31",
+                f"s_add_co_i32 s{g0 + 1}, {_sv(tdm, 4 * o + 3)}, {so_tdm}"]  # fmt: skip
+    out += [f"s_lshl_b32 s98, {SG_QT}, 10"]
+    for kh in range(NKV):
+        out.append(f"s_add_co_i32 {SG_SO[kh]}, s98, {_sv(rc, kh)}")
+    out += [f"s_lshl_b32 s98, {SG_QT}, 5", f"s_add_co_i32 {SG_THR}, s98, {_sv(sc, 3)}"]
+    for kh in range(NKV):
+        out += [f"s_cmp_ge_i32 {SG_QT}, {_sv(sc, 4 + kh)}", f"s_cselect_b32 {SG_PT[kh]}, 0, 0x40000000"]
+    return out
+
+
+def region_loop(L, ops, mode="list", probe=False, lp=".LHKG"):
+    """(init texts, blocks, model cycles): blocks = [(name, label, texts, internal successors)] in layout order; the
+    header is H0 (entered from the init code and by the back edge from N2); exits (k >= N) go to label {lp}_X."""
+    lo = loop_ops(ops)
+    tdm = ops["tdm"]
+    blocks, cyc = [], {}
+    if SCAL_IN_BODY:
+        # H0 U0 N0 H1 U1 N1 H2 U2 N2 M0 M1 M2: a full tile falls through header -> body -> counter; the bodies compute
+        # the next tile's scalars, so a header is only the masked / full branch
+        mblocks = []
+        for s in range(DEPTH):
+            blocks.append((f"H{s}", f"{lp}_H{s}", [f"s_cmp_lt_i32 {SG_K}, {_sv(tdm, 15)}", f"s_cbranch_scc1 {lp}_M{s}"],
+                           [f"U{s}", f"M{s}"]))  # fmt: skip
+            nxt = loop_scalars(ops, (s + 1) % DEPTH, 1)
+            tu, cyc[f"U{s}"] = region_step(L, lo, False, s, mode, probe, nxt)
+            blocks.append((f"U{s}", f"{lp}_U{s}", tu, [f"N{s}"]))
+            if s < DEPTH - 1:
+                blocks.append((f"N{s}", f"{lp}_N{s}", [f"s_add_co_i32 {SG_K}, {SG_K}, 1",
+                               f"s_cmp_ge_i32 {SG_K}, {_sv(tdm, 14)}", f"s_cbranch_scc1 {lp}_X"], ["X", f"H{s + 1}"]))  # fmt: skip
+            else:
+                blocks.append((f"N{s}", f"{lp}_N{s}", [f"s_add_co_i32 {SG_K}, {SG_K}, 1",
+                               f"s_cmp_lt_i32 {SG_K}, {_sv(tdm, 14)}", f"s_cbranch_scc1 {lp}_H0", f"s_branch {lp}_X"],
+                               ["H0", "X"]))  # fmt: skip
+            tm, cyc[f"M{s}"] = region_step(L, lo, True, s, mode, probe, nxt)
+            mblocks.append((f"M{s}", f"{lp}_M{s}", tm + [f"s_branch {lp}_N{s}"], [f"N{s}"]))
+        return loop_init(L, ops) + loop_scalars(ops, 0, 0), blocks + mblocks, cyc
+    for s in range(DEPTH):
+        hdr = []
+        if s == 0:
+            name_h = "H0"
+        else:
+            name_h = f"N{s - 1}"
+            hdr = [f"s_add_co_i32 {SG_K}, {SG_K}, 1", f"s_cmp_ge_i32 {SG_K}, {_sv(tdm, 14)}",
+                   f"s_cbranch_scc1 {lp}_X"]  # fmt: skip
+        sc_txt = loop_scalars(ops, s) + [f"s_cmp_lt_i32 {SG_K}, {_sv(tdm, 15)}", f"s_cbranch_scc1 {lp}_M{s}"]
+        if hdr:  # the exit test ends a block of its own
+            blocks.append((name_h, f"{lp}_N{s - 1}", hdr, ["X", f"H{s}"]))
+        blocks.append((f"H{s}", f"{lp}_H{s}", sc_txt, [f"U{s}", f"M{s}"]))
+        tu, cyc[f"U{s}"] = region_step(L, lo, False, s, mode, probe)
+        blocks.append((f"U{s}", f"{lp}_U{s}", tu + [f"s_branch {lp}_N{s}"], [f"N{s}"]))
+        tm, cyc[f"M{s}"] = region_step(L, lo, True, s, mode, probe)
+        blocks.append((f"M{s}", f"{lp}_M{s}", tm, [f"N{s}"]))
+    blocks.append(("N2", f"{lp}_N2", [f"s_add_co_i32 {SG_K}, {SG_K}, 1", f"s_cmp_lt_i32 {SG_K}, {_sv(tdm, 14)}",
+                                      f"s_cbranch_scc1 {lp}_H0"], ["H0", "X"]))  # fmt: skip
+    return loop_init(L, ops), blocks, cyc
diff -ruN a/r8gen/gen/shellbase.py b/r8gen/gen/shellbase.py
--- a/r8gen/gen/shellbase.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/gen/shellbase.py	2026-10-29 04:52:51.000000000 +0000
@@ -0,0 +1,49 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""shellbase -- the VGPRs the shell's code touches while generated state is live (between INIT and FINAL).
+
+The generated regions keep their state (accumulators, K / V fragments, operands) in VGPRs above `base` from the INIT
+marker to the FINAL marker. The shell may use any register elsewhere (the 64-row tail body, the epilogue after FINAL),
+but every shell instruction on a path from INIT to FINAL must stay below `base`, and so must every value live across a
+marker. shell_span() walks the CFG forward from the instruction after INIT, stops at FINAL, and returns the highest
+VGPR referenced on the way (marker bodies excluded) plus the line numbers it visited."""
+
+import re
+
+
+def shell_span(lines, ins, bl, init_i, final_i, marker_lines):
+    """(highest VGPR, visited instruction indices) of the shell code on every path INIT -> FINAL."""
+    block_of = {}
+    for b, (s, e, _) in enumerate(bl):
+        for i in range(s, e + 1):
+            block_of[i] = b
+    hi, seen_i, seen_b = -1, set(), set()
+    # start: the rest of INIT's block, then its successors
+    work = [(block_of[init_i], init_i + 1)]
+    while work:
+        b, start = work.pop()
+        s, e, succ = bl[b]
+        stop = False
+        for i in range(start, e + 1):
+            if i == final_i:
+                stop = True
+                break
+            if i in marker_lines:
+                continue
+            x = ins[i]
+            if not x.mn or x.cls in ("LABEL", "DIR"):
+                continue
+            seen_i.add(i)
+            for r in list(x.defs) + list(x.uses):
+                hi = max(hi, r)
+        if stop:
+            continue
+        for t in succ:
+            if t not in seen_b:
+                seen_b.add(t)
+                work.append((t, bl[t][0]))
+    return hi, seen_i
diff -ruN a/r8gen/hip/idx.h b/r8gen/hip/idx.h
--- a/r8gen/hip/idx.h	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/hip/idx.h	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,385 @@
+/***************************************************************************************************
+ * Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * See LICENSE for license information.
+ **************************************************************************************************/
+
+// idx.h -- every index / address formula of src/k_dkdv96.hip (bwd_hk_k3), as constexpr __host__
+// __device__ functions of scalars. The kernel calls exactly these; bounds_proof.py compiles this
+// file for the host (extern "C" wrappers, ctypes) and replays them over every launched shape.
+// Arithmetic widths follow FlyDSL's k_dkdv64 (bwd_r10_c kernels.py _dkdv_impl): i32 everywhere
+// except the TDM global element offsets (i64).
+//
+// Inherited from bwd_hk_k1 unchanged (the k1_* functions; the ring, TDM, readback, tr16, K/V
+// fragment and NL/ND math does not depend on the kv rows per wave). New for k3 (the k3_* functions
+// at the end): the 96-row block decode with 64-row tail blocks, the causal split of a block of
+// `rows` kv rows, and the per-wave epilogue images of nkv 16-row sub-tiles. k1's 64-row versions
+// (k1_kv0g, k1_kv0, k1_nmaskp, k1_epi_wr, k1_epi_rd) are kept: bounds_proof.py ties the k3
+// functions at rows 64 / nkv 2 to them.
+//
+// Names: lane in [0, 32), row = lane % 16, half = lane / 16; wave w in {0, 1} of a block of 32*nkv
+// kv rows owns kv rows kv0 = kv0g + 16*nkv*w; stage_off = s * K1_QDO_B (s in 0..2) is a byte offset
+// in the workgroup's LDS.
+#pragma once
+#include <stdint.h>
+#ifndef __host__
+#define __host__
+#endif
+#ifndef __device__
+#define __device__
+#endif
+#define K1_FN static inline constexpr __host__ __device__
+
+// ---- layout (single source; bounds_proof.py reads them through k1_const)
+// ---------------------------------
+#define K1_D_QK 192                        // q / k / dq / dk head dim
+#define K1_D_V 128                         // v / o / do / dv head dim
+#define K1_XK (K1_D_QK * 2 + 16)           // 400 B: padded LDS row of a Q tile / dK image
+#define K1_XV (K1_D_V * 2 + 16)            // 272 B: padded LDS row of a dO tile / dV image
+#define K1_QOFF (32 * K1_XV)               // 8704: Q tile offset inside a ring stage
+#define K1_QDO_B (32 * (K1_XV + K1_XK))    // 21504: one ring stage ([32][D_V] dO + [32][D_QK] Q)
+#define K1_DEPTH 3                         // ring stages
+#define K1_RING_B (K1_DEPTH * K1_QDO_B)    // 64512
+#define K1_EPI_DK (32 * K1_XV)             // 8704: dK image offset in a wave's epilogue area
+#define K1_EPI_W (32 * K1_XV + 32 * K1_XK) // 21504: one wave's dV + dK images
+#define K1_NW 2                            // waves per workgroup
+#define K1_LDS (K1_RING_B > K1_NW * K1_EPI_W ? K1_RING_B : K1_NW * K1_EPI_W) // 64512 B static LDS
+#define K1_TDM_ROWS 16               // rows per wave per TDM op (32-row tile, 2 waves)
+#define K1_TW 3                      // tensorcnt that retires all but the newest stage
+#define K1_NEG (-3.0e38f)            // masked logit (exp2 -> 0)
+#define K1_LOG2E 1.4426950408889634f // f32 0x3FB8AA3B
+
+K1_FN int k1_const(int which) {
+    return which == 0    ? K1_D_QK
+           : which == 1  ? K1_D_V
+           : which == 2  ? K1_XK
+           : which == 3  ? K1_XV
+           : which == 4  ? K1_QOFF
+           : which == 5  ? K1_QDO_B
+           : which == 6  ? K1_DEPTH
+           : which == 7  ? K1_RING_B
+           : which == 8  ? K1_EPI_DK
+           : which == 9  ? K1_EPI_W
+           : which == 10 ? K1_NW
+           : which == 11 ? K1_LDS
+           : which == 12 ? K1_TDM_ROWS
+           : which == 13 ? K1_TW
+                         : -1;
+}
+
+// ---- workgroup decode (head-group launch, bwd_r4_a): grid (HG, Skv/64, B*Hkv/HG)
+// ------------------------
+K1_FN int k1_hb(int bz, int bx, int HG) {
+    return bz * HG + bx;
+}
+K1_FN int k1_bat(int bz, int bx, int HG, int Hkv) {
+    return k1_hb(bz, bx, HG) / Hkv;
+}
+K1_FN int k1_hkv(int bz, int bx, int HG, int Hkv) {
+    return k1_hb(bz, bx, HG) - k1_bat(bz, bx, HG, Hkv) * Hkv;
+}
+K1_FN int k1_kv0g(int bid) {
+    return bid * 64;
+}
+K1_FN int k1_kv0(int bid, int wv) {
+    return bid * 64 + wv * 32;
+}
+
+// ---- causal split at workgroup level (bottom-right: query q sees kv <= q + cshift)
+// -----------------------
+K1_FN int k1_qp_start(int kv0g, int cshift, int causal) {
+    const int c  = kv0g - cshift;
+    const int qs = (c < 0 ? 0 : c) / 32;
+    return causal != 0 ? qs : 0;
+}
+K1_FN int k1_nmaskp(int kv0g, int cshift, int causal, int nqt) {
+    const int nqt2    = nqt / 2;
+    const int qs      = k1_qp_start(kv0g, cshift, causal);
+    const int u       = kv0g + 63 - cshift;
+    const int qsu     = (u + 31) / 32;
+    int       qsf     = u < 0 ? 0 : qsu;
+    qsf               = qsf < nqt2 ? qsf : nqt2;
+    int nm            = qsf - qs;
+    nm                = nm < 0 ? 0 : nm;
+    const int nqp_eff = nqt2 - qs;
+    nm                = nm < nqp_eff ? nm : nqp_eff;
+    return causal != 0 ? nm : 0;
+}
+K1_FN int k1_nqp_eff(int kv0g, int cshift, int causal, int nqt) {
+    return nqt / 2 - k1_qp_start(kv0g, cshift, causal);
+}
+
+// ---- division-free (query pair, q head) counters: flat ii = q*G + g
+// ---------------------------------------
+K1_FN int k1_wrap_q(int qc, int gc, int G) {
+    return gc + 1 < G ? qc : qc + 1;
+}
+K1_FN int k1_wrap_g(int qc, int gc, int G) {
+    return gc + 1 < G ? gc + 1 : 0;
+}
+K1_FN int k1_clampqt(int t, int nqt2) {
+    t = t < nqt2 ? t : nqt2 - 1;
+    return t < 0 ? 0 : t;
+}
+K1_FN int k1_ncur(int cur) {
+    return cur == 2 * K1_QDO_B ? 0 : cur + K1_QDO_B;
+}
+// full loop iteration ii (counters (qi, gh) == decomposition of ii) of n: the NL/ND prefetch tile
+// min(ii+1, n-1) and the TDM prefetch tile min(ii+3, n-1), as (q, g) relative to the loop's first
+// pair (every ternary below selects between already-computed locals, so clang emits selects, not
+// branches)
+K1_FN int k1_nx_q(int ii, int n, int qi, int gh, int G) {
+    const int qn = k1_wrap_q(qi, gh, G);
+    return ii + 1 < n ? qn : qi;
+}
+K1_FN int k1_nx_g(int ii, int n, int qi, int gh, int G) {
+    const int gn = k1_wrap_g(qi, gh, G);
+    return ii + 1 < n ? gn : gh;
+}
+K1_FN int k1_pf_q(int ii, int n, int qi, int gh, int G) {
+    const int qn = k1_wrap_q(qi, gh, G), gn = k1_wrap_g(qi, gh, G);
+    const int qj = ii + 1 < n ? qn : qi;
+    const int q2 = k1_wrap_q(qn, gn, G), g2 = k1_wrap_g(qn, gn, G);
+    const int q2c = ii + 2 < n ? q2 : qj;
+    const int q3  = k1_wrap_q(q2, g2, G);
+    return ii + 3 < n ? q3 : q2c;
+}
+K1_FN int k1_pf_g(int ii, int n, int qi, int gh, int G) {
+    const int qn = k1_wrap_q(qi, gh, G), gn = k1_wrap_g(qi, gh, G);
+    const int gj = ii + 1 < n ? gn : gh;
+    const int q2 = k1_wrap_q(qn, gn, G), g2 = k1_wrap_g(qn, gn, G);
+    const int g2c = ii + 2 < n ? g2 : gj;
+    const int g3  = k1_wrap_g(q2, g2, G);
+    return ii + 3 < n ? g3 : g2c;
+}
+// prologue tiles 1 and 2 of the full loop (n iterations): decomposition of min(j, n-1), j = 1, 2
+K1_FN int k1_pro_q(int j, int n, int G) {
+    const int q1w = k1_wrap_q(0, 0, G), g1w = k1_wrap_g(0, 0, G);
+    const int q1  = 1 < n ? q1w : 0;
+    const int q2w = k1_wrap_q(q1w, g1w, G);
+    const int q2  = 2 < n ? q2w : q1;
+    return j == 1 ? q1 : q2;
+}
+K1_FN int k1_pro_g(int j, int n, int G) {
+    const int q1w = k1_wrap_q(0, 0, G), g1w = k1_wrap_g(0, 0, G);
+    const int g1  = 1 < n ? g1w : 0;
+    const int g2w = k1_wrap_g(q1w, g1w, G);
+    const int g2  = 2 < n ? g2w : g1;
+    return j == 1 ? g1 : g2;
+}
+
+// ---- K / V fragments: vec8 (16-B) tile index of lane `lane`, kv sub-tile kh, k-step dt, piece u
+// --------- gfrag: lane (row, half) holds kv row kv0 + kh*16 + row, d = dt*32 + half*8 + [0, 8) (u
+// = 0) and dt*32 + 16 + half*8 + [0, 8) (u = 1). Byte offset = 16 * tile (i32), buffer extent nk_b
+// / nv_b.
+K1_FN int k1_kbase(int bat, int Skv, int Hkv, int hkv) {
+    return bat * Skv * (Hkv * (K1_D_QK / 8)) + hkv * (K1_D_QK / 8);
+}
+K1_FN int k1_vbase(int bat, int Skv, int Hkv, int hkv) {
+    return bat * Skv * (Hkv * (K1_D_V / 8)) + hkv * (K1_D_V / 8);
+}
+K1_FN int k1_kfrag(int kbase, int Hkv, int kv0, int kh, int dt, int u, int lane) {
+    return kbase + (kv0 + kh * 16 + lane % 16) * (Hkv * (K1_D_QK / 8)) + lane / 16 + dt * 4 + u * 2;
+}
+K1_FN int k1_vfrag(int vbase, int Hkv, int kv0, int kh, int dt, int u, int lane) {
+    return vbase + (kv0 + kh * 16 + lane % 16) * (Hkv * (K1_D_V / 8)) + lane / 16 + dt * 4 + u * 2;
+}
+K1_FN int k1_nk_b(int B, int Skv, int Hkv) {
+    return B * Skv * Hkv * (K1_D_QK * 2);
+}
+K1_FN int k1_nv_b(int B, int Skv, int Hkv) {
+    return B * Skv * Hkv * (K1_D_V * 2);
+}
+
+// ---- NL / ND (k_delta's -LOG2E*lse, -scale*delta, [B, Hq, Sq] fp32): 8 vec4 loads per (pair, q
+// head) ---- entry e = hh*4 + which*2 + u (which 0 = NL, 1 = ND): byte soff + hh*64 + u*16 (SGPR) +
+// 32*half (VGPR)
+K1_FN int k1_qh(int hkv, int G, int gh) {
+    return hkv * G + gh;
+}
+K1_FN int k1_nl_soff(int bat, int Hq, int qh, int Sq, int q0) {
+    return ((bat * Hq + qh) * Sq + q0) * 4;
+}
+K1_FN int k1_nl_sconst(int e) {
+    return (e / 4) * 64 + (e % 2) * 16;
+}
+K1_FN int k1_nl_voff(int lane) {
+    return (lane / 16) * 32;
+}
+K1_FN int k1_nl_b(int B, int Hq, int Sq) {
+    return B * Hq * Sq * 4;
+}
+
+// ---- TDM: one ring stage = op 0 dO [32][128] (stride 272 B), op 1 Q cols [0,128), op 2 Q cols
+// [128,192) (stride 400 B); wave w moves rows [16w, 16w+16) of every op (num_warps 2). Element
+// offsets are i64.
+K1_FN int k1_tdm_w(int op) {
+    return op == 2 ? 64 : 128;
+} // tile columns
+K1_FN int k1_tdm_d(int op) {
+    return op == 0 ? K1_D_V : K1_D_QK;
+} // tensor row length (elements)
+K1_FN int k1_tdm_c0(int op) {
+    return op == 2 ? 128 : 0;
+} // first column
+K1_FN int k1_tdm_xrow(int op) {
+    return op == 0 ? K1_XV : K1_XK;
+} // LDS row stride (bytes)
+K1_FN int k1_tdm_pad(int op) {
+    return (k1_tdm_xrow(op) - 2 * k1_tdm_w(op)) / 2;
+} // pad elements per row
+K1_FN int64_t k1_tdm_row0(int bat, int Sq, int q0, int Hq, int qh) {
+    return (int64_t) (bat * Sq + q0) * (int64_t) Hq + (int64_t) qh;
+}
+K1_FN int64_t k1_tdm_gelem(int bat, int Sq, int q0, int Hq, int qh, int op, int wv) {
+    return k1_tdm_row0(bat, Sq, q0, Hq, qh) * k1_tdm_d(op) + k1_tdm_c0(op) +
+           (int64_t) (wv % 2) * K1_TDM_ROWS * (int64_t) Hq * k1_tdm_d(op);
+}
+K1_FN int k1_tdm_stride(int Hq, int op) {
+    return Hq * k1_tdm_d(op);
+} // outer stride (elements)
+K1_FN int k1_tdm_lds(int stage_off, int op, int wv) {
+    return stage_off + (op == 0 ? 0 : K1_QOFF) + k1_tdm_c0(op) * 2 +
+           (wv % 2) * K1_TDM_ROWS * k1_tdm_xrow(op);
+}
+// outer-extent field: FlyDSL wrote max(Sq - q0 - 16w, 0); k1 writes the slice height K1_TDM_ROWS
+// (prebuilt descriptor; bounds_proof K1 proves FlyDSL's value >= 16 for every issued tile, so no
+// live row is clamped)
+K1_FN int k1_tdm_ext_fly(int Sq, int q0, int wv) {
+    const int e = Sq - q0 - (wv % 2) * K1_TDM_ROWS;
+    return e < 0 ? 0 : e;
+}
+K1_FN int k1_tdm_ext(void) {
+    return K1_TDM_ROWS;
+}
+// descriptor group 1 word 0: data size 2 B (1 << 16), pad enable (1 << 20), pad interval log2(w/2
+// dwords)-1
+// (<< 22), pad amount pad/2 dwords - 1 (<< 25) (HK tdm.cuh build_tdm_descriptor_2d == FlyDSL's
+// constants 0x07510000 / 0x47510000 / 0x87110000)
+K1_FN int k1_ilog2(int x) {
+    return x <= 1 ? 0 : 1 + k1_ilog2(x / 2);
+}
+K1_FN uint32_t k1_tdm_w0(int op) {
+    return (1u << 16) | (1u << 20) | ((uint32_t) (k1_ilog2(k1_tdm_w(op) / 2) - 1) << 22) |
+           ((uint32_t) (k1_tdm_pad(op) / 2 - 1) << 25);
+}
+
+// ---- LDS reads of a stage (address = stage_off + lane part + compile-time constant; the kernel
+// adds the constant to a per-iteration base pointer so it lands in the DS offset field)
+// ---------------------------- readback (ds_load_b128): entry hh*20 + isq?(dt*2+u):(12+dt*2+u);
+// lane (row, half) reads row hh*16 + row, bytes half*16 + dt*64 + u*32 of the Q (isq 1, dt < 6) or
+// dO (isq 0, dt < 4) tile
+K1_FN int k1_rd_lane(int isq, int lane) {
+    return (lane % 16) * (isq ? K1_XK : K1_XV) + (lane / 16) * 16;
+}
+K1_FN int k1_rd_const(int hh, int isq, int dt, int u) {
+    return (isq ? K1_QOFF : 0) + hh * 16 * (isq ? K1_XK : K1_XV) + dt * 64 + u * 32;
+}
+K1_FN int k1_rd(int stage_off, int hh, int isq, int dt, int u, int lane) {
+    return stage_off + k1_rd_lane(isq, lane) + k1_rd_const(hh, isq, dt, u);
+}
+// B-operand transposed reads (ds_load_tr16_b128): dtile d (dO d < 8, Q d < 12), piece p (rows +16p)
+K1_FN int k1_lane_r(int lane) {
+    return (lane / 16) * 8 + lane % 8;
+}
+K1_FN int k1_lane_c(int lane) {
+    return ((lane / 8) % 2) * 8;
+}
+K1_FN int k1_tr_lane(int isq, int lane) {
+    return k1_lane_r(lane) * (isq ? K1_XK : K1_XV) + k1_lane_c(lane) * 2;
+}
+K1_FN int k1_tr_const(int isq, int d, int p) {
+    return (isq ? K1_QOFF : 0) + d * 32 + p * 16 * (isq ? K1_XK : K1_XV);
+}
+K1_FN int k1_tr(int stage_off, int isq, int d, int p, int lane) {
+    return stage_off + k1_tr_lane(isq, lane) + k1_tr_const(isq, d, p);
+}
+
+// ---- epilogue (bwd_r9_a): per-wave row-major dV [32][D_V] (stride 272) at w*EPI_W, dK [32][D_QK]
+// (400) at w*EPI_W + EPI_DK; C fragment (kh, d) of lane (row, half) = kv row kh*16 + row, cols d*16
+// + half*8 + [0, 8)
+K1_FN int k1_epi_wr(int wv, int isk, int kh, int d, int lane) {
+    const int x = isk ? K1_XK : K1_XV;
+    return wv * K1_EPI_W + (isk ? K1_EPI_DK : 0) + (lane % 16) * x + (lane / 16) * 16 +
+           kh * 16 * x + d * 32;
+}
+// whole-line readback: lane l reads kv row 4rb + l/8, bytes li*128 + (l%8)*16 of the image
+K1_FN int k1_epi_rd(int wv, int isk, int rb, int li, int lane) {
+    const int x = isk ? K1_XK : K1_XV;
+    return wv * K1_EPI_W + (isk ? K1_EPI_DK : 0) + (lane / 8) * x + (lane % 8) * 16 + rb * 4 * x +
+           li * 128;
+}
+// its global store: vec8 index of (kv row kv0 + 4rb + l/8, d = li*64 + (l%8)*8) in dv / dk
+K1_FN int k1_epi_g(int bat, int Skv, int Hkv, int hkv, int kv0, int isk, int rb, int li, int lane) {
+    const int base = isk ? k1_kbase(bat, Skv, Hkv, hkv) : k1_vbase(bat, Skv, Hkv, hkv);
+    const int rs   = Hkv * ((isk ? K1_D_QK : K1_D_V) / 8);
+    return base + (kv0 + rb * 4 + lane / 8) * rs + lane % 8 + li * 8;
+}
+
+// ---- k3: 96-row kv blocks (2 waves x 48 rows, nkv 3) and 64-row tail blocks (the k1 body, nkv 2)
+// ---------- grid y = k3_nblk(Skv) blocks, ascending kv (longest first under bottom-right causal):
+// blocks [0, n96) are 96-row blocks at kv0g = 96*bid; the n64 tail blocks follow at 96*n96 + 64*j.
+// Skv % 96 == 0 -> no tail;
+// == 64 -> one 64-row tail (prod: 42 + 1); == 32 -> two 64-row tails (96*(n-1) + 128). Any other
+// Skv is refused (k3_ok == 0; impl._plan routes it to bwd_hk_k1's k_dkdv64).
+#define K3_NKV 3              // 16-row kv sub-tiles per wave in a 96-row block
+#define K3_ROWS (32 * K3_NKV) // 96 kv rows per block
+K1_FN int k3_n96(int Skv) {
+    const int n = Skv / K3_ROWS, r = Skv % K3_ROWS;
+    return r == 32 ? n - 1 : n;
+}
+K1_FN int k3_n64(int Skv) {
+    const int r = Skv % K3_ROWS;
+    return r == 0 ? 0 : r == 64 ? 1 : r == 32 ? 2 : -1;
+}
+K1_FN int k3_ok(int Skv) {
+    return (Skv > 0 && k3_n64(Skv) >= 0 && k3_n96(Skv) >= 0) ? 1 : 0;
+}
+K1_FN int k3_nblk(int Skv) {
+    return k3_n96(Skv) + k3_n64(Skv);
+}
+K1_FN int k3_kv0g(int bid, int n96) {
+    return bid < n96 ? bid * K3_ROWS : n96 * K3_ROWS + (bid - n96) * 64;
+}
+K1_FN int k3_rows(int bid, int n96) {
+    return bid < n96 ? K3_ROWS : 64;
+}
+K1_FN int k3_kv0(int kv0g, int wv, int nkv) {
+    return kv0g + wv * 16 * nkv;
+}
+// causal split of a block of `rows` kv rows at kv0g (k1_nmaskp with 63 -> rows - 1; qp_start /
+// nqp_eff do not depend on the block height: k1_qp_start / k1_nqp_eff)
+K1_FN int k3_nmaskp(int kv0g, int rows, int cshift, int causal, int nqt) {
+    const int nqt2    = nqt / 2;
+    const int qs      = k1_qp_start(kv0g, cshift, causal);
+    const int u       = kv0g + rows - 1 - cshift;
+    const int qsu     = (u + 31) / 32;
+    int       qsf     = u < 0 ? 0 : qsu;
+    qsf               = qsf < nqt2 ? qsf : nqt2;
+    int nm            = qsf - qs;
+    nm                = nm < 0 ? 0 : nm;
+    const int nqp_eff = nqt2 - qs;
+    nm                = nm < nqp_eff ? nm : nqp_eff;
+    return causal != 0 ? nm : 0;
+}
+// epilogue images of a wave with nkv sub-tiles: row-major dV [16 nkv][D_V] (stride 272) at
+// w*EPI_W(nkv), dK [16 nkv][D_QK] (400) at w*EPI_W + EPI_DK; nkv 3: 2 x 32256 = 64512 B = the ring
+// allocation (K1_LDS)
+K1_FN int k3_epi_dk(int nkv) {
+    return 16 * nkv * K1_XV;
+}
+K1_FN int k3_epi_w(int nkv) {
+    return 16 * nkv * (K1_XV + K1_XK);
+}
+K1_FN int k3_epi_wr(int nkv, int wv, int isk, int kh, int d, int lane) {
+    const int x = isk ? K1_XK : K1_XV;
+    return wv * k3_epi_w(nkv) + (isk ? k3_epi_dk(nkv) : 0) + (lane % 16) * x + (lane / 16) * 16 +
+           kh * 16 * x + d * 32;
+}
+// whole-line readback: lane l reads kv row 4rb + l/8 (rb in [0, 4 nkv)), bytes li*128 + (l%8)*16 of
+// the image; its global store is k1_epi_g (kv row kv0 + 4rb + l/8)
+K1_FN int k3_epi_rd(int nkv, int wv, int isk, int rb, int li, int lane) {
+    const int x = isk ? K1_XK : K1_XV;
+    return wv * k3_epi_w(nkv) + (isk ? k3_epi_dk(nkv) : 0) + (lane / 8) * x + (lane % 8) * 16 +
+           rb * 4 * x + li * 128;
+}
diff -ruN a/r8gen/hip/include/cdna5/common/base_ops.cuh b/r8gen/hip/include/cdna5/common/base_ops.cuh
--- a/r8gen/hip/include/cdna5/common/base_ops.cuh	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/hip/include/cdna5/common/base_ops.cuh	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,449 @@
+/**
+ * @file
+ * @brief Basic operations on generic types.
+ */
+
+#pragma once
+
+#include <limits>
+#include "base_types.cuh"
+
+namespace kittens {
+
+/**
+ * @namespace base_ops
+ *
+ * @brief A namespace for operations on basic data types.
+ */
+namespace base_ops {
+
+/* ----------  CONST OPS  ---------- */
+
+/**
+ * @brief Represents the zero constant operation.
+ *
+ * This operation returns the zero value of the specified type.
+ *
+ * @tparam T The data type for which to return the zero value.
+ * @return The zero value of type T.
+ */
+struct zero {
+    template<typename T, typename... args> __device__ static inline constexpr T op(args... _) { return base_types::constants<T>::zero();      }
+};
+/**
+ * @brief Represents the ones constant operation.
+ *
+ * This operation returns the ones value of the specified type.
+ *
+ * @tparam T The data type for which to return the ones value.
+ * @return The ones value of type T.
+ */
+struct ones {
+    template<typename T, typename... args> __device__ static inline constexpr T op(args... _) { return base_types::constants<T>::ones();       }
+};
+/**
+ * @brief Represents the positive infinity constant operation.
+ *
+ * This operation returns the positive infinity value of the specified type.
+ *
+ * @tparam T The data type for which to return the positive infinity value.
+ * @return The positive infinity value of type T.
+ */
+struct pos_infty {
+    template<typename T, typename... args> __device__ static inline constexpr T op(args... _) { return base_types::constants<T>::pos_infty(); }
+};
+/**
+ * @brief Represents the negative infinity constant operation.
+ *
+ * This operation returns the negative infinity value of the specified type.
+ *
+ * @tparam T The data type for which to return the negative infinity value.
+ * @return The negative infinity value of type T.
+ */
+struct neg_infty {
+    template<typename T, typename... args> __device__ static inline constexpr T op(args... _) { return base_types::constants<T>::neg_infty(); }
+};
+
+
+/* ----------  UNARY OPS  ---------- */
+
+/**
+ * @brief Exponential function operation.
+ *
+ * This operation calculates the exponential of the input value.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The exponential of the input value.
+ */
+struct exp {
+    template<typename T> static __device__ inline T op(const T &x) { return exp(x); }
+};
+template<> __device__ inline float  exp::op<float> (const float &x ) { return __expf(x);                        }
+template<> __device__ inline float2 exp::op<float2>(const float2 &x) { return float2{__expf(x.x), __expf(x.y)}; }
+template<> __device__ inline bf16   exp::op<bf16>  (const bf16 &x  ) { return hexp(x);                          }
+template<> __device__ inline bf16_2 exp::op<bf16_2>(const bf16_2 &x) { return h2exp(x);                         }
+template<> __device__ inline half   exp::op<half>  (const half &x  ) { return hexp(x);                          }
+template<> __device__ inline half_2 exp::op<half_2>(const half_2 &x) { return h2exp(x);                         }
+
+// /**
+//  * @brief Exponential function operation, in base 2
+//  *
+//  * This operation calculates the exponential of the input value, in base 2.
+//  *
+//  * @tparam T The data type of the input and output values.
+//  * @param x[in] The input value.
+//  * @return The exponential of the input value.
+//  */
+// struct exp2 {
+//     template<typename T> static __device__ inline T op(const T &x) { return exp2f(x); }
+// };
+// template<> __device__ inline float  exp2::op<float> (const float &x ) { return exp2f(x);                        }
+// template<> __device__ inline float2 exp2::op<float2>(const float2 &x) { return float2{exp2f(x.x), exp2f(x.y)}; }
+// template<> __device__ inline bf16   exp2::op<bf16>  (const bf16 &x  ) { return hexp2(x);                          }
+// template<> __device__ inline bf16_2 exp2::op<bf16_2>(const bf16_2 &x) { return h2exp2(x);                         }
+// template<> __device__ inline half   exp2::op<half>  (const half &x  ) { return hexp2(x);                          }
+// template<> __device__ inline half_2 exp2::op<half_2>(const half_2 &x) { return h2exp2(x);                         }
+
+
+/**
+ * @brief Base-2 exponential operation using `__builtin_amdgcn_exp2_f32`
+ *
+ * Maps directly to `v_exp_f32_e32` on AMD, for highest performance.
+ * Expects `x` to be in a safe numerical range (e.g., [-64, 88]).
+ */
+ struct exp2 {
+    template <typename T>
+    static __device__ inline T op(const T &x) {
+        return exp2f(x);  // fallback
+    }
+};
+
+// Force hardware v_exp_f32 for float
+template<>
+__device__ inline float exp2::op<float>(const float &x) {
+    return __builtin_amdgcn_exp2f(x);  // Emits v_exp_f32_e32
+}
+
+// Force hardware v_exp_f32 for float2
+template<>
+__device__ inline float2 exp2::op<float2>(const float2 &x) {
+    return {
+        __builtin_amdgcn_exp2f(x.x),
+        __builtin_amdgcn_exp2f(x.y)
+    };
+}
+
+// Delegate to low-precision approximations
+template<> __device__ inline half    exp2::op<half>(const half &x)     { return hexp2(x);  }
+template<> __device__ inline half_2  exp2::op<half_2>(const half_2 &x) { return h2exp2(x); }
+template<> __device__ inline bf16    exp2::op<bf16>(const bf16 &x)     { return hexp2(x);  }
+template<> __device__ inline bf16_2  exp2::op<bf16_2>(const bf16_2 &x) { return h2exp2(x); }
+
+
+
+/**
+ * @brief Natural log function operation.
+ *
+ * This operation calculates the natural logarithm of the input value.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The natural logarithm of the input value.
+ */
+struct log {
+    template<typename T> static __device__ inline T op(const T &x) { return log(x); }
+};
+template<> __device__ inline float  log::op<float> (const float &x ) { return __logf(x);                        }
+template<> __device__ inline float2 log::op<float2>(const float2 &x) { return float2{__logf(x.x), __logf(x.y)}; }
+template<> __device__ inline bf16   log::op<bf16>  (const bf16 &x  ) { return hlog(x);                          }
+template<> __device__ inline bf16_2 log::op<bf16_2>(const bf16_2 &x) { return h2log(x);                         }
+template<> __device__ inline half   log::op<half>  (const half &x  ) { return hlog(x);                          }
+template<> __device__ inline half_2 log::op<half_2>(const half_2 &x) { return h2log(x);                         }
+/**
+ * @brief Logarithm base 2 operation.
+ *
+ * This operation calculates the logarithm base 2 of the input value.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The logarithm base 2 of the input value.
+ */
+struct log2 {
+    template<typename T> static __device__ inline T op(const T &x) { return log2(x); }
+};
+template<> __device__ inline float  log2::op<float> (const float &x ) { return __log2f(x);                        }
+template<> __device__ inline float2 log2::op<float2>(const float2 &x) { return float2{__log2f(x.x), __log2f(x.y)}; }
+template<> __device__ inline bf16   log2::op<bf16>  (const bf16 &x  ) { return hlog2(x);                          }
+template<> __device__ inline bf16_2 log2::op<bf16_2>(const bf16_2 &x) { return h2log2(x);                         }
+template<> __device__ inline half   log2::op<half>  (const half &x  ) { return hlog2(x);                          }
+template<> __device__ inline half_2 log2::op<half_2>(const half_2 &x) { return h2log2(x);                         }
+/**
+ * @brief Absolute value operation.
+ *
+ * This operation calculates the absolute value of the input.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The absolute value of the input.
+ */
+struct abs {
+    template<typename T> static __device__ inline T op(const T &x) { return abs(x); }
+};
+template<> __device__ inline float  abs::op<float> (const float &x ) { return fabsf(x);                       }
+template<> __device__ inline float2 abs::op<float2>(const float2 &x) { return float2{fabsf(x.x), fabsf(x.y)}; }
+template<> __device__ inline bf16   abs::op<bf16>  (const bf16 &x  ) { return __habs(x);                      }
+template<> __device__ inline bf16_2 abs::op<bf16_2>(const bf16_2 &x) { return __habs2(x);                     }
+template<> __device__ inline half   abs::op<half>  (const half &x  ) { return __habs(x);                      }
+template<> __device__ inline half_2 abs::op<half_2>(const half_2 &x) { return __habs2(x);                     }
+/**
+ * @brief Rectified Linear Unit (ReLU) operation.
+ *
+ * This operation applies the ReLU function to the input, which is the
+ * maximum of zero and the input value.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The result of ReLU function applied to the input.
+ */
+struct relu {
+    template<typename T> static __device__ inline T op(const T &x) { return max(x, base_types::constants<T>::zero()); }
+};
+template<> __device__ inline float  relu::op<float> (const float &x ) { return max(x, 0.f);                                  }
+template<> __device__ inline float2 relu::op<float2>(const float2 &x) { return float2{max(x.x, 0.f), max(x.y, 0.f)};         }
+template<> __device__ inline bf16   relu::op<bf16>  (const bf16 &x  ) { return __hmax(x, base_types::constants<bf16>::zero());    }
+template<> __device__ inline bf16_2 relu::op<bf16_2>(const bf16_2 &x) { return __hmax2(x, base_types::constants<bf16_2>::zero()); }
+template<> __device__ inline half   relu::op<half>  (const half &x  ) { return __hmax(x, base_types::constants<half>::zero());    }
+template<> __device__ inline half_2 relu::op<half_2>(const half_2 &x) { return half_2{__hmax(x.x, base_types::constants<half>::zero()), 
+                                                                                     __hmax(x.y, base_types::constants<half>::zero())}; }
+
+
+constexpr float SQRT_2_OVER_PI   = 0.7978845608028654f;
+constexpr float GELU_COEFF       = 0.044715f;
+constexpr float GELU_INNER_COEFF = GELU_COEFF * SQRT_2_OVER_PI;
+constexpr float DGELU_COEFF      = 3.0f * GELU_COEFF * SQRT_2_OVER_PI;
+
+static __device__ inline float fast_tanh(float x) {
+    x = fmaxf(fminf(x, 20.f), -20.f);
+    float e2x = __builtin_amdgcn_exp2f(x * 2.8853900817779268f);
+    return (e2x - 1.0f) * __frcp_rn(e2x + 1.0f);
+}
+
+/**
+ * @brief Gaussian Error Linear Unit (GELU) activation.
+ *
+ * Computes the GELU approximation: x * 0.5 * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3))).
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The GELU activation applied to the input.
+ */
+struct gelu {
+    template<typename T> static __device__ inline T op(const T &x);
+};
+template<> __device__ inline float gelu::op<float>(const float &x) {
+    return x * (0.5f + 0.5f * fast_tanh(x * (SQRT_2_OVER_PI + GELU_INNER_COEFF * x * x)));
+}
+template<> __device__ inline float2 gelu::op<float2>(const float2 &x) {
+    return float2{gelu::op<float>(x.x), gelu::op<float>(x.y)};
+}
+
+/**
+ * @brief Derivative of the GELU activation.
+ *
+ * Computes the derivative of the GELU approximation with respect to the input.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param x[in] The input value.
+ * @return The derivative of GELU evaluated at the input.
+ */
+struct dgelu {
+    template<typename T> static __device__ inline T op(const T &x);
+};
+template<> __device__ inline float dgelu::op<float>(const float &x) {
+    float tanh_out = fast_tanh(SQRT_2_OVER_PI * x * (1.f + GELU_COEFF * x * x));
+    return 0.5f * x * ((1.f - tanh_out * tanh_out) * (SQRT_2_OVER_PI + DGELU_COEFF * x * x)) +
+           0.5f * (1.f + tanh_out);
+}
+template<> __device__ inline float2 dgelu::op<float2>(const float2 &x) {
+    return float2{dgelu::op<float>(x.x), dgelu::op<float>(x.y)};
+}
+
+/**
+ * @brief Copy operation.
+ *
+ * This operation returns the input value unchanged.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The input value.
+ * @return The same value as the input.
+ */
+struct copy { // for non-compile-time setters.
+    template<typename T> static __device__ inline T op(const T &a) { return a; }
+};
+
+
+/* ----------  BINARY OPS  ---------- */
+
+/**
+ * @brief Copy2 operation.
+ *
+ * This operation returns the second input value unchanged.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value (ignored).
+ * @param b[in] The second input value.
+ * @return The same value as the second input.
+ */
+struct copy2 { // this turns out to be a slightly hacky op that makes some code cleaner :/
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return b; }
+};
+/**
+ * @brief Sum operation.
+ *
+ * This operation calculates the sum of two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The sum of the input values.
+ */
+struct sum {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return a+b; }
+};
+template<> __device__ inline float2 sum::op<float2>(const float2 &a, const float2 &b) { return float2{a.x+b.x, a.y+b.y}; }
+template<> __device__ inline bf16   sum::op<bf16>  (const bf16   &a, const bf16   &b) { return __hadd(a, b);             }
+template<> __device__ inline bf16_2 sum::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __hadd2(a, b);            }
+template<> __device__ inline half   sum::op<half>  (const half   &a, const half   &b) { return __hadd(a, b);             }
+template<> __device__ inline half_2 sum::op<half_2>(const half_2 &a, const half_2 &b) { return __hadd2(a, b);            }
+/**
+ * @brief Subtraction operation.
+ *
+ * This operation calculates the difference between two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The difference between the input values.
+ */
+struct sub {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return a-b; }
+};
+template<> __device__ inline float2 sub::op<float2>(const float2 &a, const float2 &b) { return float2{a.x-b.x, a.y-b.y}; }
+template<> __device__ inline bf16   sub::op<bf16>  (const bf16   &a, const bf16   &b) { return __hsub(a, b);             }
+template<> __device__ inline bf16_2 sub::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __hsub2(a, b);            }
+template<> __device__ inline half   sub::op<half>  (const half   &a, const half   &b) { return __hsub(a, b);             }
+template<> __device__ inline half_2 sub::op<half_2>(const half_2 &a, const half_2 &b) { return __hsub2(a, b);            }
+/**
+ * @brief Multiplication operation.
+ *
+ * This operation calculates the product of two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The product of the input values.
+ */
+struct mul {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return a*b; }
+};
+template<> __device__ inline float2 mul::op<float2>(const float2 &a, const float2 &b) { return float2{a.x*b.x, a.y*b.y}; }
+template<> __device__ inline bf16   mul::op<bf16>  (const bf16   &a, const bf16   &b) { return __hmul(a, b);             }
+template<> __device__ inline bf16_2 mul::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __hmul2(a, b);            }
+template<> __device__ inline half   mul::op<half>  (const half   &a, const half   &b) { return __hmul(a, b);             }
+template<> __device__ inline half_2 mul::op<half_2>(const half_2 &a, const half_2 &b) { return __hmul2(a, b);            }
+/**
+ * @brief Division operation.
+ *
+ * This operation calculates the quotient of two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The quotient of the input values.
+ */
+struct div {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return a/b; }
+};
+template<> __device__ inline float2 div::op<float2>(const float2 &a, const float2 &b) { return float2{a.x/b.x, a.y/b.y}; }
+template<> __device__ inline bf16   div::op<bf16>  (const bf16   &a, const bf16   &b) { return __hdiv(a, b);             }
+template<> __device__ inline bf16_2 div::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __h2div(a, b);            } // this op is a special snowflake
+template<> __device__ inline half   div::op<half>  (const half   &a, const half   &b) { return __hdiv(a, b);             }
+template<> __device__ inline half_2 div::op<half_2>(const half_2 &a, const half_2 &b) { return __h2div(a, b);            }
+/**
+ * @brief Maximum operation.
+ *
+ * This operation calculates the maximum of two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The maximum of the input values.
+ */
+ struct max {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return ::max(a, b); }
+};
+template<>  __device__ inline float2 max::op<float2>(const float2 &a, const float2 &b) { return float2{::max(a.x, b.x), ::max(a.y, b.y)};  }
+template<>  __device__ inline bf16   max::op<bf16>  (const bf16   &a, const bf16   &b) { return __hmax(a, b);                              }
+template<>  __device__ inline bf16_2 max::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __hmax2(a, b);                             }
+template<>  __device__ inline half   max::op<half>  (const half   &a, const half   &b) { return __hmax(a, b);                              }
+template<>  __device__ inline half_2 max::op<half_2>(const half_2 &a, const half_2 &b) { return half_2{__hmax(a.x, b.x), __hmax(a.y, b.y)}; }
+/**
+ * @brief Minimum operation.
+ *
+ * This operation calculates the minimum of two input values.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @return The minimum of the input values.
+ */
+struct min {
+    template<typename T> static __device__ inline T op(const T &a, const T &b) { return ::min(a, b); }
+};
+template<>  __device__ inline float2 min::op<float2>(const float2 &a, const float2 &b) { return float2{::min(a.x, b.x), ::min(a.y, b.y)};   }
+template<>  __device__ inline bf16   min::op<bf16>  (const bf16   &a, const bf16   &b) { return __hmin(a, b);                               }
+template<>  __device__ inline bf16_2 min::op<bf16_2>(const bf16_2 &a, const bf16_2 &b) { return __hmin2(a, b);                              }
+template<>  __device__ inline half   min::op<half>  (const half   &a, const half   &b) { return __hmin(a, b);                               }
+template<>  __device__ inline half_2 min::op<half_2>(const half_2 &a, const half_2 &b) { return half_2{__hmin(a.x, b.x), __hmin(a.y, b.y)};  }
+
+
+/* ----------  TERNARY OPS  ---------- */
+
+/**
+ * @brief Fused multiply-add operation A * B + C.
+ *
+ * This operation performs a fused multiply-add, computing (A * B) + C with only one rounding.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The second input value.
+ * @param c[in] The third input value to be added.
+ * @return The result of the fused multiply-add operation.
+ */
+struct fma_AxBtC {
+    template<typename T> static __device__ inline T op(const T &a, const T &b, const T &c) {
+        return sum::op<T>(mul::op<T>(a, b), c);
+    }
+};
+/**
+ * @brief Fused multiply-add operation A * C + B.
+ *
+ * This operation performs a fused multiply-add, computing (A * C) + B with only one rounding.
+ * This is particularly useful for attention mechanisms in neural networks.
+ *
+ * @tparam T The data type of the input and output values.
+ * @param a[in] The first input value.
+ * @param b[in] The third input value to be added.
+ * @param c[in] The second input value.
+ * @return The result of the fused multiply-add operation.
+ */
+struct fma_AxCtB { // this is the one needed for attention
+    template<typename T> static __device__ inline T op(const T &a, const T &b, const T &c) {
+        return sum::op<T>(mul::op<T>(a, c), b);
+    }
+};
+
+} // namespace base_ops
+
+} // namespace kittens
