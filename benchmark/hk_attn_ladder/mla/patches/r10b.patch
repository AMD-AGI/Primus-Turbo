--- a/r8gen/asmkit/__main__.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/asmkit/__main__.py	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,136 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""asmkit command line.
+
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit loops    K.s
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit map      K.s [--label L | --nwmma N] [--out map.json]
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit identity K.s OUT.s [--label L | --nwmma N] [--no-expert]
+                                                                 [--entry both|cfg|preheader]
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit generate K.s GEN.s OUT.s [--label L | --nwmma N] [...]
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit build    IN.s OUT.hsaco --main-file-name F.hip [--mllvm X ...]
+    PYTHONPATH=primus_turbo/hipkittens python -m asmkit verify-obj INTENDED.s OBJDUMP.s
+
+identity / generate exit 1 when a static check fails (the text is written anyway, for inspection).
+--entry: how the state at the loop header is modelled: 'cfg' = exact dataflow from the kernel entry (LLVM's view),
+'preheader' = the preheader block from an unknown state (the original AO model, blind to older VMEM loads),
+'both' (default) = every wait satisfies both.
+"""
+
+import argparse
+import json
+import shlex
+import sys
+
+from . import build, splice, verify_obj
+from .isa import read_lines
+
+
+def _region_args(ap):
+    ap.add_argument("--label", default=None, help="header label of the shell loop")
+    ap.add_argument("--nwmma", type=int, default=None, help="WMMA count of the shell loop")
+    ap.add_argument("--func", default=None, help="kernel function name (default: the first)")
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(prog="asmkit", description=__doc__.splitlines()[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("loops")
+    p.add_argument("s")
+    p.add_argument("--func", default=None)
+    p = sub.add_parser("map")
+    p.add_argument("s")
+    _region_args(p)
+    p.add_argument("--out", default=None)
+    for name in ("identity", "generate"):
+        p = sub.add_parser(name)
+        p.add_argument("s")
+        if name == "generate":
+            p.add_argument("gen", help="the generated region text (labels + instructions)")
+        p.add_argument("out")
+        _region_args(p)
+        p.add_argument("--no-expert", action="store_true", help="the kernel is not in expert scheduling mode")
+        p.add_argument("--entry", default="both", choices=("both", "cfg", "preheader"))
+        p.add_argument("--map", default=None, help="also write the entry register map (JSON)")
+    p = sub.add_parser("build")
+    p.add_argument("s")
+    p.add_argument("out")
+    p.add_argument("--main-file-name", required=True)
+    p.add_argument("--mllvm", action="append", default=[], help="an -mllvm option of the kernel's compile")
+    p.add_argument("--llvm-bin", default=None, help="directory of clang / lld (default: next to amdclang++)")
+    p.add_argument(
+        "--compile-cmd", default=None, help="the kernel's compile command (shell words); its -### steps"
+    )
+    p.add_argument("--cwd", default=".")
+    p = sub.add_parser("verify-obj")
+    p.add_argument("intended")
+    p.add_argument("objdump")
+    a = ap.parse_args(argv)
+
+    if a.cmd == "loops":
+        for lab, h, mem, lat, nw in splice.loops_summary(a.s, a.func):
+            print(
+                f"{lab}: header block {h}, blocks {mem[0]}..{mem[-1]} ({len(mem)}), latches {lat}, {nw} WMMA"
+            )
+        return 0
+    if a.cmd == "map":
+        r = splice.find_shell(a.s, label=a.label, nwmma=a.nwmma, func=a.func)
+        m = splice.entry_map(r)
+        text = json.dumps(m, indent=1)
+        if a.out:
+            open(a.out, "w").write(text + "\n")
+            print(
+                f"{r.describe()}\n  live-in VGPRs {m['vgpr_live_in_count']}, free {m['vgpr_free_count']}, "
+                f"scalar live-in {len(m['scalar_live_in'])} -> {a.out}"
+            )
+        else:
+            print(text)
+        return 0
+    if a.cmd in ("identity", "generate"):
+        expert = not a.no_expert
+        shell = splice.find_shell(a.s, label=a.label, nwmma=a.nwmma, func=a.func)
+        if a.cmd == "identity":
+            new = splice.rebuild(shell, expert=expert, entry=a.entry)
+        else:
+            new = splice.generate(shell, read_lines(a.gen), expert=expert, entry=a.entry)
+        open(a.out, "w").write("\n".join(new) + "\n")
+        fail, st = splice.check(shell, new, func=a.func, expert=expert, entry="both")
+        print(f"{shell.describe()}\n  {a.cmd} -> {a.out}: {'PASS' if not fail else 'FAIL'} {st}")
+        for f in fail:
+            print("   ", f)
+        if a.map:
+            open(a.map, "w").write(json.dumps(splice.entry_map(shell), indent=1) + "\n")
+        return 1 if fail else 0
+    if a.cmd == "build":
+        if a.compile_cmd:
+            cc1as, lld = build.driver_steps(shlex.split(a.compile_cmd), a.cwd)
+        else:
+            import shutil
+            from pathlib import Path
+
+            llvm_bin = a.llvm_bin
+            if llvm_bin is None:
+                cxx = shutil.which("amdclang++")
+                if cxx is None:
+                    print("amdclang++ not found: pass --llvm-bin", file=sys.stderr)
+                    return 2
+                llvm_bin = str(Path(cxx).resolve().parent.parent / "lib" / "llvm" / "bin")
+                if not Path(llvm_bin, "lld").exists():
+                    llvm_bin = str(Path(cxx).resolve().parent)
+            cc1as, lld = build.default_steps(llvm_bin, a.main_file_name, a.mllvm, a.cwd)
+        meta = build.assemble(a.s, a.out, cc1as, lld, cwd=a.cwd)
+        print(json.dumps(meta))
+        return 0
+    if a.cmd == "verify-obj":
+        bad = verify_obj.compare(a.intended, a.objdump)
+        for t in bad:
+            print("  ", t)
+        return 1 if bad else 0
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN a/r8gen/asmkit/README.md b/r8gen/asmkit/README.md
--- a/r8gen/asmkit/README.md	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/asmkit/README.md	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,47 @@
+# asmkit: gfx1250 assembly backend for spliced hot loops
+
+`asmkit` turns a hot loop given as "real instructions in their final order" into assembly that is valid on gfx1250,
+splices it into a kernel that the compiler built (the *shell*), assembles it exactly as the clang driver does, and
+checks that the code object holds what was intended. It is the backend that the dK/dV loop generator, the forward
+hot-loop generator and the AO list scheduler share. Standard library only.
+
+| module | what it does |
+|---|---|
+| `isa.py` | `.s` / `llvm-objdump` text model. It keeps the true VGPR numbers (0..1023, from the `/*vN*/` comments), the VGPR and scalar defs / uses (with `s[a:b]` ranges, vcc / exec / m0 / scc), and the instruction classes. It also finds loops and functions, and checks parse coverage: every register token of a line must be in its defs / uses. |
+| `expert.py` | Expert-scheduling-mode in-flight model: `va_vdst` (LLVM rule), `vm_vsrc`, dscnt / loadcnt / storecnt / tensorcnt. Also the CFG, VGPR and scalar liveness, and a conservative state join. |
+| `emit.py` | Re-derives the *derived* lines for a given order: `s_set_vgpr_msb` (field map learned from the compiler's output, VOPD by position), expert waits, `s_wait_xcnt`, hazard `v_nop` (WMMA→WMMA A/B 5, WMMA→VALU 4, TRANS→VALU 1), and WMMA reuse flags. It works over a multi-block loop region: waits are the minimum over every path (entry and back edges, iterated to a fixed point). Fence waits (`tensorcnt`, `kmcnt`, waits before `s_barrier_signal`) stay where they are. |
+| `splice.py` | Finds the shell loop (a natural loop; it may have rare-path blocks and a rotated latch) and builds its **entry register map**: live-in VGPR tuples with their roles (WMMA A / B / C, DS / VMEM address or data), scalar live-ins (buffer resource, TDM descriptor, loop-carried counter), live-outs at each exit, free VGPRs, and what is in flight at entry. It also does the identity rebuild (`rebuild`), splices generated code (`generate`), and runs the static check (`check`): no hazard left open inside the region on any path, and no new hazard after any exit. |
+| `build.py` | Assembles with the driver's own `-cc1as` / `lld` commands (from `-###`, or rebuilt from the `-mllvm` flags). An unedited `.s` gives the byte-identical code object. Writes the notes and the listing. |
+| `verify_obj.py` | Compares the intended `.s` with the objdump, instruction by instruction: mnemonic, true VGPRs, scalars, MSB immediates, branch targets. |
+
+## Entry model (`--entry`)
+
+The state at the loop header can be modelled in three ways:
+- `cfg`: exact forward dataflow from the kernel entry. This is the compiler's view, and the compiler's own loops have 0 open hazards under it.
+- `preheader`: the preheader block walked from an unknown state. This was the original AO model. It cannot see VMEM loads issued earlier: the AO identity rebuild `ao_id` (e4b638c8) reads prologue K/V fragments (`buffer_load` into v[786:793], …) in its first trip with no `loadcnt` wait on that path.
+- `both` (default): every wait satisfies both models. Use it for anything that goes to a GPU.
+
+## Command line
+
+```
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit loops    K.s
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit map      K.s --nwmma 240 --out map.json
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit identity K.s OUT.s --nwmma 240 [--no-expert] [--entry both]
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit generate K.s GEN.s OUT.s --label .LBB0_25
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit build    OUT.s OUT.hsaco --main-file-name k.hip \
+    --mllvm=-amdgpu-expert-scheduling-mode
+PYTHONPATH=primus_turbo/hipkittens python -m asmkit verify-obj OUT.s OUT.objdump.s
+```
+
+## Generator contract (`splice.generate`)
+
+The generated region text is made of labels and real instructions; derived lines in it are dropped and re-derived.
+- It must contain the shell's header label. If the preheader falls through into the region, the text must start with that label.
+- It may leave the region only by branching to the shell's exit labels, or by falling through at its end where the shell did.
+- The MSB mode is 0 at every block boundary; the emitter makes sure of this.
+- VGPRs: the registers in the entry map's `vgpr_live_in` hold the entry values. Every register live at an exit must hold the right value there. Everything else in `vgpr_free_in_loop` is free.
+- If the region needs more VGPRs than the kernel allocates, raise `.amdhsa_next_free_vgpr` / `.vgpr_count` with `splice.set_vgpr_count`.
+
+## Scope
+
+These checks share the generator's model, so they catch emitter and splice mistakes. They are not an independent proof. Before any transformed or generated code runs on a GPU, it needs the independent verification in `asmkit/verify`: symbolic multi-trip equivalence against the shell, address bounds with real kernel arguments, and the preflight stamp. That code must not import these modules.
diff -ruN a/r8gen/asmkit/splice.py b/r8gen/asmkit/splice.py
--- a/r8gen/asmkit/splice.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/asmkit/splice.py	2026-10-29 06:13:56.000000000 +0000
@@ -0,0 +1,766 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""asmkit.splice -- replace a compiler-generated "shell" loop of a kernel's ``.s`` with generated code.
+
+The HIP source keeps an ordinary loop (the shell) whose live-ins / live-outs are those of the generated loop; the
+compiler produces the prologue, descriptors, addresses and epilogue. This module
+  * finds the shell loop: a natural loop of the kernel's CFG (by header label, by WMMA count, or the one with the
+    most WMMAs), possibly with internal forward branches (rare paths) and a rotated latch block; its member blocks
+    must be contiguous in the text;
+  * reads its entry register map (``entry_map``): VGPR / scalar live-ins at the header (CFG liveness) with their
+    roles inside the loop (WMMA A / B / C, DS / VMEM address or data, buffer resource, TDM descriptor, loop-carried
+    counter), live-outs at every exit, the registers free inside the loop, and what is in flight at entry;
+  * replaces the region's lines (``splice``), keeping every block's labels and trailing directives;
+  * re-derives the derived lines of a region in a given order (``rebuild``, with asmkit.emit): identity
+    (``identity``) or a generator's / scheduler's order;
+  * checks the result with the same expert model (``analyze``): no hazard left open inside the region on any path,
+    and none that the original did not have in the code after every exit (the code after the loop was compiled for
+    the original loop's exit state).
+The independent verification (another tokenizer, symbolic equivalence, bounds) is the V track's, not this one's."""
+
+import json
+import re
+
+from . import emit as M
+from . import expert as E
+from .isa import (
+    coverage_errors,
+    first_tok,
+    load_any,
+    regs_of,
+    sgpr_defs_uses,
+)
+
+
+# --------------------------------------------------------------------------------------------------------------
+# CFG, dominators, natural loops
+# --------------------------------------------------------------------------------------------------------------
+def preds_of(bl):
+    pr = [[] for _ in bl]
+    for b, (_, _, succ) in enumerate(bl):
+        for t in succ:
+            pr[t].append(b)
+    return pr
+
+
+def dominators(bl, entry=0):
+    n = len(bl)
+    pr = preds_of(bl)
+    dom = [set(range(n)) for _ in range(n)]
+    dom[entry] = {entry}
+    changed = True
+    while changed:
+        changed = False
+        for b in range(n):
+            if b == entry:
+                continue
+            ps = [dom[p] for p in pr[b]]
+            new = (set.intersection(*ps) if ps else set()) | {b}
+            if new != dom[b]:
+                dom[b], changed = new, True
+    return dom
+
+
+def natural_loops(bl):
+    """[(header, members (sorted), latches)]: one per header (back edges b -> h with h dominating b merged)."""
+    dom = dominators(bl)
+    pr = preds_of(bl)
+    loops = {}
+    for b, (_, _, succ) in enumerate(bl):
+        for h in succ:
+            if h in dom[b]:
+                mem, stack = {h, b}, ([b] if b != h else [])
+                while stack:
+                    y = stack.pop()
+                    for p in pr[y]:
+                        if p not in mem:
+                            mem.add(p)
+                            stack.append(p)
+                m, l = loops.get(h, (set(), set()))
+                loops[h] = (m | mem, l | {b})
+    return [(h, sorted(m), sorted(l)) for h, (m, l) in sorted(loops.items())]
+
+
+class Region:
+    """A shell loop: member blocks (layout order), header, latches, exits, line range [lo, hi]."""
+
+    def __init__(self, lines, ins, bl, header, members, latches, func):
+        self.lines, self.ins, self.bl, self.func = lines, ins, bl, func
+        self.header, self.members, self.latches = header, members, latches
+        if members != list(range(members[0], members[-1] + 1)):
+            raise ValueError(f"loop blocks {members} are not contiguous in the text")
+        self.lo, self.hi = bl[members[0]][0], bl[members[-1]][1]
+        self.local = {b: k for k, b in enumerate(members)}
+        pr = preds_of(bl)
+        self.outside_preds = [p for p in pr[header] if p not in self.local]
+        for b in members:
+            if b != header and any(p not in self.local for p in pr[b]):
+                raise ValueError(f"block {b} of the loop is entered from outside (not a natural loop region)")
+        self.exits = [(b, t) for b in members for t in bl[b][2] if t not in self.local]
+
+    def nwmma(self):
+        return sum(self.ins[i].cls == "XDL" for i in range(self.lo, self.hi + 1))
+
+    def describe(self):
+        hl = self.ins[self.bl[self.header][0]].label
+        return (
+            f"loop header {hl} (block {self.header}), blocks {self.members[0]}..{self.members[-1]}, lines "
+            f"{self.lo + 1}-{self.hi + 1}, {self.nwmma()} WMMA, latches {self.latches}, exits {self.exits}"
+        )
+
+
+def find_shell(path_or_lines, label=None, nwmma=None, func=None):
+    """The shell loop region of a kernel .s (path or lines): the natural loop whose header block has `label`, or
+    with `nwmma` WMMAs, or the innermost loop with the most WMMAs."""
+    if isinstance(path_or_lines, (list, tuple)):
+        lines = list(path_or_lines)
+        from .isa import parse
+
+        ins = parse(lines)
+    else:
+        lines, ins, fmt = load_any(path_or_lines)
+    bl = E.blocks(ins, func)
+    loops = natural_loops(bl)
+    cands = []
+    for h, mem, lat in loops:
+        nw = sum(ins[i].cls == "XDL" for b in mem for i in range(bl[b][0], bl[b][1] + 1))
+        hl = ins[bl[h][0]].label
+        nested = any(set(m2) < set(mem) for _, m2, _ in loops)
+        if label is not None and hl != label:
+            continue
+        if nwmma is not None and nw != nwmma:
+            continue
+        cands.append((not nested, nw, -h, h, mem, lat))
+    if not cands:
+        raise LookupError(f"no loop with label {label} / {nwmma} WMMAs")
+    cands.sort(reverse=True)
+    _, nw, _, h, mem, lat = cands[0]
+    return Region(lines, ins, bl, h, mem, lat, func)
+
+
+def loops_summary(path, func=None):
+    lines, ins, fmt = load_any(path)
+    bl = E.blocks(ins, func)
+    out = []
+    for h, mem, lat in natural_loops(bl):
+        nw = sum(ins[i].cls == "XDL" for b in mem for i in range(bl[b][0], bl[b][1] + 1))
+        out.append((ins[bl[h][0]].label, h, mem, lat, nw))
+    return out
+
+
+# --------------------------------------------------------------------------------------------------------------
+# region pieces: per block head lines / items / tail lines
+# --------------------------------------------------------------------------------------------------------------
+def _is_ins(x):
+    return bool(x.mn) and x.cls not in ("LABEL", "DIR")
+
+
+def block_parts(region, b):
+    """(head lines, first, last, tail lines) of block b: head = labels / comments before the first instruction,
+    [first, last] the instruction range, tail = directives / comments after the last instruction."""
+    s, e, _ = region.bl[b]
+    ins = region.ins
+    k = s
+    while k <= e and not _is_ins(ins[k]):
+        k += 1
+    j = e
+    while j >= k and not _is_ins(ins[j]):
+        j -= 1
+    for q in range(k, j + 1):
+        if ins[q].cls == "DIR" and region.lines[q].strip().startswith("."):
+            raise ValueError(f"directive inside block {b} at line {q + 1}: {region.lines[q].strip()}")
+    return region.lines[s:k], k, j, region.lines[j + 1 : e + 1]
+
+
+def region_items(region):
+    """[{items, succ (region-local), head, tail, first, last}] per member block, items in source order."""
+    out = []
+    for b in region.members:
+        head, first, last, tail = block_parts(region, b)
+        items = M.build_items(region.lines, region.ins, first, last) if first <= last else []
+        succ = [region.local[t] for t in region.bl[b][2] if t in region.local]
+        out.append(
+            {
+                "items": items,
+                "succ": succ,
+                "head": head,
+                "tail": tail,
+                "first": first,
+                "last": last,
+                "block": b,
+            }
+        )
+    return out
+
+
+def _rpo(bl):
+    seen, post = set(), []
+    stack = [(0, iter(bl[0][2]))]
+    seen.add(0)
+    while stack:
+        b, it = stack[-1]
+        nxt = next(it, None)
+        if nxt is None:
+            post.append(b)
+            stack.pop()
+        elif nxt not in seen:
+            seen.add(nxt)
+            stack.append((nxt, iter(bl[nxt][2])))
+    return post[::-1] + [b for b in range(len(bl)) if b not in seen]
+
+
+def walk_block(ins, s, e, fl, expert=True, on_need=None):
+    """Advance a Flow over lines [s, e] with the waits in place (also XCNT: an s_set_vgpr_msb or s_wait_xcnt 0
+    clears it, a VMEM / TDM op adds its sources)."""
+    for i in range(s, e + 1):
+        x = ins[i]
+        if (
+            x.cls in M.VALU_CLS
+            and x.cls != "VNOP"
+            and on_need is not None
+            and any(M.nops_needed(v, x) for v in fl.valus)
+        ):
+            on_need(i, "v_nop", 0)
+        if on_need is not None and _is_ins(x) and x.cls != "MSB":
+            sd, _ = sgpr_defs_uses(x)
+            guard = {r for r in sd if r != "scc"} | (set() if expert else set(x.defs))
+            if guard and any(xs.unknown or (guard & xs.regs) for xs in fl.xs):
+                on_need(i, "xcnt", 0)
+        for st in fl.sts:
+            E.step(
+                st,
+                ins,
+                i,
+                (lambda i, f, n: on_need(i, f, n) if (expert or f not in ("va_vdst", "vm_vsrc")) else None)
+                if on_need is not None
+                else None,
+            )
+            if not expert:
+                E.forget_alu(st)
+        if (x.cls == "MSB" and M.MSB_CLEARS_XCNT) or (x.cls == "WAIT_CNT" and M.cnt_fields(x).get("xcnt") == 0):
+            for xs in fl.xs:
+                xs.unknown, xs.regs = False, set()
+        elif x.cls in ("VMEM", "FLAT", "TDM"):
+            sd, su = sgpr_defs_uses(x)
+            for xs in fl.xs:
+                xs.regs |= set(su) | (set(x.uses) if not expert else set())
+        if x.cls in M.VALU_CLS:
+            for v in fl.valus:
+                v.insert(0, x)
+                del v[12:]
+    for st in fl.sts:
+        E.cap(st)
+    return fl
+
+
+def function_flows(region, expert=True, iters=40, max_states=8):
+    """(in-flow, out-flow) of every block of the kernel function: forward dataflow from the kernel entry (nothing in
+    flight, MSB mode 0) with the code's own waits, emit.Flow joins at merges, to a fixed point."""
+    ins, bl = region.ins, region.bl
+    pr = preds_of(bl)
+    inflow, outflow = [None] * len(bl), [None] * len(bl)
+    start = M.Flow([E.State(False)], [M.XState(False)], [[]])
+    order = _rpo(bl)
+    for _ in range(iters):
+        changed = False
+        for b in order:
+            srcs = ([start] if b == 0 else []) + [outflow[p] for p in pr[b] if outflow[p] is not None]
+            if not srcs:
+                continue
+            fl = M.Flow.join(srcs, max_states)
+            if inflow[b] is not None and outflow[b] is not None and fl.sig() == inflow[b].sig():
+                continue
+            inflow[b] = fl
+            outflow[b] = walk_block(ins, bl[b][0], bl[b][1], fl.copy(), expert)
+            changed = True
+        if not changed:
+            return inflow, outflow
+    raise RuntimeError("function dataflow did not converge")
+
+
+def entry_paths(region, mode="preheader", expert=True):
+    """Ways into the header from outside.
+    mode 'preheader' (the original AO / regen_asm_patch model): per outside predecessor block, its instructions
+      walked from an unknown state; blind to VMEM loads issued before that block;
+    mode 'cfg': the CFG-exact state from the kernel entry (function_flows), joined over the outside predecessors;
+    mode 'both': both (every wait satisfies each; the safe default for generated code)."""
+    paths = []
+    if mode in ("preheader", "both"):
+        for p in region.outside_preds:
+            s, e, _ = region.bl[p]
+            st = E.walk(E.State(unknown=True), region.ins, range(s, e + 1))
+            valu = M.preheader_valu_list(region.ins, e + 1)
+            paths.append(M.Path(st, M.XState(True), valu))
+    if mode in ("cfg", "both"):
+        _, outflow = function_flows(region, expert)
+        fl = M.Flow.join([outflow[p] for p in region.outside_preds])
+        for k, st in enumerate(fl.sts):
+            for x in fl.xs if k == 0 else [M.XState(False)]:
+                for v in fl.valus if k == 0 else [fl.valus[0]]:
+                    paths.append(M.Path(st, x, v))
+    return paths
+
+
+# --------------------------------------------------------------------------------------------------------------
+# rebuild / splice
+# --------------------------------------------------------------------------------------------------------------
+def rebuild(region, blocks_items=None, fmap=None, expert=True, info=None, entry="both"):
+    """New lines of the whole text with the region's derived lines re-derived for blocks_items (default: the
+    region's own items in source order = identity). blocks_items: [[Item]] per member block (same block structure
+    and successors; a generator that changes the block structure builds its own region list for emit_region)."""
+    parts = region_items(region)
+    if blocks_items is not None:
+        if len(blocks_items) != len(parts):
+            raise ValueError("blocks_items must have one item list per member block")
+        for p, it in zip(parts, blocks_items):
+            p["items"] = it
+    fmap = fmap if fmap is not None else M.learn_msb_map(region.ins)
+    info = {} if info is None else info
+    texts = M.emit_region(
+        parts,
+        fmap,
+        None,
+        None,
+        expert=expert,
+        header=region.local[region.header],
+        entry_paths=entry_paths(region, entry, expert),
+        info=info,
+    )
+    new_region = []
+    for p, t in zip(parts, texts):
+        new_region += p["head"] + t + p["tail"]
+    return splice(region, new_region)
+
+
+def splice(region, new_region_lines):
+    """The whole text with lines [region.lo, region.hi] replaced."""
+    return region.lines[: region.lo] + list(new_region_lines) + region.lines[region.hi + 1 :]
+
+
+def identity(path, label=None, nwmma=None, expert=True, func=None, entry="both"):
+    """(new lines, region, info) of the identity rebuild of a shell loop (entry='preheader' reproduces the original
+    AO rebuild, e.g. ao_id e4b638c8)."""
+    region = find_shell(path, label=label, nwmma=nwmma, func=func)
+    info = {}
+    return rebuild(region, expert=expert, info=info, entry=entry), region, info
+
+
+def set_vgpr_count(lines, n):
+    """Raise the kernel's VGPR allocation to at least n (``.amdhsa_next_free_vgpr`` and ``.vgpr_count``)."""
+    out = []
+    for l in lines:
+        m = re.match(r"(\s*\.amdhsa_next_free_vgpr\s+)(\d+)(.*)", l)
+        if m and int(m.group(2)) < n:
+            l = f"{m.group(1)}{n}{m.group(3)}"
+        m = re.match(r"(\s*\.vgpr_count:\s+)(\d+)(.*)", l)
+        if m and int(m.group(2)) < n:
+            l = f"{m.group(1)}{n}{m.group(3)}"
+        out.append(l)
+    return out
+
+
+# --------------------------------------------------------------------------------------------------------------
+# analysis of a text's region with its own waits (identity and generated code alike)
+# --------------------------------------------------------------------------------------------------------------
+def analyze(region, iters=12, max_states=8, expert=True, entry="both"):
+    """Walk the region of region.lines with the waits in place over everything that reaches each block (entry +
+    back edges to a fixed point, emit.Flow joins). Returns {'open': {(line, field)}, 'nops': [lines],
+    'exit_flows': {(b, t): Flow}}."""
+    ins, bl = region.ins, region.bl
+    loc = region.local
+    pr = {b: [p for p in preds_of(bl)[b] if p in loc] for b in region.members}
+    order, indeg = [], {b: sum(1 for p in pr[b] if b != region.header) for b in region.members}
+    ready = [region.header]
+    while ready:
+        b = ready.pop(0)
+        order.append(b)
+        for t in bl[b][2]:
+            if t in loc and t != region.header:
+                indeg[t] -= 1
+                if indeg[t] == 0:
+                    ready.append(t)
+    entry = M.Flow.of(entry_paths(region, entry, expert))
+    if not expert:
+        for st in entry.sts:
+            E.forget_alu(st)
+    back = None
+    for _ in range(iters):
+        opened, nops, outs = set(), set(), {}
+        for b in order:
+            if b == region.header:
+                fl = M.Flow.join([entry] + ([back] if back is not None else []), max_states)
+            else:
+                fl = M.Flow.join([outs[q] for q in pr[b]], max_states)
+            s, e, _ = bl[b]
+
+            def on_need(i, f, n, opened=opened, nops=nops):
+                if f == "v_nop":
+                    nops.add(i)
+                else:
+                    opened.add((i, f))
+
+            walk_block(ins, s, e, fl, expert, on_need)
+            outs[b] = fl
+        nb = M.Flow.join([outs[q] for q in pr[region.header]], max_states)
+        if back is not None and nb.sig() == back.sig():
+            break
+        back = nb
+    return {"open": opened, "nops": sorted(nops), "exit_flows": {(b, t): outs[b] for b, t in region.exits}}
+
+
+def exit_needs(region, an, limit=400, expert=True):
+    """{(b, t): {(line, field)}}: hazards in the code after each exit (block t and its fall-through successors,
+    up to `limit` instructions) that the waits there leave open, from the region's exit flows."""
+    ins, bl = region.ins, region.bl
+    out = {}
+    for (b, t), fl in an["exit_flows"].items():
+        found = set()
+        fl = fl.copy()
+        n, blk = 0, t
+        while blk is not None and n < limit:
+            s, e, succ = bl[blk]
+            stop = any(ins[i].mn == "s_endpgm" for i in range(s, e + 1))
+            walk_block(ins, s, e, fl, expert, lambda i, f, k, found=found: found.add((i, f)))
+            n += sum(1 for i in range(s, e + 1) if _is_ins(ins[i]))
+            # follow the fall-through only (a taken branch leaves the walk: the target has its own waits)
+            blk = blk + 1 if (not stop and blk + 1 in succ and blk + 1 < len(bl)) else None
+        out[(b, t)] = found
+    return out
+
+
+def find_region_like(orig_region, new_lines, func=None):
+    """The loop of new_lines whose header has the original header label (a generated region may have any block
+    structure inside)."""
+    from .isa import parse
+
+    ins_new = parse(new_lines)
+    hl = orig_region.ins[orig_region.bl[orig_region.header][0]].label
+    bl_new = E.blocks(ins_new, func)
+    loops = [(h, m, l) for h, m, l in natural_loops(bl_new) if ins_new[bl_new[h][0]].label == hl]
+    if len(loops) != 1:
+        raise LookupError(f"rebuilt text: no single loop with header {hl}")
+    h, m, l = loops[0]
+    return Region(new_lines, ins_new, bl_new, h, m, l, func)
+
+
+def check(orig_region, new_lines, func=None, expert=True, entry="both"):
+    """Static checks of a rebuilt or generated region against the original shell (asmkit's own model): failures
+    (empty = pass) and a stats dict. Exits are matched by their target label."""
+    try:
+        new = find_region_like(orig_region, new_lines, func)
+    except (LookupError, ValueError) as e:
+        return [str(e)], {}
+    fail = []
+    if (
+        new.lines[: new.lo] != orig_region.lines[: orig_region.lo]
+        or new.lines[new.hi + 1 :] != orig_region.lines[orig_region.hi + 1 :]
+    ):
+        fail.append("text outside the region differs")
+    cov = [(i + 1, e) for i in range(new.lo, new.hi + 1) for e in coverage_errors(new.ins[i])]
+    if cov:
+        fail.append(f"parse coverage: {cov[:4]}")
+    a_new, a_old = analyze(new, expert=expert, entry=entry), analyze(orig_region, expert=expert, entry=entry)
+    if a_new["open"]:
+        fail.append(
+            f"{len(a_new['open'])} hazards left open inside the region, e.g. "
+            f"{sorted((i + 1, f) for i, f in a_new['open'])[:4]}"
+        )
+    if a_new["nops"]:
+        fail.append(
+            f"{len(a_new['nops'])} WMMA/TRANS hazards without enough v_nop, e.g. lines "
+            f"{[i + 1 for i in a_new['nops'][:4]]}"
+        )
+
+    def by_label(region, en):
+        out = {}
+        for (b, t), found in en.items():
+            key = region.ins[region.bl[t][0]].label or (
+                f"region_end+{region.bl[t][0] - region.hi}"
+                if t > region.members[-1]
+                else f"region_start-{region.lo - region.bl[t][0]}"
+            )
+            out.setdefault(key, set()).update(found)
+        return out
+
+    en_new = by_label(new, exit_needs(new, a_new, expert=expert))
+    en_old = by_label(orig_region, exit_needs(orig_region, a_old, expert=expert))
+    if set(en_new) - set(en_old):
+        fail.append(f"exits to new targets {sorted(set(en_new) - set(en_old))}")
+    shift = len(new_lines) - len(orig_region.lines)
+    extra_total = 0
+    for lab, found in en_new.items():
+        old = {(i + shift if i > orig_region.hi else i, f) for i, f in en_old.get(lab, set())}
+        extra = found - old
+        extra_total += len(extra)
+        if extra:
+            fail.append(
+                f"exit to {lab}: {len(extra)} hazards after the loop the original exit state did not have, "
+                f"e.g. {sorted((i + 1, f) for i, f in extra)[:4]}"
+            )
+    stats = {
+        "open_orig": len(a_old["open"]),
+        "open_new": len(a_new["open"]),
+        "nops_orig": len(a_old["nops"]),
+        "nops_new": len(a_new["nops"]),
+        "exit_needs_orig": sum(len(v) for v in en_old.values()),
+        "exit_needs_new": sum(len(v) for v in en_new.values()),
+        "exit_needs_extra": extra_total,
+        "region_lines": [new.lo + 1, new.hi + 1],
+        "blocks": len(new.members),
+    }
+    return fail, stats
+
+
+def generate(shell, gen_lines, fmap=None, expert=True, entry="both", info=None):
+    """Splice a generated loop into a shell: gen_lines is the generated region's text (labels and real
+    instructions; any derived lines in it are dropped and re-derived). Contract: it holds the shell's header label
+    (and starts with it when the preheader falls through into the region), leaves only by branching to the shell's
+    exit labels (or by falling through at its end where the shell did); the emitter puts MSB mode 0 at every block
+    boundary.
+    Returns the whole new text; run check(shell, new) on it."""
+    from .isa import parse
+
+    hl = shell.ins[shell.bl[shell.header][0]].label
+    gins = parse(gen_lines)
+    if not any(x.label == hl for x in gins):
+        raise ValueError(f"the generated region has no header label {hl}")
+    falls_in = any(
+        p == shell.members[0] - 1 and shell.members[0] in shell.bl[p][2] for p in shell.outside_preds
+    )
+    first = next(x for x in gins if x.cls != "DIR")
+    if falls_in and first.label != hl:
+        raise ValueError(
+            f"the preheader falls through into the region: it must start with the header label {hl}"
+        )
+    # blocks of the generated text: start at labels and after branches
+    starts = [k for k, x in enumerate(gins) if x.label] + [
+        k + 1 for k, x in enumerate(gins) if x.mn.startswith(("s_branch", "s_cbranch")) and k + 1 < len(gins)
+    ]
+    starts = sorted(set(starts) | {0})
+    gb = [(s0, (starts[n + 1] - 1) if n + 1 < len(starts) else len(gins) - 1) for n, s0 in enumerate(starts)]
+    label_block = {gins[s0].label: n for n, (s0, _) in enumerate(gb) if gins[s0].label}
+    blocks = []
+    for n, (s0, e0) in enumerate(gb):
+        k = s0
+        while k <= e0 and not _is_ins(gins[k]):
+            k += 1
+        j = e0
+        while j >= k and not _is_ins(gins[j]):
+            j -= 1
+        items = M.build_items(gen_lines, gins, k, j) if k <= j else []
+        succ, last = [], (gins[j] if k <= j else None)
+        if last is not None and last.mn.startswith(("s_branch", "s_cbranch")):
+            t = strip_target(last)
+            if t in label_block:
+                succ.append(label_block[t])
+            if last.mn.startswith("s_cbranch") and n + 1 < len(gb):
+                succ.append(n + 1)
+        elif n + 1 < len(gb):
+            succ.append(n + 1)
+        blocks.append(
+            {"items": items, "succ": succ, "head": gen_lines[s0:k], "tail": gen_lines[j + 1 : e0 + 1]}
+        )
+    fmap = fmap if fmap is not None else M.learn_msb_map(shell.ins)
+    texts = M.emit_region(
+        blocks,
+        fmap,
+        None,
+        None,
+        expert=expert,
+        header=label_block[hl],
+        entry_paths=entry_paths(shell, entry, expert),
+        info=info,
+    )
+    region = []
+    for b, t in zip(blocks, texts):
+        region += b["head"] + t + b["tail"]
+    return splice(shell, region)
+
+
+def strip_target(x):
+    from .isa import strip_comment
+
+    return strip_comment(x.ops[0]).strip() if x.ops else ""
+
+
+# --------------------------------------------------------------------------------------------------------------
+# entry register map
+# --------------------------------------------------------------------------------------------------------------
+def _ranges(regs):
+    out, cur = [], None
+    for r in sorted(regs):
+        if cur and r == cur[1] + 1:
+            cur[1] = r
+        else:
+            cur = [r, r]
+            out.append(cur)
+    return out
+
+
+def _fmt(lo, hi, p="v"):
+    return f"{p}{lo}" if lo == hi else f"{p}[{lo}:{hi}]"
+
+
+def _roles(x):
+    """[(operand regs (VGPR list), scalar list, role)] of an instruction."""
+    mn, ops, out = x.mn, [o for o in x.ops if o != "::"], []
+    vr = [regs_of(first_tok(o)) for o in ops]
+    from .isa import sregs
+
+    sr = [sregs(first_tok(o)) for o in ops]
+    if x.cls == "XDL":
+        names = ["wmma_d", "wmma_a", "wmma_b", "wmma_c"]
+    elif x.cls == "DS":
+        names = (
+            ["ds_dst", "ds_addr"]
+            if mn.startswith(("ds_load", "ds_read"))
+            else ["ds_addr", "ds_data", "ds_data2"]
+        )
+    elif x.cls in ("VMEM", "FLAT"):
+        load = "_load" in mn
+        if x.cls == "VMEM":
+            names = (
+                ["vmem_dst", "vmem_vaddr", "buffer_rsrc", "buffer_soffset"]
+                if load
+                else ["vmem_data", "vmem_vaddr", "buffer_rsrc", "buffer_soffset"]
+            )
+        else:
+            names = (
+                ["vmem_dst", "vmem_vaddr", "vmem_saddr"]
+                if load
+                else ["vmem_vaddr", "vmem_data", "vmem_saddr"]
+            )
+    elif x.cls == "TDM":
+        names = [f"tdm_desc{k}" for k in range(len(ops))]
+    elif x.cls in ("CSMACC", "DPMACC", "TRANS"):
+        names = ["valu_dst"] + ["valu_src"] * 8
+    elif x.cls in ("SALU", "BARRIER"):
+        names = ["salu_dst"] + ["salu_src"] * 8
+    else:
+        names = ["op"] * 16
+    for k, o in enumerate(ops):
+        out.append((vr[k], sr[k], names[k] if k < len(names) else "op"))
+    return out
+
+
+def entry_map(region):
+    """Register contract of the shell loop for a generator (JSON-serializable)."""
+    ins, bl = region.ins, region.bl
+    lout = E.liveness(ins, bl)
+    lin = E.live_in(ins, bl, lout)
+    s_in, s_out = E.scalar_liveness(ins, bl, sgpr_defs_uses)
+    h = region.header
+    live_in_v = lin[h]
+    vin = {r for r in range(1024) if live_in_v >> r & 1}
+    vdef, sdef = set(), set()
+    roles_v, roles_s, tuples = {}, {}, {}
+    used_v = set()
+    first_use = {}
+    for b in region.members:
+        s, e, _ = bl[b]
+        for i in range(s, e + 1):
+            x = ins[i]
+            if not _is_ins(x):
+                continue
+            vdef |= set(x.defs) if not x.rmw else set(x.defs)
+            used_v |= set(x.defs) | set(x.uses)
+            sd, su = sgpr_defs_uses(x)
+            sdef |= set(sd)
+            for vregs, sregs_, role in _roles(x):
+                if vregs:
+                    key = (vregs[0], vregs[-1])
+                    tuples.setdefault(key, set()).add(role)
+                    for r in vregs:
+                        roles_v.setdefault(r, set()).add(role)
+                        first_use.setdefault(r, i + 1)
+                for r in sregs_:
+                    roles_s.setdefault(r, set()).add(role)
+    sin = s_in[h]
+    # live-in VGPRs grouped by the operand tuples that touch them
+    groups = []
+    covered = set()
+    for (lo, hi), rl in sorted(tuples.items()):
+        regs = set(range(lo, hi + 1)) & vin
+        if not regs or regs <= covered:
+            continue
+        covered |= regs
+        groups.append(
+            {
+                "regs": _fmt(lo, hi),
+                "live_in": [_fmt(a, b) for a, b in _ranges(regs)],
+                "carried": bool(regs & vdef),
+                "roles": sorted(rl),
+                "first_use_line": first_use.get(lo),
+            }
+        )
+    rest = vin - covered
+    for a, b in _ranges(rest):
+        groups.append(
+            {
+                "regs": _fmt(a, b),
+                "live_in": [_fmt(a, b)],
+                "carried": bool(set(range(a, b + 1)) & vdef),
+                "roles": sorted(set().union(*[roles_v.get(r, set()) for r in range(a, b + 1)]))
+                or ["passthrough"],
+                "first_use_line": None,
+            }
+        )
+    exits = {}
+    for b, t in region.exits:
+        lv = {r for r in range(1024) if lin[t] >> r & 1}
+        exits[region.ins[bl[t][0]].label or f"block{t}"] = {
+            "from_block": b,
+            "vgpr_live": [_fmt(a, c) for a, c in _ranges(lv)],
+            "vgpr_live_defined_in_loop": [_fmt(a, c) for a, c in _ranges(lv & vdef)],
+            "scalar_live": sorted(s_in[t], key=_skey),
+        }
+    vgpr_count = None
+    for l in region.lines:
+        m = re.match(r"\s*\.vgpr_count:\s+(\d+)", l)
+        if m:
+            vgpr_count = int(m.group(1))
+    live_any_exit = set()
+    for b, t in region.exits:
+        live_any_exit |= {r for r in range(1024) if lin[t] >> r & 1}
+    free = set(range(1024)) - vin - live_any_exit
+    ent = entry_paths(region, "cfg")
+    pend = sorted({r for p in ent for rec in p.st.loads if not rec.done for r in rec.writes})
+    scal = []
+    for r in sorted(sin, key=_skey):
+        scal.append(
+            {"reg": r, "carried": r in sdef, "roles": sorted(roles_s.get(r, set())) or ["passthrough"]}
+        )
+    return {
+        "loop": region.describe(),
+        "header_label": region.ins[bl[h][0]].label,
+        "lines": [region.lo + 1, region.hi + 1],
+        "vgpr_count_kernel": vgpr_count,
+        "vgpr_live_in": groups,
+        "vgpr_live_in_count": len(vin),
+        "scalar_live_in": scal,
+        "exits": exits,
+        "vgpr_free_in_loop": [_fmt(a, b) for a, b in _ranges(free)],
+        "vgpr_free_count": len(free),
+        "vgpr_used_in_loop": len(used_v),
+        "entry": {
+            "msb_mode": 0,
+            "pending_load_vgprs": [_fmt(a, b) for a, b in _ranges(pend)],
+            "unknown_valu": any(p.st.unknown_v for p in ent),
+            "unknown_ds": any(p.st.unknown_ds for p in ent),
+            "outside_preds": region.outside_preds,
+        },
+    }
+
+
+def _skey(r):
+    m = re.match(r"([a-z_]+)(\d*)", r)
+    return (m.group(1), int(m.group(2)) if m.group(2) else -1)
+
+
+def dump_map(m, path):
+    with open(path, "w") as f:
+        json.dump(m, f, indent=1)
diff -ruN a/r8gen/asmkit/verify_obj.py b/r8gen/asmkit/verify_obj.py
--- a/r8gen/asmkit/verify_obj.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/asmkit/verify_obj.py	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,74 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""asmkit.verify_obj -- the code object holds what the edited ``.s`` intends.
+
+Compares the instruction sequence of the intended ``.s`` with the ``llvm-objdump -d`` listing of the assembled
+code object, instruction by instruction: the mnemonic (``_e32`` / ``_e64`` suffixes ignored), every operand's TRUE
+VGPR numbers (the disassembler derives them from the ``s_set_vgpr_msb`` state, so an MSB mistake shows up as a
+register mismatch), the scalar registers, every ``s_set_vgpr_msb`` immediate and every branch target (as an
+instruction ordinal). Whole function by default; a single-block loop with ``nwmma`` WMMAs optionally."""
+
+import re
+import sys
+
+from .isa import find_loop, first_tok, function_range, load_any, regs_of, sregs, strip_comment
+
+_MN = re.compile(r"^[a-z][a-z0-9_]*(::[a-z][a-z0-9_]*)?$")
+
+
+def _seq(path, nwmma=None, func=None):
+    lines, ins, fmt = load_any(path)
+    if nwmma is not None:
+        f, l = find_loop(ins, nwmma)
+    else:
+        f, l = function_range(ins, func)
+    # label -> ordinal of the next instruction
+    ordinal, label_at, n = {}, {}, 0
+    for k in range(f, l + 1):
+        x = ins[k]
+        if x.label:
+            label_at[x.label] = n
+        if x.mn and x.cls not in ("LABEL", "DIR", "CLAUSE") and _MN.match(x.mn) and x.mn != "s_code_end":
+            ordinal[k] = n
+            n += 1
+    out = []
+    for k in range(f, l + 1):
+        x = ins[k]
+        if k not in ordinal:
+            continue
+        if x.mn == "s_code_end":
+            continue
+        mn = x.mn.replace("_e32", "").replace("_e64", "")
+        if x.cls == "MSB":
+            out.append((mn, (int(strip_comment(x.text).split()[1], 0),)))
+            continue
+        if mn.startswith(("s_cbranch", "s_branch")):
+            t = strip_comment(x.ops[0]).strip() if x.ops else ""
+            out.append((mn, ("->", label_at.get(t, "outside"))))
+            continue
+        regs = tuple((tuple(regs_of(first_tok(o))), tuple(sregs(first_tok(o)))) for o in x.ops if o != "::")
+        out.append((mn, regs))
+    return out
+
+
+def compare(intended, objdump, nwmma=None, func=None, log=print):
+    """[] when equal, else the mismatching (index, intended, objdump) triples (first 8)."""
+    a, b = _seq(intended, nwmma, func), _seq(objdump, nwmma, None if func is None else None)
+    bad = [i for i, (p, q) in enumerate(zip(a, b)) if p != q]
+    log(f"  verify_obj: intended {len(a)} instructions, code object {len(b)}; mismatches {len(bad)}")
+    out = [(i, a[i], b[i]) for i in bad[:8]]
+    if len(a) != len(b):
+        out.append(("length", len(a), len(b)))
+    return out
+
+
+if __name__ == "__main__":
+    n = int(sys.argv[3]) if len(sys.argv) > 3 else None
+    r = compare(sys.argv[1], sys.argv[2], n)
+    for t in r:
+        print("  ", t)
+    sys.exit(1 if r else 0)
diff -ruN a/r8gen/gen/build.py b/r8gen/gen/build.py
--- a/r8gen/gen/build.py	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/gen/build.py	2026-10-29 10:11:49.000000000 +0000
@@ -0,0 +1,392 @@
+###############################################################################
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+#
+# See LICENSE for license information.
+###############################################################################
+
+"""build.py -- build k_dkdv96ds from the HKGEN marker shell (hip/src/k_dkdv96ds.hip -DHKGEN=1) and r8gen's regions.
+
+    python3 gen/build.py --out DIR [--sched list|program] [--rule llvm|warv] [-D NAME=V ...] [--cxx amdclang++]
+
+ 1. compile the shell (the ladder's k_dkdv96ds flags + -DHKGEN=1, -save-temps): DIR/shell.s; and the LLVM-compiled
+    variant (-DHKGEN=0: r9a) as DIR/ref.s, whose high-VGPR buffer / DS / VALU operands teach the MSB field map;
+ 2. markers -> operand registers; base = 1 + the highest VGPR the shell's code touches on any path from INIT to FINAL
+    (gen/shellbase.py) or any VGPR marker operand;
+ 3. r8gen's regions (INIT, RB, STEP, STEPM, FINAL); asmkit.emit derives s_set_vgpr_msb / expert waits (va_vdst:
+    --rule llvm = LLVM's, warv = per-class bound for WAR-V only) / hazard v_nops from an unknown entry state; every
+    region ends with s_wait_xcnt 0 + vm_vsrc 0 (the shell may rewrite the operands an in-flight memory op reads); a
+    re-walk must find no open hazard;
+ 4. splice in place of the marker bodies, VGPR allocation 1024: DIR/k_dkdv96ds.s;
+ 5. assemble with the driver's own cc1as / lld (asmkit.build): DIR/k_dkdv96ds.hsaco; asmkit.verify_obj;
+ 6. contract: generated VGPR defs only at or above base; SGPR defs only in s90..s103 / vcc / scc; no spills.
+Writes DIR/build.json; exit 1 on any failed check. CPU only."""
+
+import argparse
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+PKG = HERE.parent
+# the HIP tree: the package's own hip/ (the ladder's copy), else Primus-Turbo's gfx1250_mla_bwd/hip (tools/r8gen/..)
+HIP = PKG / "hip" if (PKG / "hip").is_dir() else PKG.parent.parent / "hip"
+sys.path.insert(0, str(HERE))
+sys.path.insert(0, str(PKG))
+import r8gen as G  # noqa: E402
+import shellbase  # noqa: E402
+
+FLAGS = ["-x", "hip", "--offload-arch=gfx1250", "--cuda-device-only", "--no-gpu-bundle-output", "-O3", "-std=c++20",
+         "-DNDEBUG", "-DKITTENS_CDNA5", "-Iinclude", "-I.", "-save-temps=obj"]  # fmt: skip
+EXTRA = ["-mllvm", "-structurizecfg-skip-uniform-regions", "-mllvm", "-amdgpu-expert-scheduling-mode", "-mllvm",
+         "-amdgpu-enable-delay-alu=false", "-mllvm", "-greedy-regclass-priority-trumps-globalness"]  # fmt: skip
+KERNEL = "k_dkdv96ds"
+MARK = re.compile(r";\s*HKGEN\s+(\w+)\s*(.*)$")
+CLOBBERED = {f"s{i}" for i in range(90, 104)} | {"vcc", "scc"}
+LOOP_CLOBBERED = CLOBBERED | {f"s{i}" for i in range(48, 90)}
+# region tails: the shell may rewrite the SGPR operands an in-flight memory op still reads (XCNT); after INIT / RB /
+# FINAL also the VGPR operands (the shell's VALU) -- between steps it writes no VGPR a region reads (checked)
+POST_STEP = ["\ts_wait_xcnt 0x0"]
+POST = ["\ts_wait_xcnt 0x0", "\ts_wait_alu depctr_vm_vsrc(0)"]
+STEPS = []  # (the per-tile markers of the first generation; the LOOP marker replaces them)
+
+
+def log(*a):
+    print(*a, flush=True)
+
+
+def sha256(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+
+def compile_variant(cxx, out_dir, defs):
+    out_dir.mkdir(parents=True, exist_ok=True)
+    tmp = out_dir / "tmp"
+    shutil.rmtree(tmp, ignore_errors=True)
+    tmp.mkdir()
+    cmd = [cxx, *FLAGS, *EXTRA, f"-cuid={KERNEL}", *[f"-D{d}" for d in defs], "-c", "src/k_dkdv96ds.hip", "-o",
+           str(out_dir / f"{KERNEL}.cc.hsaco")]  # fmt: skip
+    r = subprocess.run(cmd, cwd=HIP, capture_output=True, text=True)
+    for d in (HIP, out_dir):
+        for f in d.glob(f"{KERNEL}-hip-*"):
+            shutil.move(str(f), str(tmp / f.name))
+    if r.returncode != 0:
+        raise RuntimeError(f"compile failed:\n{r.stderr[-4000:]}")
+    return cmd, next(tmp.glob("*-gfx1250.s"))
+
+
+def parse_markers(lines):
+    out = []
+    for i, l in enumerate(lines):
+        m = MARK.search(l)
+        if not m:
+            continue
+        if ";;#ASMSTART" not in lines[i - 1] or ";;#ASMEND" not in lines[i + 1]:
+            raise ValueError(f"marker at line {i + 1} is not a lone inline asm statement")
+        ops = dict(kv.split("=", 1) for kv in m.group(2).split())
+        out.append((m.group(1), ops, i, i - 1, i + 1))
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--sched", default="slot", choices=("win", "slot", "list", "program"))
+    ap.add_argument("--rule", default="warv", choices=("llvm", "warv"))
+    ap.add_argument("--cxx", default="amdclang++")
+    ap.add_argument("-D", dest="defs", action="append", default=[])
+    ap.add_argument("--abl", default="", help="timing-only ablations, comma separated (r8gen.ABL)")
+    ap.add_argument("--probe-pts", default="", help="HKGEN_PROBE: three WMMA counts (comma separated) as probe points")
+    ap.add_argument("--hh1-split", type=int, default=0, help="r8gen.HH1_SPLIT (0 kh-major .. 6 dt outer)")
+    ap.add_argument("--bdo-after-hh1", action="store_true", help="r8gen.BDO_AFTER_HH1")
+    ap.add_argument("--win", default="", help="bwdgen.WIN overrides for --sched win: KEY=VAL,KEY=VAL")
+    ap.add_argument("--nd-fold", action="store_true", help="r8gen.ND_FOLD (needs k_delta -DHK_ND_FOLD=1)")
+    ap.add_argument("--scal-in-body", action="store_true", help="r8gen.SCAL_IN_BODY (the next tile's scalars in the bodies)")
+    ap.add_argument("--tdm-dummy", action="store_true", help="r8gen.TDM_DUMMY (16-B ops past the last tile)")
+    ap.add_argument("--final-pipe", action="store_true", help="r8gen.FINAL_PIPE (pipelined epilogue)")
+    ap.add_argument("--tdm-lim-sc7", action="store_true", help="r8gen.TDM_LIM_SC7 (shell -DHKGEN_W4)")
+    ap.add_argument("--asmkit-root", default=None, help="ignored: the package carries its own asmkit")
+    a = ap.parse_args()
+    from asmkit import build as B
+    from asmkit import emit as M
+    from asmkit import expert as E
+    from asmkit import splice as SP
+    from asmkit import verify_obj as VO
+    from asmkit.isa import cnt_fields, coverage_errors, parse, parse_line, sgpr_defs_uses
+
+    M.VA_RULE_LLVM = {"llvm": True, "warv": "warv"}[a.rule]
+    G.ABL = set(x for x in a.abl.split(",") if x)
+    G.PROBE_PTS = [int(x) for x in a.probe_pts.split(",") if x] or None
+    G.HH1_SPLIT, G.BDO_AFTER_HH1, G.ND_FOLD = a.hh1_split, a.bdo_after_hh1, a.nd_fold
+    G.SCAL_IN_BODY, G.TDM_DUMMY, G.FINAL_PIPE = a.scal_in_body, a.tdm_dummy, a.final_pipe
+    G.TDM_LIM_SC7 = a.tdm_lim_sc7
+    import bwdgen as BG
+
+    for kv in [x for x in a.win.split(",") if x]:
+        k, v = kv.split("=")
+        if k not in BG.WIN:
+            raise SystemExit(f"--win: unknown key {k}")
+        BG.WIN[k] = type(BG.WIN[k])(float(v)) if isinstance(BG.WIN[k], (int, float)) else v
+    out = Path(a.out).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    rec = {"recipe": {"sched": a.sched, "rule": a.rule, "defs": a.defs}, "checks": {}, "fail": []}
+    fail = rec["fail"]
+    cmd, s_path = compile_variant(a.cxx, out / "shell", ["HKGEN=1"] + a.defs)
+    shell = s_path.read_text().rstrip("\n").split("\n")
+    (out / "shell.s").write_text("\n".join(shell) + "\n")
+    rec["recipe"]["compile"] = cmd
+    _, ref_s = compile_variant(a.cxx, out / "ref", ["HKGEN=0"])
+    fmap = M.merge_msb_maps(M.learn_msb_map(parse(shell)), M.learn_msb_map(parse(ref_s.read_text().split("\n"))))
+    fields = ("dst", "src0", "src1", "src2")
+    for mn in ("ds_load_b128", "ds_load_tr16_b128"):
+        fmap[(mn, 0)], fmap[(mn, 1)] = {"dst"}, {"src0"}
+    fmap[("ds_store_b128", 0)], fmap[("ds_store_b128", 1)] = {"src0"}, {"src1"}
+
+    markers = parse_markers(shell)
+    sets = {}
+    for m in markers:
+        nkv = int(m[1].pop("nkv", "3"))
+        if m[0] in sets.setdefault(nkv, {}):
+            raise RuntimeError(f"marker {m[0]} nkv={nkv} twice")
+        sets[nkv][m[0]] = m
+    for nkv, by in sets.items():
+        if sorted(n for n in by if n != "PROBE") != ["FINAL", "INIT", "LOOP"]:
+            raise RuntimeError(f"nkv={nkv}: markers {sorted(by)}, want FINAL INIT LOOP (+ PROBE)")
+    ins = parse(shell)
+    bl = E.blocks(ins)
+    for i, l in enumerate(shell):
+        x = parse_line(i, l)
+        if x.cls in ("XDL", "TRANS"):
+            fail.append(f"shell line {i + 1} has a WMMA / TRANS: {l.strip()}")
+    rec["layout"], rec["model_cycles"], rec["checks"]["loop_fixed_point_iterations"] = {}, {}, {}
+
+    def walk_check(lines):
+        ins2 = parse(["\t" + l.strip() if not l.startswith("\t") else l for l in lines])
+        fl = M.Flow([E.State(unknown=True)], [M.XState(True)], [[]])
+        found = []
+        SP.walk_block(ins2, 0, len(ins2) - 1, fl, True, lambda k, f, n: found.append((k, f, ins2[k].text.strip())))
+        cov = [(k, e) for k, x in enumerate(ins2) for e in coverage_errors(x)]
+        return found + [("coverage", c) for c in cov]
+
+    def items_of(texts):
+        for t in texts:
+            x = parse_line(0, "\t" + t)
+            for p, o in enumerate(x.ops):
+                key = (x.mn, p)
+                if key not in fmap and x.cls in ("XDL", "CSMACC", "DPMACC", "TRANS") and p < 4:
+                    fmap[key] = {fields[p]}
+        items = [M.make_item("\t" + t) for t in texts]
+        for k, it in enumerate(items):
+            it.pos = k
+        return items
+
+    def with_unknown(fl, regs):
+        """fl + unknown VALU writes in flight on regs (the shell's code in front of the region) + unknown XCNT."""
+        fl = fl.copy()
+        for st in fl.sts:
+            st.valu.append(E.Rec("UNK", [], sorted(regs), False, 0))
+        for x in fl.xs:
+            x.unknown = True
+        return fl
+
+    def tail(fl):
+        """The region's tail waits (xcnt 0, vm_vsrc 0) applied to its exit flow."""
+        fl = fl.copy()
+        for x in fl.xs:
+            x.unknown, x.regs = False, set()
+        for st in fl.sts:
+            E.apply_vm(st, 0)
+        return fl
+
+    def emit(items, fl):
+        return M._emit_block(items, fl, fmap, True)
+
+    def explain(items, fl, label):
+        """Debug (HKGEN_EXPLAIN): every instruction of a block that needs va_vdst 0, with the in-flight records
+        behind it."""
+        fl = fl.copy()
+        for n in items:
+            x = n.x
+            for st in fl.sts:
+                if x.cls in ("DS", "VMEM", "FLAT", "TDM"):
+                    nd = E.va_need(st, x, llvm=M.VA_RULE_LLVM)
+                    if nd == 0:
+                        rs, ws = set(x.uses), set(x.defs)
+                        why = [(r.cls, r.counted, sorted(r.reads & ws)[:2], sorted(r.writes & (rs | ws))[:2])
+                               for r in st.valu if not r.done and (r.writes & (rs | ws) or r.reads & ws)]
+                        log(f"  [{label}] va0 before {x.text.strip()[:70]}  unknown_v={st.unknown_v} recs={why[:4]}")
+                        E.apply_va(st, 0)
+                if x.cls == "WAIT_CNT":
+                    E.apply_cnt(st, cnt_fields(x))
+                else:
+                    E.issue(st, x)
+
+    # every VGPR the shell's own code references anywhere in the function (not just between INIT and FINAL): a value
+    # the compiler keeps in a VGPR across the generated regions (defined before INIT, used after FINAL) is not
+    # "touched" in between, so the whole function must stay below every base
+    shell_hi, shell_hi_at = -1, None
+    marker_lines = set()
+    for m in markers:
+        marker_lines |= set(range(m[3], m[4] + 1))
+    for i, x in enumerate(ins):
+        if i in marker_lines or not x.mn or x.cls in ("LABEL", "DIR"):
+            continue
+        vs = [r for r in list(x.defs) + list(x.uses) if isinstance(r, int)]
+        if vs and max(vs) > shell_hi:
+            shell_hi, shell_hi_at = max(vs), (i + 1, shell[i].strip()[:80])
+    rec["checks"]["shell_highest_vgpr"] = shell_hi
+    regions = {}  # marker line -> lines
+    for nkv in sorted(sets, reverse=True):
+        by = sets[nkv]
+        G.set_nkv(nkv)
+        mlines = {m[2] for m in markers}
+        hi, seen = shellbase.shell_span(shell, ins, bl, by["INIT"][2], by["FINAL"][2], mlines)
+        base, why = hi + 1, f"shell code v{hi}"
+        for mk, (_, ops, _, _, _) in by.items():
+            for k, v in ops.items():
+                m = re.fullmatch(r"v(\d+)|v\[(\d+):(\d+)\]", v)
+                if m and int(m.group(3) or m.group(1)) + 1 > base:
+                    base, why = int(m.group(3) or m.group(1)) + 1, f"{mk} operand {k}={v}"
+        log(f"nkv={nkv}: base v{base} set by {why}")
+        if hi >= 15:
+            for i in sorted(seen):
+                vs = [r for r in list(ins[i].defs) + list(ins[i].uses) if r >= 15]
+                if vs:
+                    log(f"   line {i + 1}: {shell[i].strip()[:100]}")
+        if shell_hi >= base:
+            fail.append(f"nkv={nkv}: the shell references v{shell_hi} (line {shell_hi_at}) at or above base v{base}")
+        L = G.Layout(base)
+        rec["layout"][nkv] = {"base": base, "top": L.top}
+        log(f"nkv={nkv} shell: highest VGPR between INIT and FINAL v{hi}, base v{base}, generated state up to "
+            f"v{L.top - 1}")  # fmt: skip
+        # shell instructions between INIT and FINAL: no memory op but the TDM (the loads / stores the regions count
+        # on are all generated); the LOOP region runs no shell code inside
+        for i in seen:
+            x = ins[i]
+            if x.cls in ("DS", "VMEM", "FLAT"):
+                fail.append(f"nkv={nkv}: shell memory op between INIT and FINAL at line {i + 1}: {shell[i].strip()}")
+        shell_regs = set(range(base))
+        unknown = M.Flow([E.State(unknown=True)], [M.XState(True)], [[]])
+        lines_of, entry_fl = {}, {}
+        # INIT
+        t_init = G.region_init(L, by["INIT"][1])
+        entry_fl["INIT"] = unknown
+        lines_of["INIT"], fl = emit(items_of(t_init), unknown)
+        exit_init = tail(fl)
+        # LOOP: its init block, then the loop blocks to a fixed point of the entry flows
+        probe = "PROBE" in by
+        lp = f".LHKG{nkv}"
+        t_rb, blocks, model = G.region_loop(L, by["LOOP"][1], a.sched, probe, lp)
+        entry_fl["RB"] = with_unknown(exit_init, shell_regs)
+        lines_of["RB"], exit_rb = emit(items_of(t_rb), entry_fl["RB"])
+        names = [b[0] for b in blocks]
+        its_b = {b[0]: items_of(b[2]) for b in blocks}
+        preds = {n: [] for n in names}
+        for n, _, _, succ in blocks:
+            for t in succ:
+                if t != "X":
+                    preds[t].append(n)
+        preds["H0"].append("RB")
+        exits = {"RB": exit_rb}
+        lines_b, sig_b = {}, {}
+        for it in range(96):
+            changed = False
+            for n in names:
+                ins_fl = [exits[p] for p in preds[n] if p in exits]
+                if not ins_fl:
+                    continue
+                fl_in = M.Flow.join(ins_fl)
+                sg = fl_in.sig()
+                if sig_b.get(n) == sg:
+                    continue
+                sig_b[n] = sg
+                entry_fl[n] = fl_in
+                lines_b[n], exits[n] = emit(its_b[n], fl_in)
+                changed = True
+            if not changed:
+                break
+        else:
+            (log if G.ABL else fail.append)(f"nkv={nkv}: LOOP entry states did not converge")
+        rec["checks"]["loop_fixed_point_iterations"][nkv] = it + 1
+        if "HKGEN_EXPLAIN=1" in a.defs:
+            for n in ("U1",):
+                explain(its_b[n], entry_fl[n], f"nkv{nkv} {n}")
+        loop_lines = list(lines_of["RB"])
+        for n, label, _, _ in blocks:
+            loop_lines += [f"{label}:"] + lines_b[n]
+        loop_lines.append(f"{lp}_X:")
+        lines_of["LOOP"] = loop_lines
+        x_exits = [tail(exits[n]) for n, _, _, succ in blocks if "X" in succ]
+        fin_in = with_unknown(M.Flow.join([exit_init] + x_exits), shell_regs)
+        t_fin = G.region_final(L, by["FINAL"][1])
+        entry_fl["FINAL"] = fin_in
+        lines_of["FINAL"], _ = emit(items_of(t_fin), fin_in)
+        texts_of = {"INIT": t_init, "LOOP": t_rb + [t for b in blocks for t in b[2]], "FINAL": t_fin}
+        if probe:
+            t_pr = [f"v_readfirstlane_b32 {by['PROBE'][1][k]}, {G.vr(L.PRB[j])}" for j, k in enumerate("abcd")]
+            lines_of["PROBE"], _ = emit(items_of(t_pr), unknown)
+            texts_of["PROBE"] = t_pr
+
+        for name, (_, ops, i, _, _) in by.items():
+            lines = lines_of[name] + POST
+            allowed = LOOP_CLOBBERED if name == "LOOP" else CLOBBERED
+            for l in lines:
+                x = parse_line(0, l)
+                if not x.mn or x.cls in ("LABEL", "DIR"):
+                    continue
+                low = [r for r in x.defs if r < base]
+                if low:
+                    fail.append(f"nkv={nkv} {name}: writes shell VGPRs {low}: {l.strip()}")
+                sd, _ = sgpr_defs_uses(x)
+                bad = [r for r in sd if r not in allowed]
+                if bad and not x.mn.startswith("s_wait") and x.cls != "MSB" and name != "PROBE":
+                    fail.append(f"nkv={nkv} {name}: writes SGPRs {bad}: {l.strip()}")
+            regions[i] = lines
+            nw = sum(1 for l in lines if "v_wmma" in l)
+            nva0 = sum(1 for l in lines if "va_vdst(0)" in l)
+            log(f"nkv={nkv} {name}: {len(texts_of[name])} instructions -> {len(lines)} lines, {nw} WMMA, "
+                f"{nva0} va_vdst(0)")  # fmt: skip
+        log(f"nkv={nkv} LOOP model cycles per body: {model}")
+        rec["model_cycles"][nkv] = model
+        # re-walk every block's emitted lines from its own entry flow: nothing may stay open
+        for name, ls0 in [("INIT", lines_of["INIT"]), ("RB", lines_of["RB"])] + [(n, lines_b[n]) for n in names] + \
+                [("FINAL", lines_of["FINAL"])]:  # fmt: skip
+            ls = ["\t" + l.strip() if not l.startswith("\t") else l for l in ls0]
+            ins2 = parse(ls)
+            found = []
+            SP.walk_block(ins2, 0, len(ins2) - 1, entry_fl[name].copy(), True,
+                          lambda k, f, n: found.append((k, f, ins2[k].text.strip())))  # fmt: skip
+            cov = [(k, e) for k, x in enumerate(ins2) for e in coverage_errors(x)]
+            if found or cov:
+                fail.append(f"nkv={nkv} {name}: {len(found)} open hazards, {len(cov)} coverage errors, e.g. "
+                            f"{(found + cov)[:3]}")  # fmt: skip
+
+    new = list(shell)
+    for name, ops, i, s0, s1 in sorted(markers, key=lambda m: -m[2]):
+        new[s0 + 1 : s1] = [new[i]] + regions[i]
+    new = SP.set_vgpr_count(new, 1024)
+    spl = out / f"{KERNEL}.s"
+    spl.write_text("\n".join(new) + "\n")
+    cc1as, lld = B.driver_steps(cmd, str(HIP))
+    meta = B.assemble(spl, out / f"{KERNEL}.hsaco", cc1as, lld, cwd=str(HIP))
+    rec["hsaco"] = meta
+    log(f"hsaco: {meta}")
+    bad = VO.compare(str(spl), str(out / f"{KERNEL}.objdump.s"), log=log)
+    rec["checks"]["verify_obj"] = "ok" if not bad else [str(b) for b in bad]
+    if bad:
+        fail.append(f"verify_obj: {bad[:3]}")
+    if meta.get("vgpr_spill_count", 0) or meta.get("private_segment_fixed_size", 0):
+        fail.append(f"spills / scratch: {meta}")
+    for f in fail:
+        log("FAIL:", f)
+    rec["verdict"] = "PASS" if not fail else "FAIL"
+    (out / "build.json").write_text(json.dumps(rec, indent=1, default=str) + "\n")
+    log(f"VERDICT {rec['verdict']}  {out / (KERNEL + '.hsaco')}  sha256 {meta.get('sha256')}")
+    return 0 if not fail else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
