+
+// dqds/dqds_impl.h (bwd_hk_dqds2) -- the recompute-free dQ kernel of the S1 line in HIP, 384-query
+// tiles:
+//
+//   dQ[q, :] = sum_{kv attended by q} dS[q, kv] K[kv, :]      (dS from the S1 scratch, dslayout v2,
+//   scale included)
+//
+// bwd_hk_dqds's k_dqds_b with the workgroup doubled to 4 waves (block 128, 1 wave per SIMD, one
+// workgroup per CU), so one K ring feeds 384 queries, and role-split TDM issue (idx.h has the
+// layouts and the arithmetic):
+//   NQW 6 -> the 384-query tiles of [q_off, Sq): 4 waves x 96 queries (3 q pairs each), longest first
+//   NQW 4 -> the head [0, 256) (q_off == 256): 4 waves x 64 queries (2 q pairs each), the same ring protocol
+// q pairs are dealt to the waves in snake order (wave w: pairs w, 7 - w, 8 + w of the workgroup's 12; head
+// tile w, 7 - w; idx.h wave_pair), so the fully masked pairs of the diagonal units spread over all waves.
+// Per kv32 row r (block rows 2r, 2r + 1) every wave runs NQW x 12 WMMA (dQ^T += K^T dS^T), operands
+// burst-loaded one row ahead into the other register set (X / Y: 12 K^T + NQW dS^T v16 operands
+// each):
+//   half-step j:  [sync + TDM issue] -> burst of row j + 1 (24 + 2 NQW tr16) -> NQW x 12 WMMA on
+//   row j
+// Ring protocol: K ring 3 x 64 rows, dS ring 3 x 2 kv32-row slots; ONE op per wave per 64-kv unit
+// (waves 0 / 3: the dS of kv32 row 2u + (w >> 1) for all NB_G q pairs of the workgroup, waves 1 /
+// 2: K rows [64u + 32 (w >> 1), +32)); wait 1 -> barrier P_{u+1} -> op(u + 3) at the odd row of
+// every unit only; <= 2 TDM ops in flight per wave; ops past the last unit are 16-B dummies. Fully
+// masked q pairs are never loaded (the dS op starts at the first stored pair, dslayout); in the masked
+// units a wave-uniform branch skips their WMMAs (they would add +-0 to a non -0 accumulator); full units
+// carry no branch. Epilogue: per 16-row sub-tile, dQ^T fragments -> this wave's row-major 16-row image
+// after the rings -> whole-line b128 stores. Every index formula: ../../idx.h (replayed on the host
+// by bounds_proof.py). No atomics, no named barriers, no clusters (prims.h); the only inline asm is an
+// empty statement that keeps operands allocated (keep_ds).
+//
+// Scheduling (needs -mllvm -amdgpu-expert-scheduling-mode, manifest extra_flags):
+// * every unit but the last: split barrier P_{u+1}: arrive after the first SPLIT_AT (x NACC / 72 on the head tile)
+//   WMMAs of run(X), wait after run(X). The ring protocol is unchanged: before the arrive the wave's op(u + 1)
+//   landed (tensorcnt 1) and its ring reads (burst(Y)) retired (dscnt 0); between arrive and wait only WMMAs;
+//   op(u + 3) and burst(X) after the wait.
+// * main-tile steady units: the operand bursts interleaved into the WMMA runs (expert scheduling: a DS read
+//   no longer waits for earlier WMMAs):
+//     region A: burst(Y, 2u + 1) under run(X) WMMAs [0, SPLIT_AT): {IL_LEAD_A WMMA} then {1 tr16, 1 WMMA} x 36
+//     region C: burst(X, 2u + 2) under run(Y):                     {IL_LEAD_C WMMA} then {1 tr16, 1 WMMA} x 36
+//   The steady loop is unrolled by the ring depth (3 units: the ring stage is a compile-time constant), so
+//   every burst address is a precomputed base VGPR + immediate and the loop carries no VALU: with only WMMAs
+//   in flight the compiler's expert-mode waits before the bursts are counted (va_vdst(k)) instead of full
+//   drains (a VALU mixed with in-flight WMMAs forces va_vdst(0)). keep_ds() holds each run's dS operands to
+//   the end of its region so the burst loads cannot be allocated to a register the newest WMMA just read.
+// * masked units: a uniform branch per q pair skips the fully masked pairs (no operand selects).
+#pragma once
+#pragma clang fp contract(off)
+
+#include "../q1/prims.h"
+#include "idx.h" // arm root (build.py: -Iinclude -I.)
+
+static_assert(DSL_VERSION == 2 && DSL_SCALED == 1,
+              "bwd_hk_dqds2 reads dslayout v2 with the scale included");
+
+static_assert(dq::lds_bytes() <= 327680 && 2 * dq::lds_bytes() > 327680,
+              "one workgroup per CU, inside the 320-KiB LDS");
+
+namespace q1 {
+// The kernel's only LDS: the rings, then the per-wave dQ sub-tile images (the name is the one the emulator
+// expects).
+__shared__ __attribute__((aligned(16))) char q1_smem[dq::lds_bytes()];
+} // namespace q1
+
+namespace dq {
+using namespace q1;
+
+#define DQ_INL __attribute__((always_inline))
+
+constexpr int SPLIT_AT = 66, IL_LEAD_A = 8, IL_LEAD_C = 4;
+Q1_DEV void split_arrive() {
+    __builtin_amdgcn_fence(3, "workgroup", "local"); // release
+    __builtin_amdgcn_s_barrier_signal(-1);
+}
+Q1_DEV void split_wait() {
+    __builtin_amdgcn_s_barrier_wait(-1);
+    __builtin_amdgcn_fence(2, "workgroup", "local"); // acquire
+}
+template <int L, int R, int NT, int NW> Q1_DEV void sgb_interleave() {
+    static_assert(L + NT * R <= NW, "interleave pattern longer than the WMMA run");
+    if constexpr (L > 0) Q1_SGB(0x008, L);
+    sfor<0, NT>([&](auto) DQ_INL {
+        Q1_SGB(0x100, 1);
+        Q1_SGB(0x008, R);
+    });
+    if constexpr (NW - L - NT * R > 0) Q1_SGB(0x008, NW - L - NT * R);
+}
+// idx.h ds_zero without the short circuit (cshift >= 0, as the plan requires): r >= n32 || qp <
+// dsl_qp_first(2r) with dsl_qp_first(2r) = causal ? max(0, r - cshift / 32) : 0
+Q1_DEV bool ds_zero_branchless(int qp, int r, int n32, int cshift, int causal) {
+    const int f   = r - cshift / 32;
+    const int qpf = (causal != 0) & (f > 0) ? f : 0;
+    return (bool) ((int) (r >= n32) | (int) (qp < qpf));
+}
+
+struct TdmDesc { // one TDM op's descriptor groups 0 / 1 (prepared before the barrier, issued after it)
+    u32x4 g0;
+    u32x8 g1;
+};
+
+template <int NQW> struct OpSet {
+    bf16x16 kt[NDT]; // A operands: K^T of the 12 d tiles
+    bf16x16 ds[NQW]; // B operands: dS^T of the wave's 16-query sub-tiles
+};
+// emits no instruction: the dS operands of S stay allocated (live) up to this point
+template <int NQW> Q1_DEV void keep_ds(const OpSet<NQW> &S) {
+    static_assert(NQW == 6, "main tile only");
+    asm volatile("" ::"v"(S.ds[0]), "v"(S.ds[1]), "v"(S.ds[2]), "v"(S.ds[3]), "v"(S.ds[4]), "v"(S.ds[5]));
+}
+
+template <int NQW>
+Q1_DEV void dqds_body(const __bf16 *DS, const __bf16 *K, __bf16 *DQ, int Sq, int Skv, int Hq,
+                      int Hkv, int G, int nkvt, int cshift, int causal, int q0g, int HG) {
+    constexpr int NB_G = nbg(NQW);
+    constexpr int NACC = NQW * NDT;
+
+    // ---- identity
+    // ----------------------------------------------------------------------------------------------
+    const int  tid  = thread_id_x();
+    const int  lane = tid % WAVE;
+    const int  wv   = readfirstlane(tid / WAVE); // uniform (SGPR) wave index 0..3
+    const bool dsw  = c_role_ds(wv); // uniform: this wave issues the dS ops (else the K ops)
+    const int  hh   = c_half(wv);    // its kv32 row / K half inside a unit
+    const int  hb   = head_hb(block_id_x(), block_id_z(), HG); // = bat*Hq + qh = dslayout's bh
+    const int  bat  = head_bat(hb, Hq);
+    const int  qh   = head_qh(hb, bat, Hq);
+    const int  hkv  = head_kv(qh, G);
+    const int  qp0g = tile_qp0(q0g);
+    const int  n32  = kv_n32(q0g, NQW, cshift, nkvt, causal);
+    const int  nu   = n_units(n32);
+    const int  nfu  = n_full_units(qp0g, cshift, nu, causal);
+
+    lds_char *const lds = (lds_char *) q1_smem;
+
+    // ---- operand bursts
+    // ----------------------------------------------------------------------------------------- K^T
+    // of a kv32 row whose K image (480-B rows) starts at LDS offset kimg
+    auto burst_k = [&](OpSet<NQW> &S, int kimg) DQ_INL {
+        const int kb = kimg + c_k_lane(lane);
+        sfor<0, NDT>([&](auto D) DQ_INL {
+            constexpr int dt = decltype(D)::value;
+            S.kt[dt] = cat16(tr16(lds, kb + c_k_imm(dt, 0)), tr16(lds, kb + c_k_imm(dt, 1)));
+        });
+    };
+    // dS^T of the wave's sub-tiles: row-0 image of the workgroup's pair 0 at r0, row-1 image at r1
+    auto burst_ds = [&](OpSet<NQW> &S, int r0, int r1) DQ_INL {
+        const int d0 = r0 + ds_lane(lane);
+        const int d1 = r1 + ds_lane(lane);
+        sfor<0, NQW>([&](auto Q) DQ_INL {
+            constexpr int h  = decltype(Q)::value;
+            const int     po = wave_pair(wv, h / 2, NQW) * DSI_BLK_B + ds_half(h % 2);
+            S.ds[h]          = cat16(tr16(lds, d0 + po), tr16(lds, d1 + po));
+        });
+    };
+    // the whole burst of kv32 row r (its stages hold landed, published data)
+    auto burst = [&](OpSet<NQW> &S, int r) DQ_INL {
+        const int u = r / 2, h = r % 2;
+        const int slot = c_dsslot(u, NQW, h); // the op of dS wave h holds kv32 row 2u + h
+        const int sh   = dsop_sh(NB_G, dsop_nv(qp0g, NB_G, r, cshift, causal));
+        burst_k(S, c_kstage(u) + h * C_KHALF_B);
+        burst_ds(S, slot, ds_row1(slot, NB_G, sh));
+    };
+
+    // ---- the NQW x 12 WMMA run of one kv32 row
+    f32x8 acc[NACC];
+    sfor<0, NACC>([&](auto I) DQ_INL { acc[decltype(I)::value] = zero8(); });
+    // the wave's k-th q pair holds no attended entry at kv32 row r (wave-uniform)
+    auto pair_zero = [&](int k, int r) DQ_INL {
+        return ds_zero_branchless(qp0g + wave_pair(wv, k, NQW), r, n32, cshift, causal);
+    };
+    // the WMMAs [LO, HI) of a run; MASK (masked units): a uniform branch per q pair skips the pair's WMMAs when
+    // it is fully masked (its operands were never loaded)
+    auto run_part = [&](const OpSet<NQW> &S, auto MASK, int r, auto LO, auto HI) DQ_INL {
+        constexpr int lo = decltype(LO)::value, hi = decltype(HI)::value;
+        if constexpr (decltype(MASK)::value != 0) {
+            sfor<0, NQW / 2>([&](auto Kp) DQ_INL {
+                constexpr int k  = decltype(Kp)::value;
+                constexpr int a  = 2 * k * NDT > lo ? 2 * k * NDT : lo;
+                constexpr int bb = 2 * (k + 1) * NDT < hi ? 2 * (k + 1) * NDT : hi;
+                if constexpr (a < bb) {
+                    if (!pair_zero(k, r)) {
+                        sfor<a, bb>([&](auto I) DQ_INL {
+                            constexpr int i = decltype(I)::value, h = i / NDT, dt = i % NDT;
+                            acc[i] = wmma_bf16(S.kt[dt], S.ds[h], acc[i]);
+                        });
+                    }
+                }
+            });
+            Q1_SCHED_BARRIER();
+            return;
+        }
+        sfor<lo, hi>([&](auto I) DQ_INL {
+            constexpr int i = decltype(I)::value, h = i / NDT, dt = i % NDT;
+            acc[i] = wmma_bf16(S.kt[dt], S.ds[h], acc[i]);
+        });
+        Q1_SCHED_BARRIER();
+    };
+    auto run = [&](const OpSet<NQW> &S, auto MASK, int r) DQ_INL {
+        run_part(S, MASK, r, ic<0>{}, ic<NACC>{});
+    };
+    // the WMMAs [LO, HI) of a steady run (no trailing sched_barrier: interleaved regions)
+    auto run_steady = [&](const OpSet<NQW> &S, auto LO, auto HI) DQ_INL {
+        constexpr int lo = decltype(LO)::value, hi = decltype(HI)::value;
+        sfor<lo, hi>([&](auto I) DQ_INL {
+            constexpr int i = decltype(I)::value, h = i / NDT, dt = i % NDT;
+            acc[i] = wmma_bf16(S.kt[dt], S.ds[h], acc[i]);
+        });
+    };
+
+    const unsigned           lds0  = lds_addr(lds);
+    const unsigned long long ga_ds = (unsigned long long) DS;
+    const unsigned long long ga_k  = (unsigned long long) K;
+    const long long          kst   = k_stride_el(Hkv);
+    // dummy op source: K[bat, 0, hkv, 0..7] (always inside K)
+    const unsigned long long ga_dummy =
+        ga_k + (unsigned long long) (k_el(bat, Skv, 0, Hkv, hkv, 0) * 2);
+
+    // ---- one TDM op (bwd_hk_q1's word layout); every field is wave-uniform
+    auto desc = [&](int lds_off, unsigned long long ga, unsigned w0, unsigned tdim1, unsigned tile0,
+                    unsigned tile1, unsigned long long stride_el) DQ_INL -> TdmDesc {
+        TdmDesc d;
+        d.g0 = u32x4{1u, lds0 + (unsigned) lds_off, (unsigned) ga,
+                     (unsigned) (ga >> 32) | 0x80000000u};
+        d.g1 = u32x8{w0,
+                     (TDIM0 & 0xFFFFu) << 16,
+                     ((tdim1 & 0xFFFFu) << 16) | (TDIM0 >> 16),
+                     ((tdim1 >> 16) & 0xFFFFu) | (tile0 << 16),
+                     tile1,
+                     (unsigned) stride_el,
+                     (unsigned) (stride_el >> 32) & 0xFFFFu,
+                     0u};
+        return d;
+    };
+    // ---- this wave's role op of unit u (16-B dummy past the last unit). REAL = ic<1>: the caller guarantees
+    // u + 3 < nu (the steady-state loop): no dummy selects and nv >= 1 (rows < n32), so no runtime check keeps
+    // the steady body branch-free. Branch-free SALU (the *_hot forms of idx.h, the role a wave-uniform select)
+    // so the descriptor of the next barrier can be prepared inside the current WMMA run.
+    const int       nqp    = dsl_nqp(Sq);
+    const int       mshift = cshift / 32;
+    const long long nblk   = dsl_nblk_bh(Sq, Skv, causal);
+    auto            c_desc = [&](int u, auto REAL) DQ_INL -> TdmDesc {
+        const bool live = decltype(REAL)::value != 0 || u < nu;
+        // K role: rows [64u + 32 hh, +32), all 192 columns
+        const int       kv0 = c_kop_kv0(u, hh);
+        const long long gel = k_el(bat, Skv, kv0, Hkv, hkv, 0);
+        const TdmDesc   dk =
+            desc(c_kop_lds(u, hh), live ? ga_k + (unsigned long long) (gel * 2) : ga_dummy, BK_W0,
+                 live ? (unsigned) c_kop_dim1(Skv, u, hh) : 1u, live ? (unsigned) D_QK : 8u,
+                 live ? (unsigned) KV32 : 1u, live ? (unsigned long long) kst : 0ull);
+        // dS role: kv32 row 2u + hh x the workgroup's stored q pairs
+        const int       r    = 2 * u + hh;
+        const int       slot = c_dsslot(u, NQW, hh);
+        const int       nv   = dsop_nv_hot(qp0g, NB_G, r, mshift, causal);
+        const bool      go   = decltype(REAL)::value != 0 || (live && nv >= 1);
+        const long long src = dsop_src_el_hot((long long) hb, nblk, r, qp0g, nqp, mshift, causal);
+        const long long str = dsop_stride_el_hot(r, nqp, mshift, causal);
+        const TdmDesc   dd  = desc(go ? dsop_lds(slot, NB_G, nv) : slot,
+                                go ? ga_ds + (unsigned long long) (src * 2) : ga_dummy, DS_W0,
+                                go ? 2u : 1u, go ? (unsigned) (nv * DS_BLK_EL) : 8u, go ? 2u : 1u,
+                                go ? (unsigned long long) str : 0ull);
+        TdmDesc d;
+        d.g0 = dsw ? dd.g0 : dk.g0;
+        d.g1 = dsw ? dd.g1 : dk.g1;
+        return d;
+    };
+    auto issue   = [&](const TdmDesc &d) DQ_INL { tdm_load(d.g0, d.g1); };
+    auto c_issue = [&](int u) DQ_INL { issue(c_desc(u, ic<0>{})); };
+
+    // ---- one 64-kv unit: rows 2u (set X, burst into Y) and 2u + 1 (set Y, burst into X unless
+    // LAST) --------------
+    OpSet<NQW> X, Y;
+    // main-tile steady unit u (interleaved regions A / C); BY / BX issue the bursts of rows 2u + 1 / 2u + 2
+    auto steady_unit = [&](int u, auto BY, auto BX) DQ_INL {
+        constexpr int NS = SPLIT_AT < NACC ? SPLIT_AT : NACC;
+        // region A: burst Y (row 2u + 1, unit u's stages) under run X part 1, the descriptor SALU too
+        BY();
+        const TdmDesc dn = c_desc(u + 3, ic<1>{});
+        run_steady(X, ic<0>{}, ic<NS>{});
+        sgb_interleave<IL_LEAD_A, 1, 24 + 2 * NQW, NS>();
+        Q1_SCHED_BARRIER();
+        keep_ds(X);
+        Q1_WAIT_TENSORCNT(C_TW);
+        Q1_WAIT_DSCNT(0);
+        split_arrive(); // P_{u+1} arrive: op(u+1) landed, unit u's ring reads retired
+        Q1_SCHED_BARRIER();
+        run_steady(X, ic<NS>{}, ic<NACC>{});
+        Q1_SCHED_BARRIER();
+        split_wait(); // P_{u+1}: unit u+1 published, unit u's stages free
+        Q1_SCHED_BARRIER();
+        issue(dn); // op(u + 3) into unit u's stages
+        Q1_SCHED_BARRIER();
+        // region C: burst X (row 2u + 2, unit u + 1's stages) under run Y
+        BX();
+        run_steady(Y, ic<0>{}, ic<NACC>{});
+        sgb_interleave<IL_LEAD_C, 1, 24 + 2 * NQW, NACC>();
+        Q1_SCHED_BARRIER();
+        keep_ds(Y);
+    };
+
+    auto unit = [&](int u, auto MASK, auto LAST, auto REAL) DQ_INL {
+        constexpr bool last = decltype(LAST)::value != 0;
+        const int      r0 = 2 * u, r1 = 2 * u + 1;
+        if constexpr (!last && decltype(MASK)::value == 0 && NQW == MAIN_NQW) {
+            steady_unit(u, [&]() DQ_INL { burst(Y, r1); }, [&]() DQ_INL { burst(X, r1 + 1); });
+            return;
+        }
+        if constexpr (!last) {
+            // head-tile steady units and all masked units: split barrier only, arrive after SPLIT_AT * NACC / 72
+            // WMMAs
+            constexpr int NS = SPLIT_AT * NACC / (MAIN_NQW * NDT);
+            burst(Y, r1);
+            Q1_SCHED_BARRIER();
+            const TdmDesc dn = c_desc(u + 3, REAL);
+            run_part(X, MASK, r0, ic<0>{}, ic<NS>{});
+            Q1_WAIT_TENSORCNT(C_TW);
+            Q1_WAIT_DSCNT(0);
+            split_arrive();
+            Q1_SCHED_BARRIER();
+            run_part(X, MASK, r0, ic<NS>{}, ic<NACC>{});
+            split_wait();
+            Q1_SCHED_BARRIER();
+            issue(dn);
+            Q1_SCHED_BARRIER();
+            burst(X, r1 + 1);
+            Q1_SCHED_BARRIER();
+            run(Y, MASK, r1);
+            return;
+        }
+        // the last unit: no barrier, no op, no burst past the end
+        burst(Y, r1);
+        Q1_SCHED_BARRIER();
+        run(X, MASK, r0);
+        run(Y, MASK, r1);
+    };
+
+    // ---- prologue
+    // ---------------------------------------------------------------------------------------------
+    c_issue(0);
+    c_issue(1);
+    Q1_SCHED_BARRIER();
+    Q1_WAIT_TENSORCNT(C_TW);
+    wg_sync(); // P_0: unit 0 published
+    c_issue(2);
+    Q1_SCHED_BARRIER();
+    burst(X, 0);
+    Q1_SCHED_BARRIER();
+
+    // ---- units: full ones (no branches), masked ones, then the last unit (masked form, no burst
+    // past the end) ------ The steady-state loop also requires every op it issues to be real (u + 3
+    // < nu): causal main tiles have exactly 6 masked units, the head 4, so this is the full-unit
+    // loop itself; the generic body (skips + dummies) runs the rest.
+    const int nloop = nu - 1;
+    const int nf    = steady_units(nfu, nu);
+    int       u     = 0;
+    if constexpr (NQW == MAIN_NQW) {
+        // the unrolled steady units burst row 2u + 2 assuming all of its pairs are stored (sh = 0); for the last
+        // steady unit that row belongs to the first masked unit, whose stored pairs start mid-row when
+        // (Skv - Sq) % 64 == 32: then the last steady unit runs as a generic unit (its bursts handle sh) below
+        const int nfs = ((cshift & 63) == 32 && nf > 0) ? nf - 1 : nf;
+        // steady units, unrolled by the ring depth: precomputed burst bases, K stages 0 / 1 off kb01
+        // (immediates <= 54176), stage 2 off kb2; dS stage s off db[s] (the wave's pair 0; pair 2 = pair 0 + 8
+        // blocks) and db1[s] (pair 1)
+        const int kb01 = c_k_lane(lane);
+        const int kb2  = kb01 + 2 * C_KSTG_B;
+        const int dl   = ds_lane(lane) + wave_pair(wv, 0, NQW) * DSI_BLK_B;
+        const int d1o  = (wave_pair(wv, 1, NQW) - wave_pair(wv, 0, NQW)) * DSI_BLK_B;
+        int       db[3], db1[3];
+        sfor<0, 3>([&](auto Sg) DQ_INL {
+            constexpr int s = decltype(Sg)::value;
+            db[s]           = dl + C_DS_OFF + s * c_dsstg_b(NQW);
+            db1[s]          = db[s] + d1o;
+        });
+        // the burst of kv32 row 2u + H of a steady unit u with u % 3 == s (all NB_G pairs stored: sh = 0)
+        auto burst_stage = [&](OpSet<NQW> &Sx, auto Sg, auto Hg) DQ_INL {
+            constexpr int s = decltype(Sg)::value, H = decltype(Hg)::value;
+            constexpr int ko = (s == 2 ? 0 : s * C_KSTG_B) + H * C_KHALF_B;
+            const int     kb = s == 2 ? kb2 : kb01;
+            sfor<0, NDT>([&](auto D) DQ_INL {
+                constexpr int dt = decltype(D)::value;
+                Sx.kt[dt] = cat16(tr16(lds, kb + ko + c_k_imm(dt, 0)), tr16(lds, kb + ko + c_k_imm(dt, 1)));
+            });
+            constexpr int so = H * c_slot_b(NQW);
+            constexpr int r1 = NB_G * DSI_BLK_B;
+            sfor<0, NQW>([&](auto Q) DQ_INL {
+                constexpr int h = decltype(Q)::value, k = h / 2;
+                static_assert(wave_pair(0, 2, MAIN_NQW) - wave_pair(0, 0, MAIN_NQW) == 8, "pair 2 = pair 0 + 8");
+                const int     base = k == 1 ? db1[s] : db[s];
+                constexpr int po   = (k == 2 ? 8 * DSI_BLK_B : 0) + ds_half(h % 2);
+                Sx.ds[h] = cat16(tr16(lds, base + so + po), tr16(lds, base + so + r1 + po));
+            });
+        };
+        auto unit_stage = [&](int uu, auto Sg) DQ_INL {
+            constexpr int s  = decltype(Sg)::value;
+            constexpr int s1 = (s + 1) % 3;
+            steady_unit(uu, [&]() DQ_INL { burst_stage(Y, ic<s>{}, ic<1>{}); },
+                        [&]() DQ_INL { burst_stage(X, ic<s1>{}, ic<0>{}); });
+        };
+        for (; u + 3 <= nfs; u += 3) {
+            unit_stage(u, ic<0>{});
+            unit_stage(u + 1, ic<1>{});
+            unit_stage(u + 2, ic<2>{});
+        }
+        if (u < nfs) { // nfs % 3 == 1 or 2 (u % 3 == 0 here)
+            unit_stage(u, ic<0>{});
+            ++u;
+            if (u < nfs) {
+                unit_stage(u, ic<1>{});
+                ++u;
+            }
+        }
+    }
+    for (; u < nf; ++u) // head tile, and a main tile's last steady unit when (Skv - Sq) % 64 == 32
+        unit(u, ic<0>{}, ic<0>{}, ic<1>{});
+    for (u = nf; u < nloop; ++u)
+        unit(u, ic<1>{}, ic<0>{}, ic<0>{});
+    unit(nloop, ic<1>{}, ic<1>{}, ic<0>{});
+
+    // ---- exit: every wave's TDM landed (incl. dummies), every ring read retired
+    Q1_WAIT_TENSORCNT(0);
+    wg_sync();
+    const rsrc_t g_dq = make_rsrc(DQ, DQ_EXTENT_B, RSRC_FLAGS);
+    Q1_SCHED_BARRIER();
+    // dQ epilogue, per 16-row sub-tile: 12 dQ^T fragments (lane = q row, 8 consecutive d) -> this wave's
+    // row-major image after the rings -> whole 128-B lines back, one buffer_store_b128 per 4 lines' worth of lanes
+    const int img = epi_img(wv);
+    sfor<0, NQW>([&](auto Q) DQ_INL {
+        constexpr int h = decltype(Q)::value;
+        sfor<0, NDT>([&](auto D) DQ_INL {
+            constexpr int dt = decltype(D)::value;
+            lds_st(lds, img + epi_w_lane(lane) + epi_w_imm(dt), cvt_bf16x8(acc[h * NDT + dt]));
+        });
+        const int qs = subtile_q0(q0g, wv, h, NQW);
+        sfor<0, 4>([&](auto RB) DQ_INL {
+            constexpr int rb = decltype(RB)::value;
+            sfor<0, D_QK / DQ_LINE_EL>([&](auto LI) DQ_INL {
+                constexpr int li = decltype(LI)::value;
+                const bf16x8  vv = lds_ld(lds, img + epi_r_lane(lane) + epi_r_imm(rb, li));
+                buf_st128(g_dq, 16 * dq_vec8(bat, Sq, Hq, qh, qs, lane, rb, li), vv);
+            });
+        });
+    });
+}
+
+// The kernel entry: grid (HG, ntile + nhead, B*Hq/HG), block 128.
+Q1_DEV void dqds_kernel(const __bf16 *DS, const __bf16 *K, __bf16 *DQ, int Sq, int Skv, int Hq,
+                        int Hkv, int G, int nkvt, int cshift, int causal, int q_off, int ntile,
+                        int HG) {
+    lock_simd(); // SCHED_MODE.DISABLE_XDL_ARB_STALL, as bwd_r6_a's k_dqds192 / k_dqg96 / k_dqds_b
+    const int gy = block_id_y();
+    if (!tile_is_head(gy, ntile)) {
+        dqds_body<MAIN_NQW>(DS, K, DQ, Sq, Skv, Hq, Hkv, G, nkvt, cshift, causal,
+                            tile_q0g(q_off, ntile, gy), HG);
+    } else {
+        dqds_body<HEAD_NQW>(DS, K, DQ, Sq, Skv, Hq, Hkv, G, nkvt, cshift, causal, head_q0g(q_off),
+                            HG);
+    }
+}
+
+} // namespace dq
diff -ruN a/r8gen/hip/include/dqds/dslayout.h b/r8gen/hip/include/dqds/dslayout.h
--- a/r8gen/hip/include/dqds/dslayout.h	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/hip/include/dqds/dslayout.h	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,125 @@
+/***************************************************************************************************
+ * Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * See LICENSE for license information.
+ **************************************************************************************************/
+
+// dslayout.h -- the S1 dS^T scratch contract, version 2 (v1 + fragment-native blocks).
+//
+// Owner: bwd_hk_k1ds (writer, k_dkdv64ds). Consumer: bwd_hk_dqds (reader, k_dqds), which carries a
+// BYTE-IDENTICAL copy of this file and checks its sha256 against the writer's. Any change is a new
+// version (DSL_VERSION), agreed by both sides before either builds against it.
+//
+// WHAT is stored: exactly the bf16 values that feed k_dkdv64's dK WMMA (dK^T += Q^T dS, the a_dsk B
+// operand):
+//     dS[q][kv] = bf16( P[q][kv] * fma(dP[q][kv], scale, -scale * delta[q]) ) (DSL_SCALED == 1)
+//     P[q][kv]  = exp2( fma(S[q][kv], scale * LOG2E, -LOG2E * lse[q]) ),  S = Q K^T, dP = dO V^T
+//     (fp32 WMMA)
+// and exactly +-0 where the causal mask removes the entry (kv > q + cshift, cshift = Skv - Sq:
+// bottom-right). DSL_SCALED == 0 is reserved for a writer that drops the scale (dS' = P * (dP -
+// delta)); its reader then multiplies by scale in fp32. Both sides static_assert the value they
+// were written for.
+//
+// WHERE (every offset in BYTES and computed in int64; requires Sq % 32 == 0 and Skv % 32 == 0, so
+// cshift is a multiple of 32):
+//   * one region per (batch, q head), bh = bat * Hq + qh, regions back to back, dsl_nblk_bh()
+//   blocks each
+//     (the e2e fold [1, s, b*h, d] and the b2h128 launch give the same bh order);
+//   * inside a region, kv16 rows kt = 0 .. Skv/16 - 1 in order; row kt holds the q pairs
+//     qp = dsl_qp_first(kt) .. Sq/32 - 1 in order ("packed causal": the leading q pairs of a row
+//     are fully masked for all 16 kv rows and are NOT stored; non-causal: dsl_qp_first == 0, a
+//     dense rectangle);
+//   * a block (bh, kt, qp) is the [16 kv][32 q] bf16 tile in the order of the writer's dK B operand
+//     (version 2, "fragment-native"): 64 chunks of 16 B, chunk (kv, c) = the 8 queries [8 c, 8 c + 8) of kv
+//     row kv (kv = kv row - 16 kt in [0, 16), c in [0, 4)) at block byte dsl_chunk(kv, c) = (c / 2) * 512 +
+//     ((c % 2) * 16 + kv) * 16, so element (kv, q), q = query - 32 qp in [0, 32), sits at dsl_chunk(kv, q / 8)
+//     + (q % 8) * 2. A writer lane (kv row r = lane % 16, half h = lane / 16) holds chunks (r, h) and (r, h + 2)
+//     in its dK operand (dwords 0..3, 4..7) and stores them at lane * 16 and 512 + lane * 16: two whole 512-B
+//     stores per block, no cross-lane regroup. 1024 B per block. (v1: row-major, element at kv * 64 + q * 2.)
+//   dsl_qp_first(kt) = causal ? max(0, floor(kt / 2) - cshift / 32) : 0 is the first q pair with an
+//   attended entry (16 kt <= 32 qp + 31 + cshift); it is <= Sq/32 - 1 for every kt < Skv/16, so
+//   every row is non-empty. Size per region (prod s4096 causal): 16512 blocks = 16.9 MB; b2
+//   h128: 4.33 GB (the dense [kt][qp] rectangle of bwd_r6_b..r7 was 8.59 GB).
+// Granularity kv16 (not kv32) so a writer with 48 kv rows per wave (k3) exports whole blocks too.
+//
+// Reader hint: for a fixed q pair the blocks of kv rows 2j and 2j + 1 are dsl_row_len(2j) blocks
+// apart (the two rows share qp_first), so a [2 rows][n q pairs] slab is one 2-D tile of row stride
+// dsl_row_len(2j) * 1024 B.
+#pragma once
+#include <stdint.h>
+#ifndef __host__
+#define __host__
+#endif
+#ifndef __device__
+#define __device__
+#endif
+#define DSL_FN static inline constexpr __host__ __device__
+
+#define DSL_VERSION 2
+#define DSL_SCALED 1   // dS carries the softmax scale (the dK operand as k_dkdv64 consumes it)
+#define DSL_KV 16      // kv rows per block
+#define DSL_Q 32       // queries per block (one q pair of 16-row tiles)
+#define DSL_ROW_B 64   // bytes of 4 chunks (the readers' TDM pad interval; v1: one kv row of 32 bf16)
+#define DSL_BLK_B 1024 // bytes of one block
+
+DSL_FN int dsl_nqp(int Sq) {
+    return Sq / DSL_Q;
+} // q pairs
+DSL_FN int dsl_nkt(int Skv) {
+    return Skv / DSL_KV;
+} // kv16 rows
+// first stored q pair of kv16 row kt (kt >= 0; cshift = Skv - Sq, a multiple of 32)
+DSL_FN int dsl_qp_first(int kt, int cshift, int causal) {
+    const int f = kt / 2 - cshift / 32;
+    return (causal != 0 && f > 0) ? f : 0;
+}
+DSL_FN int dsl_row_len(int kt, int Sq, int cshift, int causal) {
+    return dsl_nqp(Sq) - dsl_qp_first(kt, cshift, causal);
+}
+// sum_{k < K} floor(k / 2), K >= 0
+DSL_FN int64_t dsl_tri(int64_t K) {
+    const int64_t p = K / 2;
+    return p * (p - 1) + (K % 2) * p;
+}
+// sum_{k < K} dsl_qp_first(k): the blocks the packing removes from rows 0 .. K - 1
+DSL_FN int64_t dsl_skip(int K, int cshift, int causal) {
+    const int64_t m  = cshift / 32;
+    const int64_t Kl = K;
+    if (causal == 0 || K <= 0)
+        return 0;
+    if (m <= 0)
+        return dsl_tri(Kl) - m * Kl;
+    return Kl > 2 * m ? dsl_tri(Kl - 2 * m) : 0;
+}
+// blocks before kv16 row kt inside one region
+DSL_FN int64_t dsl_row_off(int kt, int Sq, int cshift, int causal) {
+    return (int64_t) kt * dsl_nqp(Sq) - dsl_skip(kt, cshift, causal);
+}
+// blocks of one (batch, q head) region
+DSL_FN int64_t dsl_nblk_bh(int Sq, int Skv, int causal) {
+    return dsl_row_off(dsl_nkt(Skv), Sq, Skv - Sq, causal);
+}
+// global block index of (bh, kt, qp); only qp >= dsl_qp_first(kt) is stored
+DSL_FN int64_t dsl_blk(int64_t bh, int kt, int qp, int Sq, int Skv, int causal) {
+    return bh * dsl_nblk_bh(Sq, Skv, causal) + dsl_row_off(kt, Sq, Skv - Sq, causal) +
+           (int64_t) (qp - dsl_qp_first(kt, Skv - Sq, causal));
+}
+// block byte of chunk (kv row kv in [0, 16), query chunk c in [0, 4): queries [8 c, 8 c + 8))
+DSL_FN int dsl_chunk(int kv, int c) {
+    return (c >> 1) * 512 + ((c & 1) * 16 + kv) * 16;
+}
+// byte of element (kv row kvr, query qr) of head bh (kvr in row kt = kvr / 16, qr in pair qp = qr /
+// 32)
+DSL_FN int64_t dsl_byte(int64_t bh, int kvr, int qr, int Sq, int Skv, int causal) {
+    return dsl_blk(bh, kvr / DSL_KV, qr / DSL_Q, Sq, Skv, causal) * DSL_BLK_B +
+           (int64_t) dsl_chunk(kvr % DSL_KV, (qr % DSL_Q) / 8) + (int64_t) (qr % 8) * 2;
+}
+// is (kv16 row kt, q pair qp) stored?
+DSL_FN bool dsl_stored(int kt, int qp, int Sq, int Skv, int causal) {
+    return qp >= dsl_qp_first(kt, Skv - Sq, causal) && qp < dsl_nqp(Sq) && kt >= 0 &&
+           kt < dsl_nkt(Skv);
+}
+// total scratch bytes for B batches x Hq q heads
+DSL_FN int64_t dsl_total_bytes(int B, int Hq, int Sq, int Skv, int causal) {
+    return (int64_t) B * Hq * dsl_nblk_bh(Sq, Skv, causal) * DSL_BLK_B;
+}
diff -ruN a/r8gen/hip/include/dqds/idx.h b/r8gen/hip/include/dqds/idx.h
--- a/r8gen/hip/include/dqds/idx.h	1970-01-01 00:00:00.000000000 +0000
+++ b/r8gen/hip/include/dqds/idx.h	2026-10-29 04:49:37.000000000 +0000
@@ -0,0 +1,518 @@
+/***************************************************************************************************
+ * Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * See LICENSE for license information.
+ **************************************************************************************************/
+
+// idx.h -- every index formula of bwd_hk_dqds2's recompute-free dQ kernel k_dqds_c (main 384-query
+// tiles + the merged 256-query head tile), in ONE place.
+//
+//   dQ[q, :] = sum_kv dS[q, kv] K[kv, :]   (dS read from the S1 scratch in the dslayout v2
+//   contract, scale included)
+//
+// constexpr __host__ __device__ functions: the HIP kernel (src/k_dqds_c.hip via
+// include/dqds/dqds_impl.h) computes every global offset, LDS address, TDM descriptor field, ring
+// stage, loop bound and zeroing predicate through these functions, and bounds_proof.py compiles
+// THIS file for x86 and replays them over every proof shape via ctypes. dS offsets come only from
+// include/dqds/dslayout.h (the writer's file, byte-identical copy, sha256 checked by
+// bounds_proof.py and the gates).
+//
+// What changed against bwd_hk_dqds variant B (k_dqds_b, the base of this file):
+//   * 4 waves per workgroup (block 128, 1 wave per SIMD, ONE workgroup per CU: LDS 276480 B): the
+//   main tile is 384
+//     queries (4 x 96, NQW 6) and shares ONE K ring, so every K tile moved by the TDM feeds 384
+//     queries instead of 192 (K bytes per call / 2); the head tile [0, 256) is 4 x 64 queries (NQW
+//     4); Sq % 384 must be 0 or 256.
+//   * role-split TDM issue, ONE op per wave per 64-kv unit: waves 0 / 3 move dS kv32 row 2u + (w >>
+//   1) for all NB_G q
+//     pairs of the workgroup (2-D, <= 24 KB), waves 1 / 2 move K rows [64u + 32 (w >> 1), +32) (12
+//     KB). Each CU TDM engine moves one dS op + one K op per unit (36 KB, balanced) whether warp
+//     parity (HK cdna5 global_to_shared.cuh: warps {0, 2} share one engine, {1, 3} the other) or
+//     the SIMD pair picks it.
+//   * K ring and dS ring both 3 stages: every op is issued 2 units ahead (B: K 1 unit, dS 2), wait
+//   1 before every
+//     barrier, <= 2 TDM ops in flight per wave.
+// The per-output accumulation (kv32 rows ascending, one WMMA per (sub-tile, d tile, kv32 row), the
+// same A / B operand bytes, fully masked q pairs' operands selected to +0) is k_dqds_b's: dq is
+// bitwise k_dqds_b's (the extra zero-operand WMMAs of the taller tile add +-0 to a non -0
+// accumulator).
+//
+// WMMA orientation (dQ^T, bwd_hk_q1's): acc[qh][dt] (16 d x 16 q) += A (16 d x 32 kv) * B (32 kv x
+// 16 q) with
+//   A = K^T  : tr16 of the K image [kv][d]  (lane = d row,   K-dim = kv), bwd_hk_q1's bks()
+//   B = dS^T : tr16 of the dS block images [kv16][q32] (lane = q column, K-dim = kv: kv 0..15 from
+//   block row 2r,
+//              kv 16..31 from block row 2r + 1)
+//
+// Integer semantics as bwd_hk_q1's idx.h (floordiv for possibly negative dividends; i32 where the
+// kernel uses i32, the proof re-checks every value in Python integers). Mutation hooks: DQ_MUT
+// selects one deliberately wrong formula (bounds_proof.py negative controls); never defined in a
+// kernel build.
+#pragma once
+
+#if defined(__HIP__) || defined(__HIPCC__) || defined(__CUDACC__)
+#define DQ_HD __host__ __device__ __attribute__((always_inline))
+#else
+#define DQ_HD
+#endif
+
+#ifndef DQ_MUT
+#define DQ_MUT 0
+#endif
+
+#include "dqds/dslayout.h"
+
+namespace dq {
+
+// ---- layout constants
+// -----------------------------------------------------------------------------------------
+constexpr int D_QK      = 192;       // q/k head dim (dq row)
+constexpr int DV8_QK    = D_QK / 8;  // vec8 tiles per dq row (24)
+constexpr int NDT       = D_QK / 16; // 16-wide d tiles of dQ^T (12)
+constexpr int WAVE      = 32;
+constexpr int NWAVE     = 4;            // waves per workgroup (both tile kinds), 1 per SIMD
+constexpr int BLOCK     = NWAVE * WAVE; // 128 threads
+constexpr int KV32      = 32; // kv rows per WMMA step (one "kv32 row" r = kv16 block rows 2r, 2r+1)
+constexpr int MAIN_NQW  = 6;  // main tile: 4 waves x 96 queries (6 sub-tiles of 16) = 384
+constexpr int HEAD_NQW  = 4;  // merged head tile: 4 waves x 64 queries = 256 (q_off == 256 only)
+constexpr int MAIN_ROWS = 16 * MAIN_NQW * NWAVE; // 384
+constexpr int HEAD_ROWS = 16 * HEAD_NQW * NWAVE; // 256
+constexpr int DS_BLK_EL = DSL_BLK_B / 2;         // 512 bf16 per dslayout block [16 kv][32 q]
+constexpr int DSI_ROW_B =
+    DSL_ROW_B + 16; // LDS row of a dS block image: 64 B data (4 dslayout v2 chunks) + 16 B pad (80 B)
+constexpr int       DSI_BLK_B    = DSL_KV * DSI_ROW_B; // one block image (1280 B)
+constexpr unsigned  TDIM0        = 0x7FFFFFFFu; // inner extent: never clamps (bwd_hk_q1's TDM_DIM0)
+constexpr int       DQ_IMG_ROW_B = 400; // dQ epilogue image row (bwd_hk_q1: 384 B data + 16 B pad)
+constexpr int       DQ_LINE_EL   = 64;  // bf16 per 128-B dq line
+constexpr long long DQ_EXTENT_B  = 1LL
+                                  << 30; // dq buffer resource extent (impl asserts q/dq <= 1 GiB)
+constexpr int RSRC_FLAGS = 0x27000;      // bwd_hk_q1's V# word 3
+
+// ---- the rings (unit u = kv rows [64u, 64u + 64) = kv32 rows 2u, 2u + 1; ONE workgroup barrier
+// P_u per unit) ------ K ring: C_KDEPTH stages of 64 rows x 480 B (k_dqds_b's K image: 192 columns,
+// 32 B pad every 128 B, so the 16 rows x
+//   2 column halves of a half-wave K^T tr16 hit 16 distinct 4-bank groups); half h = rows [32h, 32h
+//   + 32) of the unit, written by the K wave of half h (wave 1 + h; one 12-KB op).
+// dS ring: C_DSDEPTH stages of 2 slots; slot h = kv32 row 2u + h for ALL NB_G q pairs of the
+// workgroup (2 block rows x
+//   NB_G block images of 1280 B), written by the dS wave of half h (wave 3h; one 2-D op, <= 24 KB
+//   at the main tile).
+// Op order per wave: op(0) op(1) | P_0 | op(2) | P_1 | op(3) ...: op(v) = the wave's role op of
+// unit v. P_{u+1} sits in
+//   unit u after its last ring read; before it a wave needs op(u + 1) retired and only op(u + 2)
+//   may stay in flight: wait C_TW = 1; after it the wave issues op(u + 3) into unit u's (now free)
+//   stages. In flight: <= 2 per wave. Ops of units >= nu are 16-B dummies (count stays uniform, no
+//   duplicate reads).
+constexpr int C_KROW_B       = 480;
+constexpr int C_KHALF_B      = KV32 * C_KROW_B; // 15360 (one K wave's 32 rows)
+constexpr int C_KSTG_B       = 2 * C_KHALF_B;   // 30720 (64 rows)
+constexpr int C_KDEPTH       = 3;
+constexpr int C_DSDEPTH      = 3;
+constexpr int C_DS_OFF       = C_KDEPTH * C_KSTG_B; // 92160
+constexpr int C_TW           = 1;
+constexpr int C_AHEAD        = 2; // units between an op's issue barrier and its use barrier
+constexpr int C_MAX_INFLIGHT = 2;
+
+// ---- integer helpers
+// --------------------------------------------------------------------------------------------
+DQ_HD constexpr int imin(int a, int b) {
+    return a < b ? a : b;
+}
+DQ_HD constexpr int imax(int a, int b) {
+    return a > b ? a : b;
+}
+DQ_HD constexpr int floordiv(int a, int b) { // b > 0
+    int q = a / b;
+    return (a % b != 0 && a < 0) ? q - 1 : q;
+}
+
+// ---- per-tile geometry (nqw = 16-row query sub-tiles per wave)
+// ----------------------------------------------
+DQ_HD constexpr int bqw(int nqw) {
+    return 16 * nqw;
+} // queries per wave
+DQ_HD constexpr int bqwg(int nqw) {
+    return 16 * nqw * NWAVE;
+} // per workgroup
+DQ_HD constexpr int nbw(int nqw) {
+    return nqw / 2;
+} // dS q pairs (blocks) per wave
+DQ_HD constexpr int nbg(int nqw) {
+    return NWAVE * nqw / 2;
+} // per workgroup
+DQ_HD constexpr int c_slot_b(int nqw) {
+    return 2 * nbg(nqw) * DSI_BLK_B;
+} // one kv32 row x NB_G block images
+DQ_HD constexpr int c_dsstg_b(int nqw) {
+    return 2 * c_slot_b(nqw);
+} // 2 slots (kv32 rows 2u, 2u + 1)
+constexpr int LDS_C = C_DS_OFF + C_DSDEPTH * c_dsstg_b(MAIN_NQW); // 276480: the rings
+constexpr int EPI_IMG_B = 16 * DQ_IMG_ROW_B; // one wave's dQ epilogue image: 16 rows x 400 B, after the rings
+DQ_HD constexpr int lds_bytes() {
+    return LDS_C + NWAVE * EPI_IMG_B; // 302080: one workgroup per CU
+}
+
+// ---- roles (wave-uniform): waves 0 / 3 issue dS (kv32 row 2u + half), waves 1 / 2 issue K (rows
+// 32 half) ------------ half = w >> 1; dS iff (w & 1) == (w >> 1). Each CU TDM engine then carries
+// one dS op and one K op per unit under BOTH candidate engine maps: warp parity ({0, 2} / {1, 3},
+// HipKittens cdna5 global_to_shared.cuh -- a comment, unmeasured) and SIMD pairs ({0, 1} / {2, 3}).
+DQ_HD constexpr bool c_role_ds(int wv) {
+#if DQ_MUT == 17
+    return wv < 2; // MUTATION: both dS waves on one SIMD pair's engine
+#else
+    return (wv & 1) == (wv >> 1);
+#endif
+}
+DQ_HD constexpr int c_half(int wv) {
+#if DQ_MUT == 18
+    return 0; // MUTATION: every wave moves half 0
+#else
+    return wv >> 1;
+#endif
+}
+
+// ---- lane decomposition (bwd_hk_q1)
+// ---------------------------------------------------------------------------
+DQ_HD constexpr int lane_row(int lane) {
+    return lane % 16;
+}
+DQ_HD constexpr int lane_half(int lane) {
+    return lane / 16;
+}
+DQ_HD constexpr int lane_r(int lane) {
+    return (lane / 16) * 8 + lane % 8;
+} // tr16 row
+DQ_HD constexpr int lane_c(int lane) {
+    return ((lane / 8) % 2) * 8;
+} // tr16 column (elements)
+
+// ---- workgroup decode (bwd_hk_q2: head-group launch, XCD-major remap, longest-first, merged head)
+// ------------
+DQ_HD constexpr int xcd_remap(int gx, int ngrp) {
+    const unsigned x = (unsigned) gx, g = (unsigned) ngrp;
+#if DQ_MUT == 1
+    const unsigned r = (x % 8u) * (g / 8u); // MUTATION: drops + x/8
+#else
+    const unsigned r = (x % 8u) * (g / 8u) + x / 8u;
+#endif
+    return (g % 8u == 0u) ? (int) r : gx;
+}
+DQ_HD constexpr int head_hb(int gx, int gz, int HG) {
+    return gz * HG + xcd_remap(gx, HG);
+} // bh = bat*Hq + qh
+DQ_HD constexpr int head_bat(int hb, int Hq) {
+    return hb / Hq;
+}
+DQ_HD constexpr int head_qh(int hb, int bat, int Hq) {
+    return hb - bat * Hq;
+}
+DQ_HD constexpr int head_kv(int qh, int G) {
+    return qh / G;
+}
+// grid (HG, ntile + nhead, B*Hq/HG): y < ntile the 384-query tiles of [q_off, Sq), longest first; y
+// == ntile (only when q_off == 256) the head [0, 256) as one 4-wave x 64-query workgroup (bwd_hk_q2
+// (b))
+DQ_HD constexpr bool tile_is_head(int gy, int ntile) {
+#if DQ_MUT == 2
+    return gy >= ntile - 1; // MUTATION: the last main tile runs as a head
+#else
+    return gy >= ntile;
+#endif
+}
+DQ_HD constexpr int tile_q0g(int q_off, int ntile, int gy) {
+    return q_off + (ntile - 1 - gy) * bqwg(MAIN_NQW);
+}
+DQ_HD constexpr int head_q0g(int q_off) {
+    return q_off - bqwg(HEAD_NQW);
+}
+// q pair (0-based in the workgroup's nbg) of the k-th pair of wave wv: snake order over the waves (main tile
+// w, 7 - w, 8 + w; head tile w, 7 - w), so the diagonal units' fully masked pairs spread over all waves
+DQ_HD constexpr int wave_pair(int wv, int k, int nqw) {
+#if DQ_MUT == 3
+    return 4 * k + wv; // MUTATION: two waves share pairs
+#else
+    return 4 * k + ((k & 1) ? 3 - wv : wv);
+#endif
+}
+// first query of the wave's 16-query sub-tile h (q pair h / 2, half h % 2)
+DQ_HD constexpr int subtile_q0(int q0g, int wv, int h, int nqw) {
+    return q0g + 32 * wave_pair(wv, h / 2, nqw) + 16 * (h % 2);
+}
+DQ_HD constexpr int tile_qp0(int q0g) {
+    return q0g / 32;
+} // first q pair of the workgroup (q0g % 32 == 0)
+
+// ---- kv range (kv32 rows) of the WORKGROUP tile: bwd_hk_q1's kv_nkvt_eff with BQWG = 64 nqw
+// -------------------
+DQ_HD constexpr int kv_n32(int q0g, int nqw, int cshift, int nkvt, int causal) {
+    int lim = floordiv(q0g + bqwg(nqw) + cshift + (KV32 - 1), KV32);
+#if DQ_MUT == 4
+    lim = lim - 2; // MUTATION: drops the last unit
+#endif
+    lim = imax(lim, 1);
+    lim = imin(lim, nkvt);
+    return causal != 0 ? lim : nkvt;
+}
+DQ_HD constexpr int n_units(int n32) {
+    return (n32 + 1) / 2;
+} // 64-kv units (n32 is even on every plan shape)
+// units [0, n_full_units) have no fully masked block in the workgroup's span [qp0g, qp0g + nbg) in
+// either kv32 row (unit u full iff dsl_qp_first(2 (2u + 1)) <= qp0g, i.e. 2u + 1 - cshift/32 <=
+// qp0g); causal only
+DQ_HD constexpr int n_full_units(int qp0g, int cshift, int nu, int causal) {
+#if DQ_MUT == 5
+    const int t = floordiv(qp0g + cshift / 32 + 3, 2); // MUTATION: a masked unit runs unmasked
+#else
+    const int t = floordiv(qp0g + cshift / 32 + 1, 2);
+#endif
+    return causal != 0 ? imax(imin(t, nu), 0) : nu;
+}
+// units run by the steady-state body (no selects, no dummy op: every op it issues -- op(u + 3) --
+// must be real: u + 3 < nu); the rest run the generic masked body, the last unit its own tail
+DQ_HD constexpr int steady_units(int nfu, int nu) {
+#if DQ_MUT == 16
+    return imin(imin(nfu, nu - 1), imax(nu - 2, 0)); // MUTATION: issues a unit past nu
+#else
+    return imin(imin(nfu, nu - 1), imax(nu - 3, 0));
+#endif
+}
+
+// ---- dS zeroing predicate: the B operand of q pair qp at kv32 row r is selected to zero iff the
+// block holds no attended entry (both of its kv16 rows are unstored in dslayout, dsl_qp_first(2r)
+// == dsl_qp_first(2r + 1) because cshift % 32 == 0) or r is a padding row (r >= n32; never on a
+// plan shape, kept as a guard)
+DQ_HD constexpr bool ds_zero(int qp, int r, int n32, int cshift, int causal) {
+#if DQ_MUT == 6
+    return r >= n32 ||
+           qp <= dsl_qp_first(2 * r, cshift, causal); // MUTATION: zeroes the diagonal block
+#else
+    return r >= n32 || qp < dsl_qp_first(2 * r, cshift, causal);
+#endif
+}
+
+// ---- dS TDM op: kv32 row r (block rows 2r, 2r + 1) x stored q pairs [v0, blo + nbs) -> LDS slot
+// ----------------- 2-D: tile0 = nv * 512 elements (contiguous inside a block row), tile1 = 2 rows,
+// row stride = the block-row length of row 2r (dslayout reader hint: rows 2r and 2r + 1 share
+// qp_first), pad 8 elements every 32 (80-B LDS rows). The leading q pairs (< v0) are not stored and
+// are NOT read: the op starts at v0 and lands right-aligned, so row 2r's block lb sits at slot +
+// lb*1280 and row 2r+1's at slot + (nbs + lb - sh)*1280, sh = v0 - blo.
+DQ_HD constexpr int dsop_v0(int blo, int r, int cshift, int causal) {
+    return imax(blo, dsl_qp_first(2 * r, cshift, causal));
+}
+DQ_HD constexpr int dsop_nv(int blo, int nbs, int r, int cshift, int causal) {
+    return blo + nbs - dsop_v0(blo, r, cshift, causal);
+}
+DQ_HD constexpr long long dsop_src_el(long long bh, int r, int v0, int Sq, int Skv, int causal) {
+#if DQ_MUT == 7
+    return dsl_blk(bh, 2 * r, v0, Sq, Skv, causal) * DS_BLK_EL +
+           DS_BLK_EL; // MUTATION: one block late
+#else
+    return dsl_blk(bh, 2 * r, v0, Sq, Skv, causal) * DS_BLK_EL;
+#endif
+}
+DQ_HD constexpr long long dsop_stride_el(int r, int Sq, int cshift, int causal) {
+#if DQ_MUT == 8
+    return (long long) dsl_nqp(Sq) * DS_BLK_EL; // MUTATION: the dense row length
+#else
+    return (long long) dsl_row_len(2 * r, Sq, cshift, causal) * DS_BLK_EL;
+#endif
+}
+// The same source / stride in branch-free SALU form for the kernel's hot path (dsl_skip's branches
+// split the WMMA runs into blocks when the descriptor is prepared inside them), valid for cshift >=
+// 0 (the plan refuses cshift < 0): with m = cshift / 32, f(2r) = causal ? max(0, r - m) : 0 and the
+// packing removes sum_{k < 2r} f(k) = t (t + 1), t = causal ? max(r - m - 1, 0) : 0, blocks before
+// kv16 row 2r. bounds_proof.py D1 checks every op of every proof shape against dsl_blk (the
+// writer's formula) block by block.
+DQ_HD constexpr int f2r(int r, int m, int causal) {
+    return causal != 0 ? imax(r - m, 0) : 0;
+}
+DQ_HD constexpr long long row_off2(int r, int nqp, int m, int causal) {
+    const long long t = causal != 0 ? (long long) imax(r - m - 1, 0) : 0LL;
+    return 2LL * (long long) r * (long long) nqp - t * (t + 1);
+}
+DQ_HD constexpr long long dsop_src_el_hot(long long bh, long long nblk, int r, int blo, int nqp,
+                                          int m, int causal) {
+#if DQ_MUT == 15
+    return (bh * nblk + row_off2(r, nqp, m, causal) +
+            (long long) imax(blo - f2r(r, m, causal), 0)) *
+               DS_BLK_EL +
+           DS_BLK_EL; // MUTATION: one block late (hot path)
+#else
+    return (bh * nblk + row_off2(r, nqp, m, causal) +
+            (long long) imax(blo - f2r(r, m, causal), 0)) *
+           DS_BLK_EL;
+#endif
+}
+DQ_HD constexpr long long dsop_stride_el_hot(int r, int nqp, int m, int causal) {
+    return (long long) (nqp - f2r(r, m, causal)) * DS_BLK_EL;
+}
+DQ_HD constexpr int dsop_nv_hot(int blo, int nbs, int r, int m, int causal) {
+    return blo + nbs - imax(blo, f2r(r, m, causal));
+}
+DQ_HD constexpr int dsop_lds(int slot, int nbs, int nv) {
+    return slot + (nbs - nv) * DSI_BLK_B;
+}
+DQ_HD constexpr int dsop_sh(int nbs, int nv) {
+    return nbs - imax(nv, 0);
+} // <= nbs: reads stay in the slot
+// D# group-1 word 0 of a dS op: bf16, pad on, interval 16 dw (enc 3), amount 4 dw (enc 3)
+constexpr unsigned DS_W0 = (1u << 16) | (1u << 20) | (3u << 22) | (3u << 25);
+// LDS byte of element (block row rr in {0,1}, stored block j, kv k, q c) of an op landing at L
+// (stream pad model: destination byte b -> b + (b / 64) * 16)
+DQ_HD constexpr int dsop_elem_lds(int L, int nv, int rr, int j, int k, int c) {
+    return L + ((rr * nv + j) * DSL_BLK_B + dsl_chunk(k, c / 8) + 2 * (c % 8)) / 64 * 80 +
+           (dsl_chunk(k, c / 8) + 2 * (c % 8)) % 64;
+}
+
+// ---- K TDM ops
+// ------------------------------------------------------------------------------------------------
+// element offset of K[bat, kv, hkv, col]
+DQ_HD constexpr long long k_el(int bat, int Skv, int kv, int Hkv, int hkv, int col) {
+    return ((long long) (bat * Skv + kv) * (long long) Hkv + (long long) hkv) * (long long) D_QK +
+           (long long) col;
+}
+DQ_HD constexpr long long k_stride_el(int Hkv) {
+    return (long long) Hkv * (long long) D_QK;
+}
+// K wave of half h moves rows [64u + 32h, +32) of unit u, all 192 columns, pad 8 dw every 32 dw
+// (480-B rows)
+DQ_HD constexpr int c_kop_kv0(int u, int h) {
+#if DQ_MUT == 9
+    return 64 * u; // MUTATION: both K waves move rows 0..31
+#else
+    return 64 * u + 32 * h;
+#endif
+}
+DQ_HD constexpr int c_kstage(int u) {
+#if DQ_MUT == 10
+    return (u % (C_KDEPTH - 1)) * C_KSTG_B; // MUTATION: a 2-stage K ring
+#else
+    return (u % C_KDEPTH) * C_KSTG_B;
+#endif
+}
+DQ_HD constexpr int c_kop_lds(int u, int h) {
+    return c_kstage(u) + h * C_KHALF_B;
+}
+DQ_HD constexpr int c_kop_dim1(int Skv, int u, int h) {
+    return imax(Skv - c_kop_kv0(u, h), 0);
+}
+constexpr unsigned BK_W0 = (1u << 16) | (1u << 20) | (4u << 22) | (7u << 25);
+// LDS byte (from the op's start) of K element (row k, col c) of a K op: 480-B rows, 32 B after
+// every 128 B
+DQ_HD constexpr int c_k_elem_lds(int k, int c) {
+    return k * C_KROW_B + 2 * c + (2 * c / 128) * 32;
+}
+
+// ---- dS ring
+// ---------------------------------------------------------------------------------------------------
+DQ_HD constexpr int c_dsstage(int u, int nqw) {
+#if DQ_MUT == 11
+    return C_DS_OFF + (u % (C_DSDEPTH - 1)) * c_dsstg_b(nqw); // MUTATION: a 2-stage dS ring
+#else
+    return C_DS_OFF + (u % C_DSDEPTH) * c_dsstg_b(nqw);
+#endif
+}
+DQ_HD constexpr int c_dsslot(int u, int nqw, int h) {
+    return c_dsstage(u, nqw) + h * c_slot_b(nqw);
+}
+
+// ---- LDS read (burst) addresses: base VGPR = stage/slot offset + lane part; per-operand DS
+// immediates ---------
+DQ_HD constexpr int c_k_lane(int lane) {
+    return lane_r(lane) * C_KROW_B + lane_c(lane) * 2;
+}
+DQ_HD constexpr int c_k_imm(int dt, int h) {
+#if DQ_MUT == 12
+    return dt * 32 + h * 16 * C_KROW_B; // MUTATION: ignores the in-row pads
+#else
+    return dt * 32 + (dt / 4) * 32 + h * 16 * C_KROW_B;
+#endif
+}
+// dslayout v2: the tr16 lane reads chunk (kv row lane_r, query chunk 2 qhalf + lane_c / 8) of a block image,
+// at dsl_chunk = qhalf * 512 + g * 16 with g = (lane_c / 8) * 16 + lane_r, i.e. image byte qhalf * 640 + (g / 4) * 80 +
+// (g % 4) * 16 (the TDM pads 16 B after every 64 B): ds_lane(lane) + ds_half(qhalf)
+DQ_HD constexpr int ds_lane(int lane) {
+    const int g = (lane_c(lane) / 8) * 16 + lane_r(lane);
+    return (g / 4) * DSI_ROW_B + (g % 4) * 16;
+}
+// image offset of the 16-query half qhalf of a block (its second 512 data bytes = 8 padded 64-B groups)
+DQ_HD constexpr int ds_half(int qhalf) {
+    return qhalf * 8 * DSI_ROW_B;
+}
+// operand of query sub-tile qh (q pair lb = qh / 2 relative to the reader's first block, 16-query
+// half qh % 2)
+DQ_HD constexpr int ds_imm(int qh) {
+    return (qh / 2) * DSI_BLK_B + ds_half(qh % 2);
+}
+// row-1 image base of a slot whose op landed with shift sh (nbs blocks per row)
+DQ_HD constexpr int ds_row1(int slot, int nbs, int sh) {
+#if DQ_MUT == 13
+    return slot + nbs * DSI_BLK_B; // MUTATION: ignores the right-aligned shift
+#else
+    return slot + (nbs - sh) * DSI_BLK_B;
+#endif
+}
+// the workgroup's NB_G pairs land in q order in a slot; the wave's sub-tile h reads pair wave_pair(wv, h / 2)
+
+// ---- dQ epilogue (bwd_hk_q1's, one 16-row sub-tile at a time): per-wave row-major image [16][400 B] after the
+// rings, whole-line readback ----
+DQ_HD constexpr int epi_img(int wv) {
+    return LDS_C + wv * EPI_IMG_B;
+}
+DQ_HD constexpr int epi_w_lane(int lane) {
+    return lane_row(lane) * DQ_IMG_ROW_B + lane_half(lane) * 16;
+}
+DQ_HD constexpr int epi_w_imm(int dtile) {
+    return dtile * 32;
+}
+DQ_HD constexpr int epi_r_lane(int lane) {
+    return (lane / 8) * DQ_IMG_ROW_B + (lane % 8) * 16;
+}
+DQ_HD constexpr int epi_r_imm(int rb, int li) {
+#if DQ_MUT == 14
+    return rb * 4 * DQ_IMG_ROW_B + li * 64; // MUTATION: half lines
+#else
+    return rb * 4 * DQ_IMG_ROW_B + li * 128;
+#endif
+}
+// vec8 index of dq[bat, q0 + 4rb + l/8, qh, li*64 + (l%8)*8] (q0: the sub-tile's first query, rb < 4)
+DQ_HD constexpr int dq_vec8(int bat, int Sq, int Hq, int qh, int q0, int lane, int rb, int li) {
+    return ((bat * Sq + q0 + rb * 4 + lane / 8) * Hq + qh) * DV8_QK + lane % 8 +
+           li * (DQ_LINE_EL / 8);
+}
+
+// ---- constants for the host proof (bounds_proof.py reads them through ctypes)
+// -------------------------------
+DQ_HD constexpr long long kconst(int i) {
+    return i == 0    ? D_QK
+           : i == 1  ? NDT
+           : i == 2  ? MAIN_NQW
+           : i == 3  ? HEAD_NQW
+           : i == 4  ? DS_BLK_EL
+           : i == 5  ? DSI_ROW_B
+           : i == 6  ? DSI_BLK_B
+           : i == 7  ? NWAVE
+           : i == 8  ? BLOCK
+           : i == 9  ? MAIN_ROWS
+           : i == 10 ? HEAD_ROWS
+           : i == 11 ? C_KROW_B
+           : i == 12 ? C_KHALF_B
+           : i == 13 ? C_KSTG_B
+           : i == 14 ? C_KDEPTH
+           : i == 15 ? C_DSDEPTH
+           : i == 16 ? C_DS_OFF
+           : i == 17 ? C_TW
+           : i == 18 ? C_AHEAD
+           : i == 19 ? LDS_C
+           : i == 20 ? C_MAX_INFLIGHT
+           : i == 21 ? (long long) DS_W0
+           : i == 22 ? (long long) BK_W0
+           : i == 23 ? DQ_IMG_ROW_B
+           : i == 24 ? DQ_EXTENT_B
+           : i == 25 ? (long long) TDIM0
+           : i == 26 ? DSL_VERSION
+           : i == 27 ? DSL_SCALED
+                     : -1;
+}
+
+} // namespace dq
