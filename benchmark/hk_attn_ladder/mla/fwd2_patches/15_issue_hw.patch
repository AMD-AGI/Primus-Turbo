+def schedule_hw(nodes):
+    """schedule() on the --issue hw model: one issue per cycle; an LDS op holds other kinds HW_DS_BLOCK cycles; WMMAs
+    in WORDER, HW_WMMA apart at least; while the next WMMA can issue on cadence, a node issues only if it does not
+    push that WMMA later. Among the issuable nodes: the arrive, the earliest deadline, the longest critical path,
+    program order."""
+    n = len(nodes)
+    succ = [[] for _ in range(n)]
+    for i, nd in enumerate(nodes):
+        for p, lat in nd.preds:
+            succ[p].append((i, lat))
+    wmmas = [i for i in range(n) if nodes[i].kind == "WMMA"]
+    wseq = [i for tag in WORDER for i in wmmas if nodes[i].tag == tag]
+    if sorted(wseq) != wmmas:
+        raise ValueError("WORDER does not cover the WMMAs")
+    wpos = {i: k for k, i in enumerate(wseq)}
+    deadline = [10**6] * n
+    for i in range(n - 1, -1, -1):
+        for s, _ in succ[i]:
+            deadline[i] = min(deadline[i], wpos[s] if s in wpos else deadline[s])
+    cp = [0] * n
+    for i in range(n - 1, -1, -1):
+        cp[i] = (HW_WMMA if nodes[i].kind == "WMMA" else 1) + max((lat + cp[s] for s, lat in succ[i]), default=0)
+    npred = [len(nd.preds) for nd in nodes]
+    earliest = [0] * n
+    ready = {i for i in range(n) if npred[i] == 0}
+    ds_done = {}  # LDS load -> modelled completion cycle
+    issued_ds, retired_ds, last_done = [], 0, -(10**6)
+    out = []
+    t, last_w, wk, done = 0, -100, 0, 0
+    next_any, ds_block, salu_free = 0, 0, 0
+
+    def can(i):
+        k = nodes[i].kind
+        if earliest[i] > t or (k != "DS" and t < ds_block):
+            return False
+        if k == "DS":
+            if HW_DSLIM:
+                return sum(1 for p in issued_ds[retired_ds:] if ds_done[p] > t) < DS_MAX
+            return len(issued_ds) - retired_ds < DS_MAX
+        if k in ("SALU", "RESC", "RARE", "TDM", "BARW"):
+            return t >= salu_free
+        return True
+
+    while done < n:
+        pick = None
+        if t >= next_any:
+            nw = wseq[wk] if wk < len(wseq) else None
+            if nw is not None and nw in ready and t >= last_w + HW_WMMA and can(nw):
+                pick = nw
+            else:
+                cand = [i for i in ready if nodes[i].kind != "WMMA" and can(i)]
+                if nw is not None and nw in ready and earliest[nw] <= last_w + HW_WMMA:
+                    due = max(last_w + HW_WMMA, earliest[nw])
+                    cand = [i for i in cand if t + (HW_DS_BLOCK if nodes[i].kind == "DS" else 1) <= due]
+                if cand:
+                    pick = max(cand, key=lambda i: (nodes[i].kind == "BAR", -deadline[i], cp[i], -i))
+        if pick is None:
+            t += 1
+            if t > 10**6:
+                raise RuntimeError("scheduler deadlock")
+            continue
+        nd = nodes[pick]
+        ready.discard(pick)
+        k = nd.kind
+        next_any = t + 1
+        if k == "DS":
+            last_done = max(t + DS_LAT, last_done + HW_DS_GAP)
+            ds_done[pick] = last_done
+            issued_ds.append(pick)
+            ds_block = t + HW_DS_BLOCK
+        elif k == "BAR":
+            retired_ds = len(issued_ds)
+        elif k == "WMMA":
+            last_w = t
+            wk += 1
+        elif k in ("SALU", "TDM", "BARW"):
+            salu_free = t + 1
+        elif k == "RARE":
+            next_any = salu_free = t + RARE_COST
+        elif k == "RESC":
+            next_any = salu_free = t + HW_RESC
