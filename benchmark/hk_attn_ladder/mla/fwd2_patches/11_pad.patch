 RESC_LABELS = [0]  # unique labels of the RESC blocks across the regions
+PAD = None  # --pad (kind, n)
+
+
+def pad_lines(lines, L):
+    """--pad: the region with redundant instructions (semantics unchanged; waits / hazards unaffected: the added
+    VALU writes a scratch VGPR with its own value, in MSB mode 0 only)."""
+    kind, n = PAD
+    if kind == "msb":
+        out = []
+        for l in lines:
+            out.append(l)
+            x = l.strip()
+            if x.startswith("s_set_vgpr_msb"):
+                new = int(x.split()[1], 0) & 0xFF  # a repeat: the same mode, its previous-mode byte = that mode
+                out += [f"\ts_set_vgpr_msb 0x{(new << 8) | new:x}"] * n
+        return out
+    body = [k for k, l in enumerate(lines) if l.strip() and not l.strip().startswith((".", ";"))]
+    # VALU pads only where the MSB mode is 0 (after an s_set_vgpr_msb ... 0 or before any), SALU / nop anywhere
+    mode0, cur = [], 0
+    for k, l in enumerate(lines):
+        x = l.strip()
+        if x.startswith("s_set_vgpr_msb"):
+            cur = int(x.split()[1], 0) & 0xFF
+        if cur == 0:
+            mode0.append(k)
+    cand = mode0 if kind == "valu" else body
+    step = max(1, len(cand) // n)
+    at = set(cand[i] for i in range(0, len(cand), step)[:n])
+    ins = {"salu": "\ts_mov_b32 s101, s101", "nop": "\ts_nop 0", "valu": f"\tv_mov_b32_e32 v{L.sm[0][17]}, v{L.sm[0][17]}"}[kind]
+    out = []
+    for k, l in enumerate(lines):
+        out.append(l)
+        if k in at:
+            out.append(ins)
+    return out
 
 
