+def emit_loop(blocks, fmap, scalars, L):
+    """The LOOP region's lines: its blocks [(name, label, texts, successors)] in layout order, each emitted from the
+    join of its predecessors' exit flows (the region entry for the first block), iterated to a fixed point (the loop
+    body is its own predecessor). Returns (lines, open hazards / coverage errors, iterations)."""
+    names = [b[0] for b in blocks]
+    by = {b[0]: b for b in blocks}
+    preds = {n: [] for n in names}
+    for name, _, _, succ in blocks:
+        for s_ in succ:
+            preds[s_].append(name)
+    entry0 = M.Flow([E.State(unknown=True)], [xcnt_entry(scalars)], [[]])
+    items = {}
+    for name, _, texts, _ in blocks:
+        its = [M.make_item("\t" + x) for x in texts]
+        for k, it in enumerate(its):
+            it.pos = k
+        items[name] = its
+    exits, sig, lines, entry = {}, {}, {}, {}
+    for it in range(64):
+        changed = False
+        for n in names:
+            ins_fl = ([entry0] if n == names[0] else []) + [exits[p] for p in preds[n] if p in exits]
+            if not ins_fl:
+                continue
+            fl_in = M.Flow.join(ins_fl)
+            sg = fl_in.sig()
+            if sig.get(n) == sg:
+                continue
+            sig[n], entry[n] = sg, fl_in
+            lines[n], exits[n] = M.emit_block(items[n], fl_in, fmap, va_rule=VA_RULE)
+            changed = True
+        if not changed:
+            break
+    else:
+        raise RuntimeError("LOOP entry states did not converge")
+    out, found = [], []
+    for name, label, _, _ in blocks:
+        out.append(f"{label}:")
+        out += lines.get(name, [])
+        found += walk_block_check(lines.get(name, []), entry[name]) if name in entry else []
+    return out, found, it + 1
