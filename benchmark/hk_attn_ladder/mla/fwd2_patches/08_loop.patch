+def split_resc(blocks, L):
+    """Blocks with HKRESC pseudo-lines (--resc branch) split at them: the block before ends in s_cmp + s_cbranch over
+    the conditional O *= corr block, which falls through to the block after; that one takes the original
+    successors."""
+    out = []
+    for name, label, texts, succ in blocks:
+        parts, cur = [], []
+        for x in texts:
+            if x.startswith("HKRESC"):
+                parts.append((cur, x))
+                cur = []
+            else:
+                cur.append(x)
+        if not parts:
+            out.append((name, label, texts, succ))
+            continue
+        lab, nm = label, name
+        for k, (tx, rline) in enumerate(parts):
+            n = RESC_LABELS[0]
+            RESC_LABELS[0] += 1
+            head, body, after = G.resc_block(L, rline, f".LHKR{n}")
+            nb, nc = f"{name}.r{k}", f"{name}.c{k}"
+            out.append((nm, lab, tx + head, [nb, nc]))
+            out.append((nb, f".LHKRB{n}", body, [nc]))
+            lab, nm = after[:-1], nc
+        out.append((nm, lab, cur, succ))
+    return out
