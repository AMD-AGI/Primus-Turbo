+# ------------------------------------------------------------------------------------------------------------
+# LOOP (HKGEN2, build.py --loop): every tile of a block in generated code
+# ------------------------------------------------------------------------------------------------------------
+def tdm_op(ops, i):
+    """The i-th SGPR of the LOOP marker's tdm operand (k_mla_fwd.hip): 0, 1 K tile 0 bytes; 2, 3 V; 4, 5 bytes per K /
+    V tile; 6, 7 K / V row strides (elements); 8 Skv; 9 n; 10 ncc; 11 sb; 12 LDS of stage 0; 13 cnt0."""
+    base = int(re.match(r"s\[(\d+):", ops["tdm"]).group(1))
+    return f"s{base + i}"
+
+
+def loop_prologue(ops, L=None):
+    """S_SEL, (c, c), the per-block words of the 3 TDM descriptors, t = 0."""
+    out = [f"s_mov_b32 {S_SEL}, 0x{SEL_LO:x}"] + [f"s_mov_b32 {r}, {ops['c2']}" for r in S_C]
+    for o in range(3):
+        g0, g1 = S_G0[o], S_G1[o]
+        out += [
+            f"s_mov_b32 s{g0}, {tdm_op(ops, 13)}",
+            f"s_mov_b32 s{g1}, 0x{TDM_W0[o]:x}",
+            f"s_mov_b32 s{g1 + 1}, 0xffff0000",
+            f"s_mov_b32 s{g1 + 5}, {tdm_op(ops, 6 if o < 2 else 7)}",
+            f"s_mov_b32 s{g1 + 6}, 0",
+            f"s_mov_b32 s{g1 + 7}, 0",
+        ]
+    out += [f"s_mov_b32 {S_T}, 0", f"s_mov_b32 s{S_PAIR + 1}, 0"]
+    if PREFETCH:  # tile 0's fragment bases and its K / Q(0) reads (B_0 made its stage visible)
+        nodes, add = node_list()
+        stage_bases(L, ops, add, 0)
+        next_reads(L, add)
+        out += [nd.text for nd in nodes]
+    return out
+
+
+def slot_nodes(L, ops, add, diag=None):
+    """Tile t's scalars and ops: its fragment bases (stage (sb + t) & 3), [its dl], and ring slot j = t + 3 -- the
+    clamped tile jc = min(j, n - 1), 64 or 1 rows (j < n), tdim1 = Skv - 64 jc, the stage of j, the global bytes
+    tile 0 + jc * bytes per tile -- and its 3 TDM ops."""
+    T0, T1, T2 = S_TMP
+    n, skv, sb, lds0 = tdm_op(ops, 9), tdm_op(ops, 8), tdm_op(ops, 11), tdm_op(ops, 12)
+    pr = f"s[{S_PAIR}:{S_PAIR + 1}]"
+    if not PREFETCH:
+        add(f"s_add_co_i32 {T0}, {sb}, {S_T}", "SALU", "stg")
+        add(f"s_and_b32 {T0}, {T0}, 3", "SALU", "stg")
+        add(f"s_mul_i32 {T0}, {T0}, {STG_B}", "SALU", "stg")
+        add(f"v_add_nc_u32_e32 {vr(L.kb)}, {T0}, {vr(ops['kb'])}", "VALU", "stg")
+        add(f"v_add_nc_u32_e32 {vr(L.vb)}, {T0}, {vr(ops['vb'])}", "VALU", "stg")
+    if diag is not None:  # the mask bound of q tile k: dl0 - 64 t + 64 k (D0: into dl[1], its tile_nodes' dl)
+        add(f"s_lshl_b32 {T1}, {S_T}, 6", "SALU", "dl")
+        if diag:
+            add(f"s_sub_co_i32 {T1}, {T1}, {64 * diag}", "SALU", "dl")
+        add(f"v_subrev_nc_u32_e32 {vr(L.dl[max(diag, 1)])}, {T1}, {vr(ops['dl'])}", "VALU", "dl")
+    add(f"s_add_co_i32 {T0}, {S_T}, 3", "SALU", "slot")
+    add(f"s_add_co_i32 {T1}, {n}, -1", "SALU", "slot")
+    add(f"s_min_i32 {T1}, {T0}, {T1}", "SALU", "slot")
+    add(f"s_cmp_lt_i32 {T0}, {n}", "SALU", "slot")
+    add(f"s_cselect_b32 {T2}, {NB}, 1", "SALU", "slot")
+    for o in range(3):
+        add(f"s_mov_b32 s{S_G1[o] + 4}, {T2}", "SALU", "slot")
+    add(f"s_lshl_b32 {T2}, {T1}, 6", "SALU", "slot")
+    add(f"s_sub_co_i32 {T2}, {skv}, {T2}", "SALU", "slot")  # tdim1
+    for o in range(3):
+        add(f"s_lshr_b32 s{S_G1[o] + 3}, {T2}, 16", "SALU", "slot")
+        add(f"s_or_b32 s{S_G1[o] + 3}, s{S_G1[o] + 3}, 0x{TDM_TILE0[o] << 16:x}", "SALU", "slot")
+    add(f"s_lshl_b32 {T2}, {T2}, 16", "SALU", "slot")
+    add(f"s_or_b32 {T2}, {T2}, 0x7fff", "SALU", "slot")
+    for o in range(3):
+        add(f"s_mov_b32 s{S_G1[o] + 2}, {T2}", "SALU", "slot")
+    add(f"s_add_co_i32 {T0}, {sb}, {T0}", "SALU", "slot")
+    add(f"s_and_b32 {T0}, {T0}, 3", "SALU", "slot")
+    add(f"s_mul_i32 {T0}, {T0}, {STG_B}", "SALU", "slot")
+    add(f"s_add_co_i32 {T0}, {lds0}, {T0}", "SALU", "slot")
+    add(f"s_mov_b32 s{S_G0[0] + 1}, {T0}", "SALU", "slot")
+    add(f"s_add_co_i32 s{S_G0[1] + 1}, {T0}, 0x100", "SALU", "slot")
+    add(f"s_add_co_i32 s{S_G0[2] + 1}, {T0}, 0x{K_B_OFF:x}", "SALU", "slot")
+    add(f"s_mul_i32 s{S_PAIR}, {T1}, {tdm_op(ops, 4)}", "SALU", "slot")
+    gk = int(tdm_op(ops, 0)[1:])
+    gv = int(tdm_op(ops, 2)[1:])
+    add(f"s_add_nc_u64 s[{S_G0[0] + 2}:{S_G0[0] + 3}], s[{gk}:{gk + 1}], {pr}", "SALU", "slot")
+    add(f"s_bitset1_b32 s{S_G0[0] + 3}, 31", "SALU", "slot")
+    add(f"s_add_nc_u64 s[{S_G0[1] + 2}:{S_G0[1] + 3}], s[{S_G0[0] + 2}:{S_G0[0] + 3}], 0x100", "SALU", "slot")
+    add(f"s_mul_i32 s{S_PAIR}, {T1}, {tdm_op(ops, 5)}", "SALU", "slot")
+    add(f"s_add_nc_u64 s[{S_G0[2] + 2}:{S_G0[2] + 3}], s[{gv}:{gv + 1}], {pr}", "SALU", "slot")
+    add(f"s_bitset1_b32 s{S_G0[2] + 3}, 31", "SALU", "slot")
+    for o in range(3):
+        add(f"tensor_load_to_lds s[{S_G0[o]}:{S_G0[o] + 3}], s[{S_G1[o]}:{S_G1[o] + 7}]", "TDM", "tdm")
+
+
+def stage_bases(L, ops, add, nxt):
+    """kb / vb of tile t + nxt (stage (sb + t + nxt) & 3)."""
+    T0 = S_TMP[0]
+    add(f"s_add_co_i32 {T0}, {tdm_op(ops, 11)}, {S_T}", "SALU", "stg")
+    if nxt:
+        add(f"s_add_co_i32 {T0}, {T0}, {nxt}", "SALU", "stg")
+    add(f"s_and_b32 {T0}, {T0}, 3", "SALU", "stg")
+    add(f"s_mul_i32 {T0}, {T0}, {STG_B}", "SALU", "stg")
+    add(f"v_add_nc_u32_e32 {vr(L.kb)}, {T0}, {vr(ops['kb'])}", "VALU", "stg")
+    add(f"v_add_nc_u32_e32 {vr(L.vb)}, {T0}, {vr(ops['vb'])}", "VALU", "stg")
+
+
+def next_reads(L, add, q0=True):
+    """K of the tile at kb (k-step major) and Q(0) into qbuf[0]."""
+    for ks in range(NKS):
+        for j in range(NKV):
+            for h in range(2):
+                add(k_load(L, L.kb, j, ks, h), "DS", f"nK{j}.{ks}.{h}")
+    if q0:
+        for ks in range(NKS):
+            for h in range(2):
+                add(q_load(L, 0, ks, h), "DS", f"nQ0.{ks}.{h}")
+
+
+def loop_tail(L, ops, last):
+    """--kprefetch: a tile's tail after its arrive -- the barrier wait, then (unless it is the block's last tile)
+    the next tile's fragment bases and K / Q(0) reads."""
+    def post(add):
+        add("s_barrier_wait -1", "BARW", "wait")
+        if not last:
+            stage_bases(L, ops, add, 1)
+            next_reads(L, add)
+    return post
+
+
+def loop_body(L, ops, k=None):
+    """(texts, modelled cycles) of one tile of the LOOP: the scheduled tile (slot scalars, TDM, fragment bases, the
+    region's prefix + body, the arrive), then the barrier wait."""
+    L.qa, L.qb = ops["qa"], ops["qb"]
+    o = dict(ops, kb=L.kb, vb=L.vb, c2=S_C[0])
+    if k is not None:
+        o["dl"] = L.dl[1]
+    post = loop_tail(L, ops, k == 3) if PREFETCH else None
+    nodes = tile_nodes(L, o, k, pre=lambda add: slot_nodes(L, ops, add, k), post=post)
+    order, cycles = schedule(nodes)
+    out = []
+    for nd in order:
+        if nd.kind == "BAR":
+            out += ["s_wait_dscnt 0x0", "s_wait_tensorcnt 0x6"]
+        out.append(nd.text)
+    return out + ([] if PREFETCH else ["s_barrier_wait -1"]), cycles
+
+
+def region_loop(L, ops, lp):
+    """(blocks, modelled cycles): blocks = [(name, label, texts, successors)] in layout order: RB (prologue) -> H
+    (t < ncc ? U : D0h); U (a tile below the diagonal; t += 1, back to U while t < ncc); D<k>h (t < n ? D<k>b : X),
+    D<k>b (diagonal tile k; t += 1); X (the exit, an empty block)."""
+    ncc, n = tdm_op(ops, 10), tdm_op(ops, 9)
+    cyc = {}
+    tu, cyc["U"] = loop_body(L, ops)
+    blocks = [
+        ("RB", loop_prologue(ops, L), ["H"]),
+        ("H", [f"s_cmp_ge_i32 {S_T}, {ncc}", f"s_cbranch_scc1 {lp}_D0h"], ["U", "D0h"]),
+        ("U", tu + [f"s_add_co_i32 {S_T}, {S_T}, 1", f"s_cmp_lt_i32 {S_T}, {ncc}", f"s_cbranch_scc1 {lp}_U"],
+         ["U", "D0h"]),
+    ]
+    for kk in range(4):
+        td, cyc[f"D{kk}"] = loop_body(L, ops, kk)
+        nxt = f"D{kk + 1}h" if kk < 3 else "X"
+        blocks += [
+            (f"D{kk}h", [f"s_cmp_ge_i32 {S_T}, {n}", f"s_cbranch_scc1 {lp}_X"], [f"D{kk}b", "X"]),
+            (f"D{kk}b", td + [f"s_add_co_i32 {S_T}, {S_T}, 1"], [nxt]),
+        ]
+    blocks.append(("X", [], []))
+    return [(name, f"{lp}_{name}", texts, succ) for name, texts, succ in blocks], cyc
