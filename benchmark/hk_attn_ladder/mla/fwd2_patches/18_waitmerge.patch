+def merge_ds_waits(lines, window):
+    """Fewer s_wait_dscnt (each costs ~4 issue cycles even when it does not stall, ATT): a wait takes the strictest
+    count of the next window - 1 waits of its block (adjusted for the LDS ops issued in between) and they go. A wait
+    for 0 and the waits after a label, branch or barrier op stay. The re-walk (walk_block_check) checks the result."""
+    if window <= 1:
+        return lines
+    txt = [x.strip().split(";")[0].strip() for x in lines]
+    n = len(lines)
+    keep, newn = [True] * n, {}
+    k = 0
+    while k < n:
+        if not txt[k].startswith("s_wait_dscnt"):
+            k += 1
+            continue
+        best = int(txt[k].split()[1], 0)
+        if best == 0:
+            k += 1
+            continue
+        d, merged, j = 0, [], k + 1
+        while j < n and len(merged) < window - 1:
+            t = txt[j]
+            if not t or t.endswith(":") or t.startswith(("s_barrier", "s_cbranch", "s_branch")):
+                break
+            if t.startswith("ds_"):
+                d += 1
+            if t.startswith("s_wait_dscnt"):
+                nj = int(t.split()[1], 0)
+                if nj - d < 0:
+                    break
+                best = min(best, nj - d)
+                merged.append(j)
+            j += 1
+        if merged:
+            newn[k] = best
+            for x in merged:
+                keep[x] = False
+            k = merged[-1] + 1
+        else:
+            k += 1
+    out = []
+    for i, x in enumerate(lines):
+        if keep[i]:
+            out.append(x.replace(txt[i], f"s_wait_dscnt 0x{newn[i]:x}") if i in newn else x)
+    return out
+
+
